{
  "schemaVersion": 1,
  "id": "economy",
  "version": "1.0.0",
  "name": "Economy",
  "description": "Server-side and single-player economy mod with balances, shop, buying, selling, and a live auction management engine. No client-side mod required on dedicated servers, but fully functional in single-player worlds.",
