===== scripts/bore-tunnel.sh =====
#!/usr/bin/env bash
# Expose the local Minecraft TCP port through bore.pub.
#
# The script tries a short list of fixed remote ports first so that players
# can keep using the same address between runs. If every fixed port is already
# taken on the public bore server it falls back to a random port.
#
# It writes the resulting address to SERVER_ADDRESS.txt and leaves the tunnel
# running in the background. The PID is stored in:
#   ${TUNNEL_PID_FILE:-${RUNNER_TEMP:-<repo>/.agent-work/tmp}/ultron-tunnel.pid}
#
# Optional environment variables:
#   MINECRAFT_PORT         Local Minecraft port (default: 25565)
#   BORE_SERVER            bore server hostname (default: bore.pub)
#   BORE_VERSION           bore release to download (default: 0.5.3)
#   TUNNEL_PORT_CANDIDATES Space separated remote ports to try (default below)
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
TOOLS_DIR="$ROOT_DIR/.agent-work/tools"
LOGS_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${TUNNEL_PID_FILE:-$DEFAULT_PID_DIR/ultron-tunnel.pid}"
TUNNEL_LOG="$LOGS_DIR/tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
REMOTE_HOST="${BORE_SERVER:-bore.pub}"
BORE_VERSION="${BORE_VERSION:-0.5.3}"
PORT_CANDIDATES="${TUNNEL_PORT_CANDIDATES:-25565 25566 25567 25568 25569 25570}"

mkdir -p "$TOOLS_DIR" "$LOGS_DIR" "$(dirname -- "$PID_FILE")"

detect_arch() {
    case "$(uname -m)" in
        x86_64 | amd64) echo "x86_64" ;;
        aarch64 | arm64) echo "aarch64" ;;
        *)
            echo "ERROR: unsupported CPU architecture: $(uname -m)" >&2
            return 1
            ;;
    esac
}

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

ARCH="$(detect_arch)"
BORE_BIN="$TOOLS_DIR/bore-$BORE_VERSION-$ARCH"

if [ ! -x "$BORE_BIN" ]; then
    echo "Downloading bore ${BORE_VERSION} for ${ARCH}..." >&2
    DOWNLOAD_DIR="$TOOLS_DIR/.bore-download-$$"
    mkdir -p "$DOWNLOAD_DIR"
    trap 'rm -rf "$DOWNLOAD_DIR"' EXIT
    curl -fsSL --retry 3 --connect-timeout 15 \
        "https://github.com/ekzhang/bore/releases/download/v${BORE_VERSION}/bore-v${BORE_VERSION}-${ARCH}-unknown-linux-musl.tar.gz" \
        -o "$DOWNLOAD_DIR/bore.tar.gz"
    tar -xzf "$DOWNLOAD_DIR/bore.tar.gz" -C "$DOWNLOAD_DIR"
    install -m 0755 "$DOWNLOAD_DIR/bore" "$BORE_BIN"
    rm -rf "$DOWNLOAD_DIR"
    trap - EXIT
fi

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

write_address() {
    local port="$1"
    local address="${REMOTE_HOST}:${port}"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
        echo "#"
        echo "# Host: $REMOTE_HOST"
        echo "# Port: $port"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

start_bore() {
    local requested_port="$1"
    local -a args=(local "$LOCAL_PORT" --to "$REMOTE_HOST")

    if [ -n "$requested_port" ]; then
        args+=(--port "$requested_port")
    fi

    : >"$TUNNEL_LOG"
    nohup "$BORE_BIN" "${args[@]}" >"$TUNNEL_LOG" 2>&1 </dev/null &
    local tunnel_pid=$!

    local escaped_host="${REMOTE_HOST//./\\.}"
    local port=""
    for _ in $(seq 1 50); do
        if ! kill -0 "$tunnel_pid" 2>/dev/null; then
            break
        fi

        port="$(strip_ansi <"$TUNNEL_LOG" \
            | grep -oE "${escaped_host}:[0-9]+" \
            | head -n 1 | cut -d: -f2 || true)"
        if [ -n "$port" ]; then
            echo "$tunnel_pid" >"$PID_FILE"
            echo "Tunnel is live at $(write_address "$port")"
            strip_ansi <"$TUNNEL_LOG" | tail -n 5 >&2 || true
            return 0
        fi

        sleep 0.2
    done

    kill "$tunnel_pid" 2>/dev/null || true
    wait "$tunnel_pid" 2>/dev/null || true
    return 1
}

stop_existing_tunnel

for port in $PORT_CANDIDATES; do
    if start_bore "$port"; then
        exit 0
    fi
    echo "Remote port ${port} is unavailable; trying the next one..." >&2
done

if start_bore ""; then
    exit 0
fi

echo "ERROR: could not establish a bore.pub tunnel." >&2
strip_ansi <"$TUNNEL_LOG" | tail -n 20 >&2 || true
exit 1
===== scripts/low-latency-tunnel.sh =====
#!/usr/bin/env bash
# Expose the local Minecraft port through Pinggy's free TCP relay.
#
# Pinggy has relays in Asia-Pacific (Singapore), the US and Europe. By
# default the script measures the runner-side latency to each relay and adds
# an approximate South Asian player-side cost, then picks the lowest total.
# This avoids sending players in Bangladesh through the public bore.pub relay
# in New Jersey (US East) when a closer route is available.
#
# Free Pinggy tunnels expire after about 60 minutes, so this script runs a
# supervisor that reconnects before the expiry and rewrites
# SERVER_ADDRESS_LOW_LATENCY.txt with the new address. The stable bore.pub
# address in SERVER_ADDRESS.txt remains available as a fallback.
#
# Optional environment variables:
#   MINECRAFT_PORT            Local Minecraft port (default: 25565)
#   PINGGY_SERVER             Relay host, or "auto" to measure and pick the
#                             best relay for a South Asian player
#                             (default: auto)
#   PINGGY_PORT               Relay SSH port (default: 443)
#   PINGGY_USER               Relay user (default: tcp)
#   PINGGY_RECONNECT_SECONDS  Reconnect before Pinggy's 60 minute limit
#                             (default: 3300)
#   PINGGY_KNOWN_HOSTS        known_hosts file used for the relay
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS_LOW_LATENCY.txt"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${LOW_LATENCY_PID_FILE:-$DEFAULT_PID_DIR/ultron-low-latency-tunnel.pid}"
TUNNEL_LOG="$LOG_DIR/pinggy-tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
PINGGY_SERVER="${PINGGY_SERVER:-auto}"
RELAY_HOST=""
RELAY_SSH_PORT="${PINGGY_PORT:-443}"
RELAY_USER="${PINGGY_USER:-tcp}"
RECONNECT_SECONDS="${PINGGY_RECONNECT_SECONDS:-3300}"
KNOWN_HOSTS="${PINGGY_KNOWN_HOSTS:-$ROOT_DIR/.agent-work/tmp/pinggy_known_hosts}"

mkdir -p "$LOG_DIR" "$(dirname -- "$PID_FILE")" "$(dirname -- "$KNOWN_HOSTS")"

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

measure_relay_latency_ms() {
    local relay="$1"

    python3 - "$relay" "$RELAY_SSH_PORT" <<'PY' 2>/dev/null || echo 9999
import socket
import sys
import time

relay = sys.argv[1]
port = int(sys.argv[2])
best = None
for _ in range(2):
    started = time.perf_counter()
    try:
        with socket.create_connection((relay, port), timeout=4):
            pass
    except OSError:
        continue
    elapsed = (time.perf_counter() - started) * 1000
    if best is None or elapsed < best:
        best = elapsed
print(int(best) if best is not None else 9999)
PY
}

select_relay() {
    if [ "$PINGGY_SERVER" != "auto" ]; then
        RELAY_HOST="$PINGGY_SERVER"
        return 0
    fi

    # Approximate one-way network cost from Bangladesh/South Asia to each
    # relay. The runner-side latency is measured live, so the choice still
    # adapts when GitHub places the job in a different region.
    local best_relay=""
    local best_score=99999
    local relay player_leg runner_leg score

    for relay in ap.free.pinggy.io us.free.pinggy.io eu.free.pinggy.io; do
        runner_leg="$(measure_relay_latency_ms "$relay")"
        case "$relay" in
            ap.*) player_leg=55 ;;
            us.*) player_leg=200 ;;
            eu.*) player_leg=150 ;;
            *) player_leg=150 ;;
        esac
        score=$((runner_leg + player_leg))
        echo "Relay candidate ${relay}: runner ${runner_leg}ms + player ~${player_leg}ms = ${score}ms" >&2
        if [ "$score" -lt "$best_score" ]; then
            best_score="$score"
            best_relay="$relay"
        fi
    done

    if [ -z "$best_relay" ] || [ "$best_score" -ge 99999 ]; then
        best_relay="us.free.pinggy.io"
    fi

    RELAY_HOST="$best_relay"
    echo "Selected low-latency relay: ${RELAY_HOST} (estimated ${best_score}ms)" >&2
}

write_address() {
    local address="$1"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP low-latency public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Relay: Pinggy ${RELAY_HOST} (free relay, reconnects about once an hour)"
        echo "# Stable fallback: see SERVER_ADDRESS.txt"
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

run_tunnel_once() {
    local attempt_log="$LOG_DIR/pinggy-attempt.log"
    local ssh_pid=""

    {
        echo "=== $(date -u '+%Y-%m-%d %H:%M:%S UTC') connecting to ${RELAY_HOST} ==="
    } >>"$TUNNEL_LOG"

    # Pinggy's free relay uses password authentication with an empty
    # password. BatchMode would refuse that, so keep it disabled and feed
    # /dev/null to avoid waiting for terminal input.
    timeout --signal=TERM "$RECONNECT_SECONDS" \
        ssh -T \
            -o BatchMode=no \
            -o ConnectTimeout=20 \
            -o ExitOnForwardFailure=yes \
            -o NumberOfPasswordPrompts=1 \
            -o PasswordAuthentication=yes \
            -o PreferredAuthentications=password \
            -o PubkeyAuthentication=no \
            -o KbdInteractiveAuthentication=no \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=3 \
            -o StrictHostKeyChecking=accept-new \
            -o UserKnownHostsFile="$KNOWN_HOSTS" \
            -p "$RELAY_SSH_PORT" \
            -R "0:localhost:${LOCAL_PORT}" \
            "${RELAY_USER}@${RELAY_HOST}" \
            >"$attempt_log" 2>&1 </dev/null &
    ssh_pid=$!
    ACTIVE_SSH_PID="$ssh_pid"

    local address=""
    for _ in $(seq 1 60); do
        if ! kill -0 "$ssh_pid" 2>/dev/null; then
            break
        fi

        address="$(strip_ansi <"$attempt_log" \
            | grep -oE 'tcp://[^[:space:]]+' \
            | head -n 1 \
            | sed 's#^tcp://##' || true)"
        if [ -n "$address" ]; then
            echo "Low-latency tunnel is live at $(write_address "$address")"
            strip_ansi <"$attempt_log" | tail -n 5 >>"$TUNNEL_LOG" || true
            break
        fi

        sleep 0.5
    done

    if [ -z "$address" ]; then
        strip_ansi <"$attempt_log" | tail -n 20 >>"$TUNNEL_LOG" || true
        echo "WARNING: could not establish a Pinggy tunnel on this attempt." >&2
    fi

    wait "$ssh_pid" 2>/dev/null || true
    ACTIVE_SSH_PID=""
    sleep 5
}

supervise() {
    ACTIVE_SSH_PID=""

    # Make sure the relay SSH process is gone when the supervisor is stopped.
    # shellcheck disable=SC2329
    cleanup() {
        if [ -n "$ACTIVE_SSH_PID" ]; then
            kill "$ACTIVE_SSH_PID" 2>/dev/null || true
            wait "$ACTIVE_SSH_PID" 2>/dev/null || true
        fi
    }
    trap 'cleanup; exit 0' TERM INT
    trap cleanup EXIT

    while true; do
        run_tunnel_once
    done
}

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

if [ "${1:-}" = "--supervise" ]; then
    select_relay
    supervise
    exit 0
fi

select_relay
export PINGGY_SERVER="$RELAY_HOST"

if ! command -v ssh >/dev/null 2>&1; then
    echo "ERROR: ssh is required for the low-latency tunnel." >&2
    exit 1
fi

stop_existing_tunnel
rm -f "$ADDRESS_FILE"

: >"$TUNNEL_LOG"
nohup "$0" --supervise >/dev/null 2>&1 </dev/null &
supervisor_pid=$!
echo "$supervisor_pid" >"$PID_FILE"

# Wait for the supervisor to publish the first address.
for _ in $(seq 1 90); do
    if ! kill -0 "$supervisor_pid" 2>/dev/null; then
        break
    fi

    if [ -s "$ADDRESS_FILE" ] \
        && grep -qE ':[0-9]+$' "$ADDRESS_FILE" 2>/dev/null; then
        address="$(grep -v '^#' "$ADDRESS_FILE" | grep -E ':[0-9]+$' | tail -n 1)"
        if [ -n "$address" ]; then
            echo "Low-latency tunnel is live at ${address} (pid ${supervisor_pid})"
            exit 0
        fi
    fi

    sleep 1
done

kill "$supervisor_pid" 2>/dev/null || true
wait "$supervisor_pid" 2>/dev/null || true
rm -f "$PID_FILE"
echo "ERROR: could not establish a Pinggy low-latency tunnel." >&2
strip_ansi <"$TUNNEL_LOG" | tail -n 30 >&2 || true
exit 1
===== scripts/network-tune.sh =====
#!/usr/bin/env bash
# Best-effort TCP tuning for high-latency / lossy long-distance links.
#
# Minecraft (Java) uses TCP. Players in South Asia connecting to a GitHub
# Actions runner in the US cross a long, sometimes lossy path, so BBR plus
# larger socket buffers can reduce stalls compared with the default CUBIC
# congestion control. This does not remove physical latency, but it makes
# the connection less likely to collapse under packet loss.
#
# The script is intentionally best-effort: if the runner does not expose a
# setting, it logs a warning and continues.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: network-tune.sh must run as root (use sudo)." >&2
    exit 1
fi

set_sysctl() {
    local key="$1"
    local value="$2"

    if sysctl -w "${key}=${value}" >/dev/null 2>&1; then
        echo "  ${key}=${value}"
    else
        echo "  SKIP ${key} (not available)"
    fi
}

echo "Applying low-latency TCP tuning..."

modprobe tcp_bbr 2>/dev/null || true

set_sysctl net.core.default_qdisc fq
set_sysctl net.ipv4.tcp_congestion_control bbr
set_sysctl net.ipv4.tcp_slow_start_after_idle 0
set_sysctl net.ipv4.tcp_mtu_probing 1
set_sysctl net.ipv4.tcp_fastopen 3
set_sysctl net.ipv4.tcp_keepalive_time 60
set_sysctl net.ipv4.tcp_keepalive_intvl 15
set_sysctl net.ipv4.tcp_keepalive_probes 4
set_sysctl net.ipv4.tcp_no_metrics_save 1
set_sysctl net.core.rmem_max 16777216
set_sysctl net.core.wmem_max 16777216
set_sysctl net.ipv4.tcp_rmem "4096 87380 16777216"
set_sysctl net.ipv4.tcp_wmem "4096 65536 16777216"

cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)"
qdisc="$(sysctl -n net.core.default_qdisc 2>/dev/null || echo unknown)"
echo "TCP tuning active: congestion_control=${cc} default_qdisc=${qdisc}"
===== scripts/serveo-tunnel.sh =====
#!/usr/bin/env bash
# Expose the local Minecraft TCP port through a Serveo SSH tunnel.
#
# Serveo is a free SSH-based relay. Unlike bore.pub it does not need a
# downloaded binary, but its public TCP ports are random and the SSH session
# can drop, so a small supervisor reconnects automatically and rewrites
# SERVER_ADDRESS.txt with the new address.
#
# It writes the resulting address to SERVER_ADDRESS.txt and leaves the
# supervisor running in the background. The PID is stored in:
#   ${TUNNEL_PID_FILE:-${RUNNER_TEMP:-<repo>/.agent-work/tmp}/ultron-tunnel.pid}
#
# Optional environment variables:
#   MINECRAFT_PORT            Local Minecraft port (default: 25565)
#   SERVEO_SERVER             Serveo relay host (default: serveo.net)
#   SERVEO_PORT               Relay SSH port (default: 22)
#   SERVEO_USER               Optional SSH user (default: none/anonymous)
#   SERVEO_RECONNECT_SECONDS  Reconnect after this many seconds; 0 disables
#                             the periodic reconnect (default: 0)
#   SERVEO_KNOWN_HOSTS        known_hosts file used for the relay
#   SERVEO_SSH_BIN            SSH executable (default: ssh; used by tests)
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${TUNNEL_PID_FILE:-$DEFAULT_PID_DIR/ultron-tunnel.pid}"
TUNNEL_LOG="$LOG_DIR/serveo-tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
REMOTE_HOST="${SERVEO_SERVER:-serveo.net}"
SSH_PORT="${SERVEO_PORT:-22}"
SSH_USER="${SERVEO_USER:-}"
RECONNECT_SECONDS="${SERVEO_RECONNECT_SECONDS:-0}"
KNOWN_HOSTS="${SERVEO_KNOWN_HOSTS:-$ROOT_DIR/.agent-work/tmp/serveo_known_hosts}"
SSH_BIN="${SERVEO_SSH_BIN:-ssh}"

mkdir -p "$LOG_DIR" "$(dirname -- "$PID_FILE")" "$(dirname -- "$KNOWN_HOSTS")"

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

write_address() {
    local address="$1"
    local host="${address%:*}"
    local port="${address##*:}"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Provider: Serveo SSH tunnel (${REMOTE_HOST})"
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
        echo "#"
        echo "# Host: $host"
        echo "# Port: $port"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

extract_address() {
    local log_file="$1"
    local escaped_host="${REMOTE_HOST//./\\.}"

    # Serveo prints e.g. "Forwarding TCP connections from serveo.net:39419".
    strip_ansi <"$log_file" \
        | grep -oE "${escaped_host}:[0-9]{1,5}" \
        | head -n 1 || true
}

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

run_tunnel_once() {
    local attempt_log="$LOG_DIR/serveo-attempt.log"
    local ssh_pid=""
    local target="$REMOTE_HOST"
    local -a ssh_args=(
        -T
        -o BatchMode=yes
        -o ConnectTimeout=20
        -o ExitOnForwardFailure=yes
        -o ServerAliveInterval=15
        -o ServerAliveCountMax=3
        -o StrictHostKeyChecking=accept-new
        -o UserKnownHostsFile="$KNOWN_HOSTS"
        -p "$SSH_PORT"
        -R "0:localhost:${LOCAL_PORT}"
    )

    if [ -n "$SSH_USER" ]; then
        target="${SSH_USER}@${REMOTE_HOST}"
    fi

    {
        echo "=== $(date -u '+%Y-%m-%d %H:%M:%S UTC') connecting to ${target} ==="
    } >>"$TUNNEL_LOG"

    : >"$attempt_log"
    if [ "$RECONNECT_SECONDS" -gt 0 ] 2>/dev/null; then
        timeout --signal=TERM "$RECONNECT_SECONDS" \
            "$SSH_BIN" "${ssh_args[@]}" "$target" \
            >"$attempt_log" 2>&1 </dev/null &
    else
        "$SSH_BIN" "${ssh_args[@]}" "$target" \
            >"$attempt_log" 2>&1 </dev/null &
    fi
    ssh_pid=$!
    ACTIVE_SSH_PID="$ssh_pid"

    local address=""
    for _ in $(seq 1 120); do
        if ! kill -0 "$ssh_pid" 2>/dev/null; then
            break
        fi

        address="$(extract_address "$attempt_log")"
        if [ -n "$address" ]; then
            echo "Serveo tunnel is live at $(write_address "$address")"
            strip_ansi <"$attempt_log" | tail -n 5 >>"$TUNNEL_LOG" || true
            break
        fi

        sleep 0.5
    done

    if [ -z "$address" ]; then
        strip_ansi <"$attempt_log" | tail -n 20 >>"$TUNNEL_LOG" || true
        echo "WARNING: could not establish a Serveo tunnel on this attempt." >&2
    fi

    wait "$ssh_pid" 2>/dev/null || true
    ACTIVE_SSH_PID=""
    sleep 5
}

supervise() {
    ACTIVE_SSH_PID=""

    # Make sure the relay SSH process is gone when the supervisor is stopped.
    # shellcheck disable=SC2329
    cleanup() {
        if [ -n "$ACTIVE_SSH_PID" ]; then
            kill "$ACTIVE_SSH_PID" 2>/dev/null || true
            wait "$ACTIVE_SSH_PID" 2>/dev/null || true
        fi
    }
    trap 'cleanup; exit 0' TERM INT
    trap cleanup EXIT

    while true; do
        run_tunnel_once
    done
}

if [ "${1:-}" = "--supervise" ]; then
    supervise
    exit 0
fi

if ! command -v "$SSH_BIN" >/dev/null 2>&1; then
    echo "ERROR: '$SSH_BIN' is required for the Serveo tunnel." >&2
    exit 1
fi

stop_existing_tunnel
rm -f "$ADDRESS_FILE"

: >"$TUNNEL_LOG"
nohup "$0" --supervise >>"$TUNNEL_LOG" 2>&1 </dev/null &
supervisor_pid=$!
echo "$supervisor_pid" >"$PID_FILE"

# Wait for the supervisor to publish the first address.
for _ in $(seq 1 90); do
    if ! kill -0 "$supervisor_pid" 2>/dev/null; then
        break
    fi

    if [ -s "$ADDRESS_FILE" ] \
        && grep -qE ':[0-9]+$' "$ADDRESS_FILE" 2>/dev/null; then
        address="$(grep -v '^#' "$ADDRESS_FILE" | grep -E ':[0-9]+$' | tail -n 1)"
        if [ -n "$address" ]; then
            echo "Serveo tunnel is live at ${address} (pid ${supervisor_pid})"
            exit 0
        fi
    fi

    sleep 1
done

kill "$supervisor_pid" 2>/dev/null || true
wait "$supervisor_pid" 2>/dev/null || true
rm -f "$PID_FILE"
echo "ERROR: could not establish a Serveo tunnel." >&2
strip_ansi <"$TUNNEL_LOG" | tail -n 30 >&2 || true
exit 1
