cp "$ADDRESS_FILE" "$BACKUP_FILE"

http_pid=""
tunnel_pid=""

cleanup() {
    if [ -n "$tunnel_pid" ]; then
        kill "$tunnel_pid" 2>/dev/null || true
    fi
    if [ -n "$http_pid" ]; then
        kill "$http_pid" 2>/dev/null || true
    fi
    cp "$BACKUP_FILE" "$ADDRESS_FILE" 2>/dev/null || true
}
trap cleanup EXIT

python3 -m http.server "$LOCAL_PORT" --bind 127.0.0.1 \
