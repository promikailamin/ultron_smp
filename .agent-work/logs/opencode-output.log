set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="${LOW_LATENCY_ADDRESS_FILE:-$ROOT_DIR/SERVER_ADDRESS_LOW_LATENCY.txt}"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${LOW_LATENCY_PID_FILE:-$DEFAULT_PID_DIR/ultron-low-latency-tunnel.pid}"
TUNNEL_LOG="$LOG_DIR/pinggy-tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
PINGGY_SERVER="${PINGGY_SERVER:-auto}"
RELAY_HOST=""
RELAY_SSH_PORT="${PINGGY_PORT:-443}"
RELAY_USER="${PINGGY_USER:-tcp}"
RECONNECT_SECONDS="${PINGGY_RECONNECT_SECONDS:-3300}"
KNOWN_HOSTS="${PINGGY_KNOWN_HOSTS:-$ROOT_DIR/.agent-work/tmp/pinggy_known_hosts}"
SSH_BIN="${PINGGY_SSH_BIN:-ssh}"
PLAYER_REGION="${PLAYER_REGION:-auto}"
BANGLADESH_RELAY_MARGIN_MS="${BANGLADESH_RELAY_MARGIN_MS:-75}"

mkdir -p "$LOG_DIR" "$(dirname -- "$PID_FILE")" "$(dirname -- "$KNOWN_HOSTS")"

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

measure_relay_latency_ms() {
    local relay="$1"

    python3 - "$relay" "$RELAY_SSH_PORT" <<'PY' 2>/dev/null || echo 9999
import socket
import sys
import time

relay = sys.argv[1]
port = int(sys.argv[2])
best = None
for _ in range(2):
    started = time.perf_counter()
    try:
        with socket.create_connection((relay, port), timeout=4):
            pass
    except OSError:
        continue
    elapsed = (time.perf_counter() - started) * 1000
    if best is None or elapsed < best:
        best = elapsed
print(int(best) if best is not None else 9999)
PY
}

select_relay() {
    if [ "$PINGGY_SERVER" != "auto" ]; then
        RELAY_HOST="$PINGGY_SERVER"
        return 0
    fi

    # Approximate one-way network cost from Bangladesh/South Asia to each
    # relay. The runner-side latency is measured live, so the choice still
    # adapts when GitHub places the job in a different region.
    local best_relay=""
    local best_score=99999
    local ap_relay=""
    local ap_score=99999
    local relay player_leg runner_leg score

    for relay in ap.free.pinggy.io us.free.pinggy.io eu.free.pinggy.io; do
        runner_leg="$(measure_relay_latency_ms "$relay")"
        case "$relay" in
            ap.*) player_leg=55 ;;
            us.*) player_leg=200 ;;
            eu.*) player_leg=150 ;;
            *) player_leg=150 ;;
        esac
        score=$((runner_leg + player_leg))
        echo "Relay candidate ${relay}: runner ${runner_leg}ms + player ~${player_leg}ms = ${score}ms" >&2
        if [ "$score" -lt "$best_score" ]; then
            best_score="$score"
            best_relay="$relay"
        fi
        if [ "$relay" = "ap.free.pinggy.io" ]; then
            ap_relay="$relay"
            ap_score="$score"
        fi
    done

    if [ -z "$best_relay" ] || [ "$best_score" -ge 99999 ]; then
        best_relay="us.free.pinggy.io"
    fi

    # Bangladesh/South Asia players get the Singapore relay unless another
    # route is clearly faster. This avoids switching them to a distant relay
    # for a small runner-side measurement difference.
    case "$(printf '%s' "$PLAYER_REGION" | tr '[:upper:]' '[:lower:]')" in
        bangladesh | bd | south-asia | southasia)
            if [ -n "$ap_relay" ] && [ "$ap_score" -lt 99999 ] \
                && [ "$ap_score" -le $((best_score + BANGLADESH_RELAY_MARGIN_MS)) ]; then
                best_relay="$ap_relay"
                best_score="$ap_score"
                echo "Prioritising the Asia-Pacific relay for Bangladesh/South Asia players." >&2
            fi
            ;;
    esac

    RELAY_HOST="$best_relay"
    echo "Selected low-latency relay: ${RELAY_HOST} (estimated ${best_score}ms)" >&2
}

write_address() {
    local address="$1"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP low-latency public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Relay: Pinggy ${RELAY_HOST} (free relay, reconnects about once an hour)"
        if [ "$ADDRESS_FILE" != "$ROOT_DIR/SERVER_ADDRESS.txt" ]; then
            echo "# Stable fallback: see SERVER_ADDRESS.txt"
        fi
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

run_tunnel_once() {
    local attempt_log="$LOG_DIR/pinggy-attempt.log"
    local ssh_pid=""

    {
        echo "=== $(date -u '+%Y-%m-%d %H:%M:%S UTC') connecting to ${RELAY_HOST} ==="
    } >>"$TUNNEL_LOG"

    # Pinggy's free relay uses password authentication with an empty
    # password. BatchMode would refuse that, so keep it disabled and feed
    # /dev/null to avoid waiting for terminal input.
    local -a ssh_args=(
        -T
        -o BatchMode=no
        -o ConnectTimeout=20
        -o ExitOnForwardFailure=yes
        -o NumberOfPasswordPrompts=1
        -o PasswordAuthentication=yes
        -o PreferredAuthentications=password
        -o PubkeyAuthentication=no
        -o KbdInteractiveAuthentication=no
        -o ServerAliveInterval=15
        -o ServerAliveCountMax=3
        -o StrictHostKeyChecking=accept-new
        -o UserKnownHostsFile="$KNOWN_HOSTS"
        -p "$RELAY_SSH_PORT"
        -R "0:localhost:${LOCAL_PORT}"
    )

    if [ "$RECONNECT_SECONDS" -gt 0 ] 2>/dev/null; then
        timeout --signal=TERM "$RECONNECT_SECONDS" \
            "$SSH_BIN" "${ssh_args[@]}" "${RELAY_USER}@${RELAY_HOST}" \
            >"$attempt_log" 2>&1 </dev/null &
    else
        "$SSH_BIN" "${ssh_args[@]}" "${RELAY_USER}@${RELAY_HOST}" \
            >"$attempt_log" 2>&1 </dev/null &
    fi
    ssh_pid=$!
    ACTIVE_SSH_PID="$ssh_pid"

    local address=""
    for _ in $(seq 1 60); do
        if ! kill -0 "$ssh_pid" 2>/dev/null; then
            break
        fi

        address="$(strip_ansi <"$attempt_log" \
            | grep -oE 'tcp://[^[:space:]]+' \
            | head -n 1 \
            | sed 's#^tcp://##' || true)"
        if [ -n "$address" ]; then
            echo "Low-latency tunnel is live at $(write_address "$address")"
            strip_ansi <"$attempt_log" | tail -n 5 >>"$TUNNEL_LOG" || true
            break
        fi

        sleep 0.5
    done

    if [ -z "$address" ]; then
        strip_ansi <"$attempt_log" | tail -n 20 >>"$TUNNEL_LOG" || true
        echo "WARNING: could not establish a Pinggy tunnel on this attempt." >&2
    fi

    wait "$ssh_pid" 2>/dev/null || true
    ACTIVE_SSH_PID=""
    sleep 5
}

supervise() {
    ACTIVE_SSH_PID=""

    # Make sure the relay SSH process is gone when the supervisor is stopped.
    # shellcheck disable=SC2329
    cleanup() {
        if [ -n "$ACTIVE_SSH_PID" ]; then
            kill "$ACTIVE_SSH_PID" 2>/dev/null || true
            wait "$ACTIVE_SSH_PID" 2>/dev/null || true
        fi
    }
    trap 'cleanup; exit 0' TERM INT
===== scripts/minekube-tunnel.sh =====
#!/usr/bin/env bash
# Expose the local Minecraft server through Minekube Connect.
#
# Minekube's fast-start Connect plugin is a Paper/Spigot/Velocity/BungeeCord
# plugin and cannot be loaded by a Fabric server. Gate is Minekube's own
# Minecraft proxy and the supported platform-independent Connect connector,
# so it provides the same public <endpoint>.play.minekube.net address for this
# Fabric server without any Paper plugin.
#
# Gate runs next to the Fabric server, accepts players from the Connect edge
# network over an outbound tunnel and forwards them to 127.0.0.1:25565. No
# router port forwarding or public IP address is required.
#
# The Gate binary is downloaded into .agent-work/tools and is never committed.
# The script writes the public address to SERVER_ADDRESS.txt and leaves Gate
# running in the background. The PID is stored in:
#   ${TUNNEL_PID_FILE:-${RUNNER_TEMP:-<repo>/.agent-work/tmp}/ultron-tunnel.pid}
#
# Optional environment variables:
#   MINECRAFT_PORT                Local Fabric server port (default: 25565)
#   MINEKUBE_ENDPOINT             Stable endpoint name (1-16 lowercase
#                                 letters, digits or hyphens)
#   MINEKUBE_CONNECT_TOKEN        Connector token for a stable endpoint.
#                                 Never commit or log this value.
#   MINEKUBE_GATE_VERSION         Gate release to download (default: 0.81.1)
#   MINEKUBE_GATE_DOWNLOAD_URL    Override the Gate download URL
#   GATE_BIN                      Use an existing Gate binary (used by tests)
#   MINEKUBE_BIND_ADDR            Local Gate listener address (default:
#                                 127.0.0.1)
#   MINEKUBE_BIND_PORT            Local Gate listener port (default: 25566)
#   MINEKUBE_DOMAIN               Connect endpoint domain (default:
#                                 play.minekube.net)
#   MINEKUBE_ALLOW_OFFLINE_PLAYERS
#                                 Allow offline/cracked players through
#                                 Connect (default: true)
#   MINEKUBE_READY_TIMEOUT        Seconds to wait for registration
#                                 (default: 90)
#   MINEKUBE_ENDPOINT_FALLBACK    Fall back to a temporary endpoint when an
#                                 explicitly configured name cannot be used
#                                 without a token (default: true)
#   MINEKUBE_DATA_DIR             State/config directory
#                                 (default: .agent-work/tmp/minekube)
#   MINEKUBE_CONFIG_FILE          Generated Gate config file
#   MINEKUBE_TOKEN_FILE           Gate connect.json token file
#   MINEKUBE_STATE_FILE           File remembering the temporary endpoint
#                                 name across tunnel restarts
#   MINEKUBE_WATCH_SERVICE_ADDR   Connect watch service address
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
TOOLS_DIR="$ROOT_DIR/.agent-work/tools"
LOGS_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${TUNNEL_PID_FILE:-$DEFAULT_PID_DIR/ultron-tunnel.pid}"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
GATE_VERSION="${MINEKUBE_GATE_VERSION:-0.81.1}"
BIND_ADDR="${MINEKUBE_BIND_ADDR:-127.0.0.1}"
BIND_PORT="${MINEKUBE_BIND_PORT:-25566}"
DOMAIN="${MINEKUBE_DOMAIN:-play.minekube.net}"
READY_TIMEOUT="${MINEKUBE_READY_TIMEOUT:-90}"
ALLOW_OFFLINE="${MINEKUBE_ALLOW_OFFLINE_PLAYERS:-true}"
WATCH_ADDR="${MINEKUBE_WATCH_SERVICE_ADDR:-wss://watch-connect.minekube.net}"
ENDPOINT_FALLBACK="${MINEKUBE_ENDPOINT_FALLBACK:-true}"

DATA_DIR="${MINEKUBE_DATA_DIR:-$ROOT_DIR/.agent-work/tmp/minekube}"
CONFIG_FILE="${MINEKUBE_CONFIG_FILE:-$DATA_DIR/config.yml}"
TOKEN_FILE="${MINEKUBE_TOKEN_FILE:-$DATA_DIR/connect.json}"
STATE_FILE="${MINEKUBE_STATE_FILE:-$DATA_DIR/endpoint}"
TUNNEL_LOG="$LOGS_DIR/minekube-tunnel.log"

REQUESTED_ENDPOINT="$(printf '%s' "${MINEKUBE_ENDPOINT:-}" | tr '[:upper:]' '[:lower:]')"
CONNECT_TOKEN="${MINEKUBE_CONNECT_TOKEN:-}"
GATE_BIN="${GATE_BIN:-}"
GATE_STARTED=0

mkdir -p "$TOOLS_DIR" "$LOGS_DIR" "$DATA_DIR" "$(dirname -- "$PID_FILE")"

detect_os() {
    case "$(uname -s)" in
        Linux) echo "linux" ;;
        Darwin) echo "darwin" ;;
        *)
            echo "ERROR: unsupported operating system: $(uname -s)" >&2
            return 1
            ;;
    esac
}

detect_arch() {
    case "$(uname -m)" in
        x86_64 | amd64) echo "amd64" ;;
        aarch64 | arm64) echo "arm64" ;;
        *)
            echo "ERROR: unsupported CPU architecture: $(uname -m)" >&2
            return 1
            ;;
    esac
}

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

valid_endpoint() {
    local name="$1"

    # Minekube currently accepts 1-16 lowercase alphanumeric/hyphen
    # characters and rejects longer random names generated by some Gate
    # versions, so validate the name ourselves before starting Gate.
    [ "${#name}" -ge 1 ] && [ "${#name}" -le 16 ] \
        && printf '%s' "$name" | grep -qE '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'
}

generate_endpoint() {
    local suffix

    suffix="$(od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || true)"
    if [ -z "$suffix" ]; then
        suffix="$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
    fi
    printf 'ultron-%s' "$suffix"
}

ensure_gate() {
    if [ -n "$GATE_BIN" ]; then
        if [ ! -x "$GATE_BIN" ]; then
            echo "ERROR: GATE_BIN is not executable: $GATE_BIN" >&2
            return 1
        fi
        return 0
    fi

    local os arch asset download_url download_dir
    os="$(detect_os)"
    arch="$(detect_arch)"
    GATE_BIN="$TOOLS_DIR/gate-${GATE_VERSION}-${os}-${arch}"

    if [ -x "$GATE_BIN" ]; then
        return 0
    fi

    asset="gate_${GATE_VERSION}_${os}_${arch}"
    download_url="${MINEKUBE_GATE_DOWNLOAD_URL:-https://github.com/minekube/gate/releases/download/v${GATE_VERSION}/${asset}}"
    download_dir="$TOOLS_DIR/.gate-download-$$"
    mkdir -p "$download_dir"
    trap 'rm -rf "$download_dir"' EXIT

    echo "Downloading Minekube Gate ${GATE_VERSION} for ${os}/${arch}..." >&2
    curl -fsSL --retry 3 --connect-timeout 15 "$download_url" \
        -o "$download_dir/gate"
    install -m 0755 "$download_dir/gate" "$GATE_BIN"
    rm -rf "$download_dir"
    trap - EXIT

    return 0
}

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 20); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

write_token_file() {
    if [ -z "$CONNECT_TOKEN" ]; then
        return 0
    fi

    python3 - "$CONNECT_TOKEN" "$TOKEN_FILE" <<'PY'
import json
import os
import sys
import tempfile

token, path = sys.argv[1], sys.argv[2]
directory = os.path.dirname(path) or "."
os.makedirs(directory, exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=directory, prefix=".connect-", suffix=".json")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump({"token": token}, stream)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY
}

write_config() {
    local endpoint="$1"
    local offline="false"

    if [ "$ALLOW_OFFLINE" = "true" ]; then
        offline="true"
    fi

    {
        echo "# Generated by scripts/minekube-tunnel.sh - do not commit."
        echo "config:"
        echo "  bind: \"${BIND_ADDR}:${BIND_PORT}\""
        echo "  onlineMode: false"
        echo "  forceKeyAuthentication: false"
        echo "  forwarding:"
        echo "    mode: none"
        echo "  connectionTimeout: 10s"
        echo "  readTimeout: 60s"
        echo "  compression:"
        echo "    threshold: 128"
        echo "  servers:"
        echo "    ultron: \"127.0.0.1:${LOCAL_PORT}\""
        echo "  try:"
        echo "    - ultron"
        echo "  status:"
        echo "    motd: |"
        echo "      §bUltron SMP"
        echo "      §7via Minekube Connect"
        echo "    showMaxPlayers: 100"
        echo "connect:"
        echo "  enabled: true"
        echo "  name: \"${endpoint}\""
        echo "  allowOfflineModePlayers: ${offline}"
        echo "  tokenFilePath: \"${TOKEN_FILE}\""
        echo "  watchServiceAddr: \"${WATCH_ADDR}\""
    } >"$CONFIG_FILE"
}
===== scripts/network-tune.sh =====
#!/usr/bin/env bash
# Best-effort TCP tuning for high-latency / lossy long-distance links.
#
# Minecraft (Java) uses TCP. Players in South Asia connecting to a GitHub
# Actions runner in the US cross a long, sometimes lossy path, so BBR plus
# larger socket buffers can reduce stalls compared with the default CUBIC
# congestion control. This does not remove physical latency, but it makes
# the connection less likely to collapse under packet loss.
#
# The script is intentionally best-effort: if the runner does not expose a
# setting, it logs a warning and continues.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: network-tune.sh must run as root (use sudo)." >&2
    exit 1
fi

set_sysctl() {
    local key="$1"
    local value="$2"

    if sysctl -w "${key}=${value}" >/dev/null 2>&1; then
        echo "  ${key}=${value}"
    else
        echo "  SKIP ${key} (not available)"
    fi
}

echo "Applying low-latency TCP tuning..."

modprobe tcp_bbr 2>/dev/null || true

set_sysctl net.core.default_qdisc fq
set_sysctl net.ipv4.tcp_congestion_control bbr
set_sysctl net.ipv4.tcp_slow_start_after_idle 0
set_sysctl net.ipv4.tcp_mtu_probing 1
set_sysctl net.ipv4.tcp_fastopen 3
set_sysctl net.ipv4.tcp_keepalive_time 60
set_sysctl net.ipv4.tcp_keepalive_intvl 15
set_sysctl net.ipv4.tcp_keepalive_probes 4
set_sysctl net.ipv4.tcp_no_metrics_save 1
set_sysctl net.ipv4.tcp_notsent_lowat 16384
set_sysctl net.core.netdev_max_backlog 16384
set_sysctl net.core.rmem_max 16777216
set_sysctl net.core.wmem_max 16777216
set_sysctl net.ipv4.tcp_rmem "4096 87380 16777216"
set_sysctl net.ipv4.tcp_wmem "4096 65536 16777216"

cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)"
qdisc="$(sysctl -n net.core.default_qdisc 2>/dev/null || echo unknown)"
echo "TCP tuning active: congestion_control=${cc} default_qdisc=${qdisc}"
===== scripts/serveo-tunnel.sh =====
#!/usr/bin/env bash
# Expose the local Minecraft TCP port through a Serveo SSH tunnel.
#
# Serveo is a free SSH-based relay. Unlike bore.pub it does not need a
# downloaded binary, but its public TCP ports are random and the SSH session
# can drop, so a small supervisor reconnects automatically and rewrites
# SERVER_ADDRESS.txt with the new address.
#
# It writes the resulting address to SERVER_ADDRESS.txt and leaves the
# supervisor running in the background. The PID is stored in:
#   ${TUNNEL_PID_FILE:-${RUNNER_TEMP:-<repo>/.agent-work/tmp}/ultron-tunnel.pid}
#
# Optional environment variables:
#   MINECRAFT_PORT            Local Minecraft port (default: 25565)
#   SERVEO_SERVER             Serveo relay host (default: serveo.net)
#   SERVEO_PORT               Relay SSH port (default: 22)
#   SERVEO_USER               Optional SSH user (default: none/anonymous)
#   SERVEO_RECONNECT_SECONDS  Reconnect after this many seconds; 0 disables
#                             the periodic reconnect (default: 0)
#   SERVEO_KNOWN_HOSTS        known_hosts file used for the relay
#   SERVEO_SSH_BIN            SSH executable (default: ssh; used by tests)
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${TUNNEL_PID_FILE:-$DEFAULT_PID_DIR/ultron-tunnel.pid}"
TUNNEL_LOG="$LOG_DIR/serveo-tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
REMOTE_HOST="${SERVEO_SERVER:-serveo.net}"
SSH_PORT="${SERVEO_PORT:-22}"
SSH_USER="${SERVEO_USER:-}"
RECONNECT_SECONDS="${SERVEO_RECONNECT_SECONDS:-0}"
KNOWN_HOSTS="${SERVEO_KNOWN_HOSTS:-$ROOT_DIR/.agent-work/tmp/serveo_known_hosts}"
SSH_BIN="${SERVEO_SSH_BIN:-ssh}"

mkdir -p "$LOG_DIR" "$(dirname -- "$PID_FILE")" "$(dirname -- "$KNOWN_HOSTS")"

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

write_address() {
    local address="$1"
    local host="${address%:*}"
    local port="${address##*:}"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Provider: Serveo SSH tunnel (${REMOTE_HOST})"
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
        echo "#"
        echo "# Host: $host"
        echo "# Port: $port"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

extract_address() {
    local log_file="$1"
    local escaped_host="${REMOTE_HOST//./\\.}"

    # Serveo prints e.g. "Forwarding TCP connections from serveo.net:39419".
    strip_ansi <"$log_file" \
        | grep -oE "${escaped_host}:[0-9]{1,5}" \
        | head -n 1 || true
}

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

run_tunnel_once() {
    local attempt_log="$LOG_DIR/serveo-attempt.log"
    local ssh_pid=""
    local target="$REMOTE_HOST"
    local -a ssh_args=(
        -T
        -o BatchMode=yes
        -o ConnectTimeout=20
        -o ExitOnForwardFailure=yes
        -o ServerAliveInterval=15
        -o ServerAliveCountMax=3
        -o StrictHostKeyChecking=accept-new
        -o UserKnownHostsFile="$KNOWN_HOSTS"
        -p "$SSH_PORT"
        -R "0:localhost:${LOCAL_PORT}"
    )

    if [ -n "$SSH_USER" ]; then
        target="${SSH_USER}@${REMOTE_HOST}"
    fi

    {
        echo "=== $(date -u '+%Y-%m-%d %H:%M:%S UTC') connecting to ${target} ==="
    } >>"$TUNNEL_LOG"

    : >"$attempt_log"
    if [ "$RECONNECT_SECONDS" -gt 0 ] 2>/dev/null; then
        timeout --signal=TERM "$RECONNECT_SECONDS" \
            "$SSH_BIN" "${ssh_args[@]}" "$target" \
            >"$attempt_log" 2>&1 </dev/null &
    else
        "$SSH_BIN" "${ssh_args[@]}" "$target" \
            >"$attempt_log" 2>&1 </dev/null &
    fi
    ssh_pid=$!
    ACTIVE_SSH_PID="$ssh_pid"

    local address=""
    for _ in $(seq 1 120); do
        if ! kill -0 "$ssh_pid" 2>/dev/null; then
            break
        fi

        address="$(extract_address "$attempt_log")"
        if [ -n "$address" ]; then
            echo "Serveo tunnel is live at $(write_address "$address")"
            strip_ansi <"$attempt_log" | tail -n 5 >>"$TUNNEL_LOG" || true
            break
        fi

        sleep 0.5
    done

    if [ -z "$address" ]; then
        strip_ansi <"$attempt_log" | tail -n 20 >>"$TUNNEL_LOG" || true
        echo "WARNING: could not establish a Serveo tunnel on this attempt." >&2
    fi

    wait "$ssh_pid" 2>/dev/null || true
    ACTIVE_SSH_PID=""
    sleep 5
}

supervise() {
    ACTIVE_SSH_PID=""

    # Make sure the relay SSH process is gone when the supervisor is stopped.
    # shellcheck disable=SC2329
    cleanup() {
        if [ -n "$ACTIVE_SSH_PID" ]; then
            kill "$ACTIVE_SSH_PID" 2>/dev/null || true
            wait "$ACTIVE_SSH_PID" 2>/dev/null || true
        fi
    }
    trap 'cleanup; exit 0' TERM INT
    trap cleanup EXIT

    while true; do
        run_tunnel_once
    done
}

if [ "${1:-}" = "--supervise" ]; then
    supervise
    exit 0
fi

if ! command -v "$SSH_BIN" >/dev/null 2>&1; then
    echo "ERROR: '$SSH_BIN' is required for the Serveo tunnel." >&2
    exit 1
fi

stop_existing_tunnel
rm -f "$ADDRESS_FILE"

: >"$TUNNEL_LOG"
nohup "$0" --supervise >>"$TUNNEL_LOG" 2>&1 </dev/null &
supervisor_pid=$!
echo "$supervisor_pid" >"$PID_FILE"

# Wait for the supervisor to publish the first address.
for _ in $(seq 1 90); do
    if ! kill -0 "$supervisor_pid" 2>/dev/null; then
        break
    fi

    if [ -s "$ADDRESS_FILE" ] \
        && grep -qE ':[0-9]+$' "$ADDRESS_FILE" 2>/dev/null; then
        address="$(grep -v '^#' "$ADDRESS_FILE" | grep -E ':[0-9]+$' | tail -n 1)"
        if [ -n "$address" ]; then
            echo "Serveo tunnel is live at ${address} (pid ${supervisor_pid})"
            exit 0
        fi
    fi

    sleep 1
done

kill "$supervisor_pid" 2>/dev/null || true
wait "$supervisor_pid" 2>/dev/null || true
rm -f "$PID_FILE"
echo "ERROR: could not establish a Serveo tunnel." >&2
strip_ansi <"$TUNNEL_LOG" | tail -n 30 >&2 || true
exit 1
===== scripts/server-control.sh =====
#!/usr/bin/env bash
# Start and stop the Minecraft server through a controllable console pipe.
#
# A normal `nohup bash ./run.sh &` cannot receive console commands, so the
# previous workflow could only copy world files that the server still had in
# memory. That is why changes made during a run disappeared when the run was
# cancelled. This script gives the server a named-pipe (FIFO) stdin so the
# workflow can send `save-all flush` and `stop` before backing the world up.
#
# Commands:
#   server-control.sh start            Start the server (idempotent)
#   server-control.sh command "text"   Send one console command
#   server-control.sh save             Flush all chunks to disk
#   server-control.sh stop [seconds]   Graceful stop, then terminate if needed
#   server-control.sh status           Exit 0 when the server process is alive
#
# Optional environment variables:
#   MC_STATE_DIR     Directory for PID/FIFO files (default: RUNNER_TEMP)
#   MC_CONSOLE_FIFO  Console pipe path
#   MC_PID_FILE      Server PID file
#   MC_LOG_FILE      Server console log (default: <repo>/server.log)
#   MC_RUN_SCRIPT    Server launch script (default: <repo>/run.sh)
#   JAVA_BIN         Forwarded to run.sh
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${MC_STATE_DIR:-${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}}"
CONSOLE_FIFO="${MC_CONSOLE_FIFO:-$STATE_DIR/ultron-console.fifo}"
PID_FILE="${MC_PID_FILE:-$STATE_DIR/minecraft-server.pid}"
HOLDER_PID_FILE="${MC_HOLDER_PID_FILE:-$STATE_DIR/ultron-console-holder.pid}"
LOG_FILE="${MC_LOG_FILE:-$ROOT_DIR/server.log}"
RUN_SCRIPT="${MC_RUN_SCRIPT:-$ROOT_DIR/run.sh}"

mkdir -p "$STATE_DIR" "$(dirname -- "$CONSOLE_FIFO")" "$(dirname -- "$LOG_FILE")"

server_pid() {
    cat "$PID_FILE" 2>/dev/null || true
}

is_running() {
    local pid
    pid="$(server_pid)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

write_console() {
    local line="$1"
    # A FIFO opened for writing blocks when nobody is reading. The timeout
    # keeps a dead server from hanging the workflow backup step forever.
    # shellcheck disable=SC2016
    timeout 5 bash -c 'printf "%s\n" "$1" > "$2"' _ "$line" "$CONSOLE_FIFO"
}

start_server() {
    if is_running; then
        echo "Minecraft server is already running (pid $(server_pid))."
        return 0
    fi

    rm -f "$CONSOLE_FIFO" "$PID_FILE" "$HOLDER_PID_FILE"
    mkfifo "$CONSOLE_FIFO"

    # Hold the write end open so the server's stdin never sees EOF and exits.
    # shellcheck disable=SC2016
    nohup bash -c 'exec 3>"$1"; while :; do sleep 3600; done' \
        _ "$CONSOLE_FIFO" >/dev/null 2>&1 </dev/null &
    echo $! >"$HOLDER_PID_FILE"

    nohup bash "$RUN_SCRIPT" >"$LOG_FILE" 2>&1 <"$CONSOLE_FIFO" &
    echo $! >"$PID_FILE"

    echo "Started Minecraft server (pid $(server_pid)); console pipe ${CONSOLE_FIFO}."
}

stop_server() {
    local wait_seconds="${1:-120}"

    if ! is_running; then
        echo "Minecraft server is not running."
    else
        local pid
        pid="$(server_pid)"

        # Flush first so a failed/blocked stop still leaves fresh data on disk.
        write_console "save-all flush" 2>/dev/null \
            || echo "WARNING: could not send save-all flush." >&2
        sleep 2
        write_console "stop" 2>/dev/null \
            || echo "WARNING: could not send stop; terminating the process." >&2

        local waited=0
        while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt "$wait_seconds" ]; do
            sleep 1
            waited=$((waited + 1))
        done

        if kill -0 "$pid" 2>/dev/null; then
            echo "Server did not stop within ${wait_seconds}s; sending SIGTERM." >&2
            kill "$pid" 2>/dev/null || true
            sleep 5
        fi

        if kill -0 "$pid" 2>/dev/null; then
            echo "Server is still running; sending SIGKILL." >&2
            kill -9 "$pid" 2>/dev/null || true
        fi

        echo "Minecraft server stopped."
    fi

    local holder_pid
    holder_pid="$(cat "$HOLDER_PID_FILE" 2>/dev/null || true)"
    if [ -n "$holder_pid" ] && kill -0 "$holder_pid" 2>/dev/null; then
        kill "$holder_pid" 2>/dev/null || true
    fi

    rm -f "$PID_FILE" "$HOLDER_PID_FILE" "$CONSOLE_FIFO"
}

case "${1:-}" in
    start)
        start_server
        ;;
    command)
        if [ -z "${2:-}" ]; then
            echo "ERROR: command requires console text." >&2
            exit 2
        fi
        if ! is_running; then
            echo "ERROR: Minecraft server is not running." >&2
            exit 1
        fi
        write_console "$2"
        ;;
    save)
        if ! is_running; then
            echo "ERROR: Minecraft server is not running." >&2
            exit 1
        fi
        write_console "save-all flush"
        ;;
    stop)
        stop_server "${2:-120}"
        ;;
    status)
        if is_running; then
            echo "Minecraft server is running (pid $(server_pid))."
        else
            echo "Minecraft server is not running."
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|command <text>|save|stop [seconds]|status}" >&2
        exit 2
        ;;
esac
===== scripts/tunnel.sh =====
#!/usr/bin/env bash
# Expose the local Minecraft TCP port through LocalXpose.
#
# LocalXpose is the primary tunnel provider. It is authenticated with an
# access token supplied through the LOCALXPOSE_ACCESS_TOKEN (or ACCESS_TOKEN)
# environment variable; the token is never written into this repository.
#
# LocalXpose TCP tunnels require a PRO account. If the token belongs to a
# FREE account (HTTP/HTTPS only), or the tunnel cannot be established for any
# other reason, this script falls back to the stable bore.pub tunnel unless
# LOCALXPOSE_BORE_FALLBACK=false is set.
#
# It writes the resulting address to SERVER_ADDRESS.txt and leaves the tunnel
# running in the background. The PID is stored in:
#   ${TUNNEL_PID_FILE:-${RUNNER_TEMP:-<repo>/.agent-work/tmp}/ultron-tunnel.pid}
#
# TUNNEL_PROVIDER selects the provider used by the workflow:
#   auto        Try Minekube Connect, then LocalXpose, then bore.pub (default)
#   localxpose  Force the LocalXpose tunnel
#   bore        Force the bore.pub tunnel
#   serveo      Force the Serveo SSH tunnel
#   pinggy      Force the Bangladesh-prioritised Pinggy TCP relay
#   tunnl       Use a low-latency TCP relay for Minecraft and add a
#               tunnl.gg HTTP status page (tunnl.gg cannot carry raw TCP)
#   minekube    Use the Minekube Connect network through the Gate connector
#
# Optional environment variables:
#   TUNNEL_PROVIDER             Tunnel provider (default: auto)
#   MINEKUBE_AUTO               Set to false to skip Minekube for auto
#   MINEKUBE_ENDPOINT           Stable Minekube endpoint name
#   MINEKUBE_CONNECT_TOKEN      Minekube connector token (repository secret)
#   PLAYER_REGION               bangladesh/bd prioritises the Asia-Pacific
#                               Pinggy relay (default: bangladesh for
#                               pinggy/tunnl, auto for the standalone script)
#   LOCALXPOSE_ACCESS_TOKEN     LocalXpose access token (required)
#   ACCESS_TOKEN                Alternative token variable name
#   MINECRAFT_PORT              Local Minecraft port (default: 25565)
#   LOCALXPOSE_REGION           Relay region: us, ap, eu, or auto
#                               (default: ap)
#   LOCALXPOSE_PORT_CANDIDATES  Space separated remote ports to try before
#                               asking LocalXpose for a random port
#   LOCALXPOSE_DOWNLOAD_URL     Override the loclx download URL
#   LOCALXPOSE_BORE_FALLBACK    Fall back to bore.pub on failure
#                               (default: true)
#   LOCALXPOSE_ALLOW_LOCAL_ADDRESS
#                               Accept a 127.0.0.1/localhost endpoint from
#                               loclx output (used by tests; default: false)
#   LOCLX_BIN                   Use an existing loclx binary (used by tests)
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

PROVIDER="$(printf '%s' "${TUNNEL_PROVIDER:-auto}" | tr '[:upper:]' '[:lower:]')"
case "$PROVIDER" in
    "" | auto)
        if [ "${MINEKUBE_AUTO:-true}" = "true" ]; then
            default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
            if TUNNEL_PID_FILE="${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}" \
                bash "$ROOT_DIR/scripts/minekube-tunnel.sh"; then
                exit 0
            fi
            echo "WARNING: Minekube Connect could not be started; trying LocalXpose..." >&2
        fi
        ;;
    minekube | minekube-connect | connect)
        exec bash "$ROOT_DIR/scripts/minekube-tunnel.sh"
        ;;
    localxpose | loclx)
        # An explicit provider choice should not silently switch to bore.pub.
        # Set LOCALXPOSE_BORE_FALLBACK=true to opt back into the fallback.
        if [ -z "${LOCALXPOSE_BORE_FALLBACK:-}" ]; then
            export LOCALXPOSE_BORE_FALLBACK=false
        fi
        ;;
    bore | bore.pub)
        exec bash "$ROOT_DIR/scripts/bore-tunnel.sh"
        ;;
    serveo)
        exec bash "$ROOT_DIR/scripts/serveo-tunnel.sh"
        ;;
    pinggy | low-latency)
        default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
        export PLAYER_REGION="${PLAYER_REGION:-bangladesh}"
        export LOW_LATENCY_ADDRESS_FILE="${LOW_LATENCY_ADDRESS_FILE:-$ROOT_DIR/SERVER_ADDRESS.txt}"
        export LOW_LATENCY_PID_FILE="${LOW_LATENCY_PID_FILE:-${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}}"
        exec bash "$ROOT_DIR/scripts/low-latency-tunnel.sh"
        ;;
    tunnl | tunnl.gg)
        # tunnl.gg only carries HTTP/WebSocket, so it cannot be the Minecraft
        # TCP endpoint. Prioritise the Asia-Pacific TCP relay for Bangladeshi
        # players, then publish a tunnl.gg status page alongside it.
        default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
        export PLAYER_REGION="${PLAYER_REGION:-bangladesh}"
        export LOW_LATENCY_ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
        export LOW_LATENCY_PID_FILE="${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}"
        if bash "$ROOT_DIR/scripts/low-latency-tunnel.sh"; then
            bash "$ROOT_DIR/scripts/tunnl-tunnel.sh" \
                || echo "WARNING: the tunnl.gg status page could not be started; the Minecraft tunnel is still online." >&2
            exit 0
        fi
        echo "WARNING: the low-latency TCP relay failed; falling back to bore.pub for Minecraft." >&2
        exec bash "$ROOT_DIR/scripts/bore-tunnel.sh"
        ;;
    *)
        echo "ERROR: unsupported TUNNEL_PROVIDER '${PROVIDER}' (use auto, localxpose, bore, serveo, pinggy, tunnl or minekube)." >&2
        exit 2
        ;;
esac

TOOLS_DIR="$ROOT_DIR/.agent-work/tools"
LOGS_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${TUNNEL_PID_FILE:-$DEFAULT_PID_DIR/ultron-tunnel.pid}"
TUNNEL_LOG="$LOGS_DIR/localxpose-tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
REGION="${LOCALXPOSE_REGION:-ap}"
PORT_CANDIDATES="${LOCALXPOSE_PORT_CANDIDATES:-25565 25566 25567 25568 25569 25570}"
ACCESS_TOKEN="${LOCALXPOSE_ACCESS_TOKEN:-${ACCESS_TOKEN:-${LX_ACCESS_TOKEN:-}}}"
BORE_FALLBACK="${LOCALXPOSE_BORE_FALLBACK:-true}"

mkdir -p "$TOOLS_DIR" "$LOGS_DIR" "$(dirname -- "$PID_FILE")"

detect_arch() {
    case "$(uname -m)" in
        x86_64 | amd64) echo "amd64" ;;
        aarch64 | arm64) echo "arm64" ;;
        *)
            echo "ERROR: unsupported CPU architecture: $(uname -m)" >&2
            return 1
            ;;
    esac
}

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

write_address() {
    local address="$1"
    local host="${address%:*}"
    local port="${address##*:}"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Provider: LocalXpose TCP tunnel (region ${REGION:-default})"
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
        echo "#"
        echo "# Host: $host"
        echo "# Port: $port"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

fallback_to_bore() {
    local reason="$1"

    echo "WARNING: ${reason}" >&2
    if [ "$BORE_FALLBACK" = "true" ] && [ -x "$ROOT_DIR/scripts/bore-tunnel.sh" ]; then
        echo "Falling back to the stable bore.pub tunnel..." >&2
        exec bash "$ROOT_DIR/scripts/bore-tunnel.sh"
    fi

    echo "ERROR: ${reason}" >&2
    exit 1
}

ensure_loclx() {
    if [ -n "${LOCLX_BIN:-}" ]; then
        if [ ! -x "$LOCLX_BIN" ]; then
            echo "ERROR: LOCLX_BIN is not executable: $LOCLX_BIN" >&2
            return 1
        fi
        return 0
    fi

    local arch download_url download_dir
    arch="$(detect_arch)"
    LOCLX_BIN="$TOOLS_DIR/loclx-$arch"

    if [ -x "$LOCLX_BIN" ]; then
        return 0
    fi

    download_url="${LOCALXPOSE_DOWNLOAD_URL:-https://api.localxpose.io/api/downloads/loclx-linux-${arch}.zip}"
    download_dir="$TOOLS_DIR/.loclx-download-$$"
    mkdir -p "$download_dir"
    trap 'rm -rf "$download_dir"' EXIT

    echo "Downloading LocalXpose client for ${arch}..." >&2
    curl -fsSL --retry 3 --connect-timeout 15 "$download_url" \
        -o "$download_dir/loclx.zip"
    if command -v unzip >/dev/null 2>&1; then
        unzip -oq "$download_dir/loclx.zip" -d "$download_dir"
    else
        python3 -m zipfile -e "$download_dir/loclx.zip" "$download_dir"
    fi
    install -m 0755 "$download_dir/loclx" "$LOCLX_BIN"
    rm -rf "$download_dir"
    trap - EXIT

    return 0
}

extract_address() {
    local log_file="$1"
    local address=""

    # Prefer the public *.loclx.io endpoint over the local forwarded address.
    address="$(strip_ansi <"$log_file" \
        | grep -oE '[A-Za-z0-9][A-Za-z0-9.-]*\.loclx\.io:[0-9]{1,5}' \
        | head -n 1 || true)"
    if [ -z "$address" ] && [ "${LOCALXPOSE_ALLOW_LOCAL_ADDRESS:-false}" = "true" ]; then
        address="$(strip_ansi <"$log_file" \
            | grep -oE '(localhost|([0-9]{1,3}\.){3}[0-9]{1,3}):[0-9]{1,5}' \
            | head -n 1 || true)"
===== scripts/tunnl-tunnel.sh =====
#!/usr/bin/env bash
# Expose a small Ultron SMP status page through a tunnl.gg HTTP tunnel.
#
# tunnl.gg is an SSH-based reverse tunnel for HTTP and WebSocket traffic. It
# deliberately does not carry raw TCP, so it cannot be the Minecraft endpoint
# itself. This script therefore publishes a read-only status page that shows
# the current Minecraft TCP address (SERVER_ADDRESS.txt) while the game stays
# on a TCP relay such as the Bangladesh-prioritised Pinggy relay or bore.pub.
#
# The public URL is written to SERVER_STATUS_URL.txt. A supervisor reconnects
# automatically if the tunnl.gg SSH session drops.
#
# Optional environment variables:
#   TUNNL_SERVER                Relay host (default: proxy.tunnl.gg)
#   TUNNL_PORT                  Relay SSH port (default: 22)
#   TUNNL_USER                  SSH user (default: stable; empty = random URL)
#   TUNNL_SSH_KEY               SSH private key (default: generated in .agent-work/tmp)
#   TUNNL_KNOWN_HOSTS           known_hosts file used for the relay
#   TUNNL_STATUS_PORT           Local status-page port (default: 8080)
#   TUNNL_STATUS_BIND           Local status-page bind address (default: 127.0.0.1)
#   TUNNL_STATUS_URL_FILE       Output file (default: <repo>/SERVER_STATUS_URL.txt)
#   TUNNL_RECONNECT_SECONDS     Reconnect after this many seconds; 0 waits for
#                               the SSH session to end (default: 0)
#   TUNNL_SSH_BIN               SSH executable (default: ssh; used by tests)
#   TUNNL_ALLOW_LOCAL_ADDRESS   Accept http://127.0.0.1 URLs (tests; default: false)
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT_DIR/.agent-work/logs"
TMP_DIR="$ROOT_DIR/.agent-work/tmp"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$TMP_DIR}"
PID_FILE="${TUNNL_PID_FILE:-$DEFAULT_PID_DIR/ultron-tunnl-tunnel.pid}"
STATUS_URL_FILE="${TUNNL_STATUS_URL_FILE:-$ROOT_DIR/SERVER_STATUS_URL.txt}"
TUNNEL_LOG="$LOG_DIR/tunnl-tunnel.log"
STATUS_LOG="$LOG_DIR/tunnl-status.log"

REMOTE_HOST="${TUNNL_SERVER:-proxy.tunnl.gg}"
SSH_PORT="${TUNNL_PORT:-22}"
SSH_USER="${TUNNL_USER:-stable}"
RECONNECT_SECONDS="${TUNNL_RECONNECT_SECONDS:-0}"
KNOWN_HOSTS="${TUNNL_KNOWN_HOSTS:-$TMP_DIR/tunnl_known_hosts}"
SSH_BIN="${TUNNL_SSH_BIN:-ssh}"
SSH_KEY="${TUNNL_SSH_KEY:-$TMP_DIR/tunnl_ssh_key}"
STATUS_PORT="${TUNNL_STATUS_PORT:-8080}"
STATUS_BIND="${TUNNL_STATUS_BIND:-127.0.0.1}"
ALLOW_LOCAL="${TUNNL_ALLOW_LOCAL_ADDRESS:-false}"

TUNNL_HOST_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN3HFkIcqgWI6Sa1E31KiUbcfcrX/5MZl4LnaQnUYL8K"

mkdir -p "$LOG_DIR" "$TMP_DIR" "$(dirname -- "$PID_FILE")" "$(dirname -- "$STATUS_URL_FILE")"

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

write_status_url() {
    local url="$1"
    local tmp="$STATUS_URL_FILE.tmp"

    {
        echo "# Ultron SMP tunnl.gg status page"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# tunnl.gg carries HTTP/WebSocket only; connect to the address"
        echo "# in SERVER_ADDRESS.txt for Minecraft itself."
        echo "# Provider: tunnl.gg SSH tunnel (${REMOTE_HOST})"
        echo "$url"
    } >"$tmp"
    mv "$tmp" "$STATUS_URL_FILE"

    echo "$url"
}

extract_url() {
    local log_file="$1"

    python3 - "$log_file" "$ALLOW_LOCAL" <<'PY'
import json
import sys

path, allow_local = sys.argv[1], sys.argv[2].lower() == "true"
try:
    text = open(path, encoding="utf-8", errors="replace").read()
except OSError:
    raise SystemExit(0)

for line in text.splitlines():
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        event = json.loads(line)
    except ValueError:
        continue
    if event.get("event") != "tunnel":
        continue
    url = event.get("url") or ""
    if url.startswith("https://") or (allow_local and url.startswith("http://")):
        print(url)
        raise SystemExit(0)
PY
}

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

ensure_ssh_key() {
    if [ -z "$SSH_USER" ] || [ "$SSH_USER" = "anonymous" ]; then
        SSH_USER=""
        return 0
    fi

    if [ -f "$SSH_KEY" ]; then
        chmod 600 "$SSH_KEY" 2>/dev/null || true
        return 0
    fi

    if ! command -v ssh-keygen >/dev/null 2>&1; then
        echo "WARNING: ssh-keygen is unavailable; using a random tunnl.gg URL." >&2
        SSH_USER=""
        return 0
    fi

    mkdir -p "$(dirname -- "$SSH_KEY")"
    ssh-keygen -q -t ed25519 -N "" -f "$SSH_KEY" >/dev/null
    chmod 600 "$SSH_KEY" 2>/dev/null || true
}

ensure_known_hosts() {
    mkdir -p "$(dirname -- "$KNOWN_HOSTS")"
    touch "$KNOWN_HOSTS"

    if [ "$REMOTE_HOST" = "proxy.tunnl.gg" ] \
        && ! grep -qF "proxy.tunnl.gg ${TUNNL_HOST_KEY}" "$KNOWN_HOSTS" 2>/dev/null; then
        printf 'proxy.tunnl.gg %s\n' "$TUNNL_HOST_KEY" >>"$KNOWN_HOSTS"
    fi
}

start_status_server() {
    TUNNL_ROOT_DIR="$ROOT_DIR" \
        TUNNL_STATUS_PORT="$STATUS_PORT" \
        TUNNL_STATUS_BIND="$STATUS_BIND" \
        python3 "$ROOT_DIR/scripts/tunnl-status-server.py" \
        >>"$STATUS_LOG" 2>&1 &
    STATUS_PID=$!

    for _ in $(seq 1 50); do
        if ! kill -0 "$STATUS_PID" 2>/dev/null; then
            return 1
        fi
        if (echo >"/dev/tcp/${STATUS_BIND}/${STATUS_PORT}") 2>/dev/null; then
            return 0
        fi
        sleep 0.2
    done

    return 1
}

run_tunnel_once() {
    local attempt_log="$LOG_DIR/tunnl-attempt.log"
    local ssh_pid=""
    local target="$REMOTE_HOST"
    local -a ssh_args=(
        -n
        -T
        -o BatchMode=yes
        -o ConnectTimeout=20
        -o ExitOnForwardFailure=yes
        -o ServerAliveInterval=15
        -o ServerAliveCountMax=3
        -o StrictHostKeyChecking=accept-new
        -o UserKnownHostsFile="$KNOWN_HOSTS"
        -p "$SSH_PORT"
        -R "80:localhost:${STATUS_PORT}"
    )

    if [ -n "$SSH_USER" ]; then
        target="${SSH_USER}@${REMOTE_HOST}"
    fi
    if [ -f "$SSH_KEY" ]; then
        ssh_args+=(-i "$SSH_KEY")
    fi

    {
        echo "=== $(date -u '+%Y-%m-%d %H:%M:%S UTC') connecting to ${target} ==="
    } >>"$TUNNEL_LOG"

    : >"$attempt_log"
    if [ "$RECONNECT_SECONDS" -gt 0 ] 2>/dev/null; then
        timeout --signal=TERM "$RECONNECT_SECONDS" \
            "$SSH_BIN" "${ssh_args[@]}" "$target" output=json \
            >"$attempt_log" 2>&1 </dev/null &
    else
        "$SSH_BIN" "${ssh_args[@]}" "$target" output=json \
            >"$attempt_log" 2>&1 </dev/null &
    fi
    ssh_pid=$!
    ACTIVE_SSH_PID="$ssh_pid"

    local url=""
    for _ in $(seq 1 120); do
        if ! kill -0 "$ssh_pid" 2>/dev/null; then
            break
        fi

        url="$(extract_url "$attempt_log")"
        if [ -n "$url" ]; then
            echo "tunnl.gg status page is live at $(write_status_url "$url")"
            strip_ansi <"$attempt_log" | tail -n 3 >>"$TUNNEL_LOG" || true
            break
        fi

        sleep 0.5
    done

    if [ -z "$url" ]; then
        strip_ansi <"$attempt_log" | tail -n 20 >>"$TUNNEL_LOG" || true
        echo "WARNING: could not establish a tunnl.gg tunnel on this attempt." >&2
    fi

    wait "$ssh_pid" 2>/dev/null || true
    ACTIVE_SSH_PID=""
    sleep 5
}

===== run.sh =====
#!/usr/bin/env bash
# Launch the Fabric server.
#
#  * native/libjnidispatch.so is the bionic (Android) JNA native library.
#    It is only used on Termux/Android. On regular Linux/macOS the bundled
#    x86_64/glibc JNA library must be allowed to load instead.
#  * log4j2.xml colors console output (INFO green, WARN yellow, ERROR red).
#  * --sun-misc-unsafe-memory-access silences the JDK 25 warning from JOML.
#
# Optional environment variables:
#   JAVA_BIN     Java executable to use (default: java)
#   JAVA_OPTS    Extra JVM options, split on whitespace
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

JAVA_BIN="${JAVA_BIN:-java}"

if ! command -v "$JAVA_BIN" >/dev/null 2>&1; then
    echo "ERROR: '$JAVA_BIN' was not found. Install Java 25 or set JAVA_BIN." >&2
    exit 1
fi

if [ ! -f "$SCRIPT_DIR/loader.jar" ]; then
    echo "ERROR: loader.jar is missing from $SCRIPT_DIR" >&2
    exit 1
fi

JAVA_ARGS=(
    --sun-misc-unsafe-memory-access=allow
    -Doshi.os.linux.allowudev=false
)

if [ -f "$SCRIPT_DIR/log4j2.xml" ]; then
    JAVA_ARGS+=("-Dlog4j.configurationFile=$SCRIPT_DIR/log4j2.xml")
fi

# The checked-in JNA library is built for Android/bionic. Loading it on a
# normal Linux/glibc host makes JNA fail, so only point at it on Termux.
if [ -n "${TERMUX_VERSION:-}" ] \
    || [ -d "/data/data/com.termux/files/usr" ] \
    || [ "$(uname -o 2>/dev/null || true)" = "Android" ]; then
    if [ -f "$SCRIPT_DIR/native/libjnidispatch.so" ]; then
        JAVA_ARGS+=("-Djna.boot.library.path=$SCRIPT_DIR/native")
    fi
fi

if [ -n "${JAVA_OPTS:-}" ]; then
    # shellcheck disable=SC2206
    EXTRA_JAVA_ARGS=($JAVA_OPTS)
    JAVA_ARGS+=("${EXTRA_JAVA_ARGS[@]}")
fi

exec "$JAVA_BIN" "${JAVA_ARGS[@]}" -jar "$SCRIPT_DIR/loader.jar" "$@"
