PORT_FILE="$TEST_DIR/port"
STATUS_LOG="$LOG_DIR/test-twingate-admin-status.log"
PROVISION_LOG="$LOG_DIR/test-twingate-admin-provision.log"
REPEAT_LOG="$LOG_DIR/test-twingate-admin-repeat.log"
