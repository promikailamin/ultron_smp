name: Verify Twingate Connector

on:
    workflow_dispatch:

permissions:
    contents: read

concurrency:
    group: twingate-verify
    cancel-in-progress: false

jobs:
    verify:
        runs-on: ubuntu-latest
        timeout-minutes: 15
        env:
            TWINGATE_API_TOKEN: ${{ secrets.TWINGATE_API_TOKEN }}
            TWINGATE_ACCESS_TOKEN: ${{ secrets.TWINGATE_ACCESS_TOKEN }}
            TWINGATE_REFRESH_TOKEN: ${{ secrets.TWINGATE_REFRESH_TOKEN }}
            TWINGATE_NETWORK: ${{ vars.TWINGATE_NETWORK || secrets.TWINGATE_NETWORK || 'mikailamin' }}
            TWINGATE_ENABLED: auto
            TWINGATE_CONNECTOR_NAME: ${{ vars.TWINGATE_CONNECTOR_NAME || 'twingate-mccon' }}
            TWINGATE_DOCKER_PULL: ${{ vars.TWINGATE_DOCKER_PULL || 'always' }}
            TWINGATE_LABEL_HOSTNAME: ${{ vars.TWINGATE_LABEL_HOSTNAME || 'ultronsmp.net' }}
            TWINGATE_LABEL_DEPLOYED_BY: ${{ vars.TWINGATE_LABEL_DEPLOYED_BY || 'docker' }}
            TWINGATE_REMOTE_NETWORK: ${{ vars.TWINGATE_REMOTE_NETWORK }}
            TWINGATE_REMOTE_NETWORK_ID: ${{ vars.TWINGATE_REMOTE_NETWORK_ID }}
            TWINGATE_RESOURCE_NAME: ${{ vars.TWINGATE_RESOURCE_NAME || 'minecraft' }}
            TWINGATE_RESOURCE_ADDRESS: ${{ vars.TWINGATE_RESOURCE_ADDRESS || '127.0.0.1' }}
            TWINGATE_RESOURCE_ALIAS: ${{ vars.TWINGATE_RESOURCE_ALIAS || 'minecraft.ultronsmp.internal' }}
            TWINGATE_RESOURCE_PORT: ${{ vars.TWINGATE_RESOURCE_PORT || '25565' }}
        steps:
            - name: checkout_repo
              uses: actions/checkout@v4

            - name: start_connector
              run: |
                  set -euo pipefail
                  mkdir -p .agent-work/logs
                  bash scripts/twingate-connector.sh start \
                      | tee .agent-work/logs/twingate-connector.log

            - name: wait_for_connector
              run: |
                  set -euo pipefail
                  echo "Waiting for the connector to authenticate..."
                  for _ in $(seq 1 12); do
                      sleep 5
                      docker inspect --format '{{.State.Running}}' "${TWINGATE_CONNECTOR_NAME}" 2>/dev/null || true
                  done
                  docker ps --filter "name=${TWINGATE_CONNECTOR_NAME}" \
                      --format '{{.Names}} {{.Status}}' \
                      | tee .agent-work/logs/twingate-verify-container.log

            - name: show_connector_log
              run: |
                  set -euo pipefail
                  docker logs "${TWINGATE_CONNECTOR_NAME}" \
                      > .agent-work/logs/twingate-verify-connector.log 2>&1 || true
                  tail -n 40 .agent-work/logs/twingate-verify-connector.log || true

            - name: show_account
              run: |
                  set -euo pipefail
                  python3 scripts/twingate-admin.py status \
                      | tee .agent-work/logs/twingate-verify-status.log

            - name: stop_connector
              if: always()
              run: |
                  set -euo pipefail
                  bash scripts/twingate-connector.sh stop || true

            - name: upload_logs
              if: always()
              uses: actions/upload-artifact@v4
              with:
                  name: twingate-verify-logs
                  path: |
                      .agent-work/logs/twingate-connector.log
                      .agent-work/logs/twingate-verify-container.log
                      .agent-work/logs/twingate-verify-connector.log
                      .agent-work/logs/twingate-verify-status.log
                  if-no-files-found: ignore
