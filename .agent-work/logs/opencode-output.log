        if [ "${MINEKUBE_AUTO:-true}" = "true" ]; then
            default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
            if TUNNEL_PID_FILE="${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}" \
                bash "$ROOT_DIR/scripts/minekube-tunnel.sh"; then
                exit 0
            fi
