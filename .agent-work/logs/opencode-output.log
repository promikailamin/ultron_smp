+def valid_alias(value):
+    if value is None:
+        return True
+    if len(value) > 253 or "." not in value:
+        return False
+    labels = value.split(".")
+    return all(
+        0 < len(label) <= 63
+        and all(ch.isalnum() or ch == "-" for ch in label)
+        and not label.startswith("-")
+        and not label.endswith("-")
+        for label in labels
+    )
