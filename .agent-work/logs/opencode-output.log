#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT_DIR/.agent-work/logs"
DEFAULT_TMP_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
ENV_DIR="${TWINGATE_ENV_DIR:-$DEFAULT_TMP_DIR}"

DOCKER_BIN="${TWINGATE_DOCKER_BIN:-docker}"
CONTAINER_NAME="${TWINGATE_CONNECTOR_NAME:-twingate-mccon}"
IMAGE="${TWINGATE_DOCKER_IMAGE:-twingate/connector:1}"
NETWORK_MODE="${TWINGATE_DOCKER_NETWORK:-host}"
PULL_POLICY="${TWINGATE_DOCKER_PULL:-always}"
LABEL_HOSTNAME="${TWINGATE_LABEL_HOSTNAME:-ultronsmp.net}"
LABEL_DEPLOYED_BY="${TWINGATE_LABEL_DEPLOYED_BY:-docker}"
READY_TIMEOUT="${TWINGATE_READY_TIMEOUT:-90}"
NETWORK="${TWINGATE_NETWORK:-}"
ACCESS_TOKEN="${TWINGATE_ACCESS_TOKEN:-}"
REFRESH_TOKEN="${TWINGATE_REFRESH_TOKEN:-}"
LOG_LEVEL="${TWINGATE_LOG_LEVEL:-3}"
ENABLED_MODE="${TWINGATE_ENABLED:-auto}"

ENV_FILE=""

usage() {
    cat >&2 <<'EOF'
Usage: twingate-connector.sh {start|stop|status}

Required for start (provide through the environment, never on the command line):
  TWINGATE_ACCESS_TOKEN    Connector access token
  TWINGATE_REFRESH_TOKEN   Connector refresh token

Optional:
  TWINGATE_ENABLED         auto (default), true/required, or false/disabled.
                           auto starts only when both connector tokens are set.
  TWINGATE_NETWORK         Twingate network slug. If omitted, it is read from
                           the access token's "aud" claim.
  TWINGATE_CONNECTOR_NAME  Docker container name (default: twingate-mccon)
  TWINGATE_DOCKER_IMAGE    Connector image (default: twingate/connector:1)
  TWINGATE_DOCKER_BIN      Docker executable (default: docker)
  TWINGATE_DOCKER_NETWORK  Docker network mode (default: host). Host mode lets the
                           connector reach 127.0.0.1:25565 on the runner.
                           Use "default" to omit --network and let Docker choose
                           its usual bridge network.
  TWINGATE_DOCKER_PULL     Image pull policy (default: always)
  TWINGATE_LABEL_HOSTNAME  Connector hostname label (default: ultronsmp.net)
  TWINGATE_LABEL_DEPLOYED_BY
                           Deployed-by label (default: docker)
  TWINGATE_READY_TIMEOUT   Seconds to wait for the container (default: 90)
  TWINGATE_LOG_LEVEL       Connector log level (default: 3)
  TWINGATE_ENV_DIR         Directory for the temporary env file
EOF
}

cleanup() {
    if [ -n "$ENV_FILE" ] && [ -f "$ENV_FILE" ]; then
        rm -f "$ENV_FILE"
    fi
}
trap cleanup EXIT

fail() {
    echo "ERROR: $1" >&2
    exit 1
}

validate_value() {
    local name="$1"
    local value="$2"

    case "$value" in
        *$'\n'* | *$'\r'*)
            fail "$name must not contain newline characters."
            ;;
    esac
}

mode_is_disabled() {
    case "${ENABLED_MODE,,}" in
        false | 0 | no | off | disabled)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

mode_is_required() {
    case "${ENABLED_MODE,,}" in
        true | 1 | yes | on | required)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

derive_network_from_token() {
    TWINGATE_ACCESS_TOKEN="$ACCESS_TOKEN" python3 - <<'PY'
import base64
import json
import os
import sys

token = os.environ.get("TWINGATE_ACCESS_TOKEN", "")
parts = token.split(".")
if len(parts) < 2:
    sys.exit(1)

payload = parts[1] + "=" * (-len(parts[1]) % 4)
try:
    claims = json.loads(base64.urlsafe_b64decode(payload.encode("ascii")))
except Exception:
    sys.exit(1)

audience = claims.get("aud")
if isinstance(audience, list):
    audience = next((item for item in audience if isinstance(item, str) and item), None)
if not isinstance(audience, str):
    sys.exit(1)

audience = audience.strip()
if not audience or not all(ch.isalnum() or ch in "._-" for ch in audience):
    sys.exit(1)

# Twingate documents the JWT "aud" claim as the tenant/network slug.
print(audience)
PY
}

should_skip() {
    if mode_is_disabled; then
        echo "Twingate connector is disabled (TWINGATE_ENABLED=${ENABLED_MODE})."
        return 0
    fi

    if [ -z "$ACCESS_TOKEN" ] && [ -z "$REFRESH_TOKEN" ]; then
        if mode_is_required; then
            fail "TWINGATE_ACCESS_TOKEN and TWINGATE_REFRESH_TOKEN are required when TWINGATE_ENABLED=${ENABLED_MODE}."
        fi
        echo "Twingate connector skipped: TWINGATE_ACCESS_TOKEN and TWINGATE_REFRESH_TOKEN are not configured."
        return 0
    fi

    return 1
}

require_tokens() {
    local missing=""

    [ -n "$ACCESS_TOKEN" ] || missing="${missing} TWINGATE_ACCESS_TOKEN"
    [ -n "$REFRESH_TOKEN" ] || missing="${missing} TWINGATE_REFRESH_TOKEN"

    if [ -n "$missing" ]; then
        fail "missing Twingate connector configuration:${missing}. Set these as GitHub Actions secrets/variables; never paste tokens into issues or commit them."
    fi

    validate_value TWINGATE_ACCESS_TOKEN "$ACCESS_TOKEN"
    validate_value TWINGATE_REFRESH_TOKEN "$REFRESH_TOKEN"

    if [ -z "$NETWORK" ]; then
        NETWORK="$(derive_network_from_token 2>/dev/null || true)"
    fi
    if [ -z "$NETWORK" ]; then
        fail "missing Twingate connector configuration: TWINGATE_NETWORK could not be read from the access token. Set the repository variable or secret TWINGATE_NETWORK."
    fi

    validate_value TWINGATE_NETWORK "$NETWORK"
    validate_value TWINGATE_LABEL_HOSTNAME "$LABEL_HOSTNAME"
    validate_value TWINGATE_LABEL_DEPLOYED_BY "$LABEL_DEPLOYED_BY"
    validate_value TWINGATE_DOCKER_PULL "$PULL_POLICY"
}

require_docker() {
    command -v "$DOCKER_BIN" >/dev/null 2>&1 \
        || fail "'$DOCKER_BIN' is required to run the Twingate connector."
}

container_running() {
    [ "$("$DOCKER_BIN" inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null || true)" = "true" ]
}

write_env_file() {
    mkdir -p "$ENV_DIR"
    ENV_FILE="$(mktemp "$ENV_DIR/twingate-connector-env.XXXXXX")"
    chmod 600 "$ENV_FILE"

    (
        umask 077
        {
            printf 'TWINGATE_NETWORK=%s\n' "$NETWORK"
            printf 'TWINGATE_ACCESS_TOKEN=%s\n' "$ACCESS_TOKEN"
            printf 'TWINGATE_REFRESH_TOKEN=%s\n' "$REFRESH_TOKEN"
            printf 'TWINGATE_LOG_LEVEL=%s\n' "$LOG_LEVEL"
            printf 'TWINGATE_LABEL_HOSTNAME=%s\n' "$LABEL_HOSTNAME"
            printf 'TWINGATE_LABEL_DEPLOYED_BY=%s\n' "$LABEL_DEPLOYED_BY"
        } >"$ENV_FILE"
    )
}

stop_connector() {
    if ! command -v "$DOCKER_BIN" >/dev/null 2>&1; then
        return 0
    fi

    "$DOCKER_BIN" rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
}

start_connector() {
    if should_skip; then
        return 0
    fi

    require_tokens
    require_docker
    mkdir -p "$LOG_DIR"

    stop_connector
    write_env_file

    local -a run_args=(
        run -d
        --name "$CONTAINER_NAME"
        --restart unless-stopped
        --pull "$PULL_POLICY"
    )

    # Omitting --network reproduces the command Twingate prints in its Admin
    # Console, which relies on Docker's default bridge network. The repository
    # keeps host networking by default so the connector can reach the Minecraft
    # server on 127.0.0.1.
    if [ "$NETWORK_MODE" != "default" ]; then
        run_args+=(--network "$NETWORK_MODE")
    fi

    # Twingate recommends this sysctl for its default bridge network, but the
    # kernel rejects it when the container shares the host network namespace:
    #   sysctl "net.ipv4.ping_group_range" not allowed in host network namespace
    # Host networking is what lets the connector reach the Minecraft server on
    # 127.0.0.1, so only add the sysctl for non-host network modes.
    if [ "$NETWORK_MODE" != "host" ]; then
        run_args+=(--sysctl net.ipv4.ping_group_range="0 2147483647")
    fi

    run_args+=(--env-file "$ENV_FILE" "$IMAGE")

    "$DOCKER_BIN" "${run_args[@]}" >/dev/null

    local waited=0
    while [ "$waited" -lt "$READY_TIMEOUT" ]; do
        if container_running; then
            echo "Twingate connector '${CONTAINER_NAME}' is running."
            echo "Create/assign the Minecraft resource in the Twingate Admin Console; its token values were supplied only through the environment."
            return 0
        fi
        sleep 2
        waited=$((waited + 2))
    done
=====TUNE=====
#!/usr/bin/env bash
# Best-effort TCP tuning for high-latency / lossy long-distance links.
#
# Minecraft (Java) uses TCP. Players in South Asia connecting to a GitHub
# Actions runner in the US cross a long, sometimes lossy path, so BBR plus
# larger socket buffers can reduce stalls compared with the default CUBIC
# congestion control. This does not remove physical latency, but it makes
# the connection less likely to collapse under packet loss.
#
# The script is intentionally best-effort: if the runner does not expose a
# setting, it logs a warning and continues.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: network-tune.sh must run as root (use sudo)." >&2
    exit 1
fi

set_sysctl() {
    local key="$1"
    local value="$2"

    if sysctl -w "${key}=${value}" >/dev/null 2>&1; then
        echo "  ${key}=${value}"
    else
        echo "  SKIP ${key} (not available)"
    fi
}

echo "Applying low-latency TCP tuning..."

modprobe tcp_bbr 2>/dev/null || true

set_sysctl net.core.default_qdisc fq
set_sysctl net.ipv4.tcp_congestion_control bbr
set_sysctl net.ipv4.tcp_slow_start_after_idle 0
set_sysctl net.ipv4.tcp_mtu_probing 1
set_sysctl net.ipv4.tcp_fastopen 3
set_sysctl net.ipv4.tcp_keepalive_time 60
set_sysctl net.ipv4.tcp_keepalive_intvl 15
set_sysctl net.ipv4.tcp_keepalive_probes 4
set_sysctl net.ipv4.tcp_no_metrics_save 1
# Keep only a small amount of data queued in the kernel. On a long-haul
# tunnel a deep send queue turns bandwidth bursts into hundreds of
# milliseconds of extra latency (bufferbloat). 8 KiB is enough for
# Minecraft's packet stream while keeping the queue short.
set_sysctl net.ipv4.tcp_notsent_lowat 8192
set_sysctl net.ipv4.tcp_low_latency 1
set_sysctl net.ipv4.tcp_sack 1
set_sysctl net.ipv4.tcp_dsack 1
set_sysctl net.ipv4.tcp_timestamps 1
set_sysctl net.ipv4.tcp_tw_reuse 1
set_sysctl net.ipv4.tcp_max_syn_backlog 4096
set_sysctl net.core.somaxconn 1024
set_sysctl net.core.optmem_max 65536
set_sysctl net.core.netdev_max_backlog 32768
set_sysctl net.core.rmem_max 16777216
set_sysctl net.core.wmem_max 16777216
set_sysctl net.ipv4.tcp_rmem "4096 87380 16777216"
set_sysctl net.ipv4.tcp_wmem "4096 65536 16777216"

cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)"
qdisc="$(sysctl -n net.core.default_qdisc 2>/dev/null || echo unknown)"
echo "TCP tuning active: congestion_control=${cc} default_qdisc=${qdisc}"
