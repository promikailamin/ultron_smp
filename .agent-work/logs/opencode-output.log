import re
from pathlib import Path

path = Path('.agent-work/logs/opencode-output.log')
data = path.read_bytes()
pattern = re.compile(rb'eyJ[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+){2,}')

def redact(match):
    value = b'<redacted-token>'
    original = match.group(0)
    if len(value) >= len(original):
        return value[:len(original)]
    return value + b'x' * (len(original) - len(value))

updated, count = pattern.subn(redact, data)
if count:
    with path.open('r+b') as handle:
        handle.seek(0)
        handle.write(updated)
        if len(updated) < len(data):
            handle.truncate()
    print(f'Redacted {count} JWT-like value(s) from {path}.')
else:
    print(f'No JWT-like values found in {path}.')
