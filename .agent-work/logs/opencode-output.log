import socket, threading
s=socket.socket(); s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1); s.bind(('127.0.0.1',25565)); s.listen(5)
def h(c):
    try:
        while True:
            d=c.recv(4096)
            if not d: break
            c.sendall(b'ECHO:'+d)
    finally: c.close()
while True:
    c,_=s.accept(); threading.Thread(target=h,args=(c,),daemon=True).start()
PY
