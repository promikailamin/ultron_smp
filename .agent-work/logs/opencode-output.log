#!/usr/bin/env bash
# Expose the local Minecraft TCP port through bore.pub.
#
# The script tries a short list of fixed remote ports first so that players
# can keep using the same address between runs. If every fixed port is already
# taken on the public bore server it falls back to a random port.
#
# It writes the resulting address to SERVER_ADDRESS.txt and leaves the tunnel
# running in the background. The PID is stored in:
#   ${TUNNEL_PID_FILE:-${RUNNER_TEMP:-<repo>/.agent-work/tmp}/ultron-tunnel.pid}
#
# Optional environment variables:
#   MINECRAFT_PORT         Local Minecraft port (default: 25565)
#   BORE_SERVER            bore server hostname (default: bore.pub)
#   BORE_VERSION           bore release to download (default: 0.5.3)
#   TUNNEL_PORT_CANDIDATES Space separated remote ports to try (default below)
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
TOOLS_DIR="$ROOT_DIR/.agent-work/tools"
LOGS_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${TUNNEL_PID_FILE:-$DEFAULT_PID_DIR/ultron-tunnel.pid}"
TUNNEL_LOG="$LOGS_DIR/tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
REMOTE_HOST="${BORE_SERVER:-bore.pub}"
BORE_VERSION="${BORE_VERSION:-0.5.3}"
PORT_CANDIDATES="${TUNNEL_PORT_CANDIDATES:-25565 25566 25567 25568 25569 25570}"

mkdir -p "$TOOLS_DIR" "$LOGS_DIR" "$(dirname -- "$PID_FILE")"

detect_arch() {
    case "$(uname -m)" in
        x86_64 | amd64) echo "x86_64" ;;
        aarch64 | arm64) echo "aarch64" ;;
        *)
            echo "ERROR: unsupported CPU architecture: $(uname -m)" >&2
            return 1
            ;;
    esac
}

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

ARCH="$(detect_arch)"
BORE_BIN="$TOOLS_DIR/bore-$BORE_VERSION-$ARCH"

if [ ! -x "$BORE_BIN" ]; then
    echo "Downloading bore ${BORE_VERSION} for ${ARCH}..." >&2
    DOWNLOAD_DIR="$TOOLS_DIR/.bore-download-$$"
    mkdir -p "$DOWNLOAD_DIR"
    trap 'rm -rf "$DOWNLOAD_DIR"' EXIT
    curl -fsSL --retry 3 --connect-timeout 15 \
        "https://github.com/ekzhang/bore/releases/download/v${BORE_VERSION}/bore-v${BORE_VERSION}-${ARCH}-unknown-linux-musl.tar.gz" \
        -o "$DOWNLOAD_DIR/bore.tar.gz"
    tar -xzf "$DOWNLOAD_DIR/bore.tar.gz" -C "$DOWNLOAD_DIR"
    install -m 0755 "$DOWNLOAD_DIR/bore" "$BORE_BIN"
    rm -rf "$DOWNLOAD_DIR"
    trap - EXIT
fi

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

write_address() {
    local port="$1"
    local address="${REMOTE_HOST}:${port}"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
        echo "#"
        echo "# Host: $REMOTE_HOST"
        echo "# Port: $port"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

start_bore() {
    local requested_port="$1"
    local -a args=(local "$LOCAL_PORT" --to "$REMOTE_HOST")

    if [ -n "$requested_port" ]; then
        args+=(--port "$requested_port")
    fi

    : >"$TUNNEL_LOG"
    nohup "$BORE_BIN" "${args[@]}" >"$TUNNEL_LOG" 2>&1 </dev/null &
    local tunnel_pid=$!

    local escaped_host="${REMOTE_HOST//./\\.}"
    local port=""
    for _ in $(seq 1 50); do
        if ! kill -0 "$tunnel_pid" 2>/dev/null; then
            break
        fi

        port="$(strip_ansi <"$TUNNEL_LOG" \
            | grep -oE "${escaped_host}:[0-9]+" \
            | head -n 1 | cut -d: -f2 || true)"
        if [ -n "$port" ]; then
            echo "$tunnel_pid" >"$PID_FILE"
            echo "Tunnel is live at $(write_address "$port")"
            strip_ansi <"$TUNNEL_LOG" | tail -n 5 >&2 || true
            return 0
        fi

        sleep 0.2
    done

    kill "$tunnel_pid" 2>/dev/null || true
    wait "$tunnel_pid" 2>/dev/null || true
    return 1
}

stop_existing_tunnel

for port in $PORT_CANDIDATES; do
    if start_bore "$port"; then
        exit 0
    fi
    echo "Remote port ${port} is unavailable; trying the next one..." >&2
done

if start_bore ""; then
    exit 0
fi

echo "ERROR: could not establish a bore.pub tunnel." >&2
strip_ansi <"$TUNNEL_LOG" | tail -n 20 >&2 || true
exit 1
=== run.yml ===
name: Run UltronSMP

on:
    workflow_dispatch:

permissions:
    contents: write
    issues: write

concurrency:
    group: minecraft-server
    cancel-in-progress: false

jobs:
    server:
        runs-on: ubuntu-latest
        timeout-minutes: 360
        env:
            MINECRAFT_PORT: '25565'
            SERVER_ISSUE_NUMBER: '1'

        steps:
            - name: checkout_repo
              uses: actions/checkout@v4
              with:
                  fetch-depth: 0
                  ref: ${{ github.ref_name }}

            - name: setup_java_25
              uses: actions/setup-java@v4
              with:
                  distribution: temurin
                  java-version: '25'

            - name: configure_git
              env:
                  GH_TOKEN: ${{ secrets.PAT_TOKEN }}
              run: |
                  git config user.name "ultron"
                  git config user.email "ultron@users.noreply.github.com"
                  gh auth setup-git

            - name: run_server
              run: |
                  set -euo pipefail
                  nohup bash ./run.sh > server.log 2>&1 &
                  echo $! > "$RUNNER_TEMP/minecraft-server.pid"

                  echo "Waiting for Minecraft server on port ${MINECRAFT_PORT}..."

                  ready=0
                  for _ in $(seq 1 120); do
                      if (echo > "/dev/tcp/127.0.0.1/${MINECRAFT_PORT}") 2>/dev/null; then
                          ready=1
                          break
                      fi
                      if ! kill -0 "$(cat "$RUNNER_TEMP/minecraft-server.pid")" 2>/dev/null; then
                          echo "Minecraft server exited while starting."
                          break
                      fi
                      sleep 1
                  done

                  if [ "$ready" -ne 1 ]; then
                      echo "Server did not start within 120 seconds."
                      tail -n 200 server.log || true
                      exit 1
                  fi

                  echo "Minecraft server is ready!"

            - name: verify_minecraft_port
              run: |
                  set -euo pipefail
                  echo "Checking Minecraft port..."

                  ss -lntp | grep ":${MINECRAFT_PORT}" || {
                      echo "ERROR: Nothing is listening on port ${MINECRAFT_PORT}"
                      tail -100 server.log
                      exit 1
                  }

                  python3 - <<'PY'
                  import os
                  import socket

                  port = int(os.environ.get("MINECRAFT_PORT", "25565"))
                  with socket.create_connection(("127.0.0.1", port), timeout=5):
                      pass
                  print(f"Minecraft TCP port {port} is reachable locally!")
                  PY

            - name: expose_server
              id: expose-tunnel
              run: |
                  set -euo pipefail
                  bash scripts/tunnel.sh | tee .agent-work/logs/tunnel-start.log

                  address="$(grep -v '^#' SERVER_ADDRESS.txt | grep -E ':[0-9]+$' | tail -n 1)"
                  if [ -z "$address" ]; then
                      echo "ERROR: no public server address was generated."
                      exit 1
                  fi

                  echo "Tunnel has been started at ${address}"
                  echo "SERVER_ADDRESS=${address}" >> "$GITHUB_ENV"

                  {
                      echo "## Ultron SMP is online"
                      echo ""
                      echo "**Minecraft address:** \`${address}\`"
                      echo ""
                      echo "The address is also kept in \`SERVER_ADDRESS.txt\`."
                  } >> "$GITHUB_STEP_SUMMARY"

            - name: verify_public_tunnel
              run: |
                  set -euo pipefail
                  address="${SERVER_ADDRESS:-$(grep -v '^#' SERVER_ADDRESS.txt | grep -E ':[0-9]+$' | tail -n 1)}"
                  host="${address%:*}"
                  port="${address##*:}"

                  echo "Checking public endpoint ${host}:${port}..."

                  for attempt in $(seq 1 20); do
                      if python3 - "$host" "$port" <<'PY'
                  import socket
                  import sys

                  host = sys.argv[1]
                  port = int(sys.argv[2])
                  with socket.create_connection((host, port), timeout=10):
                      pass
                  print(f"{host}:{port} is reachable")
                  PY
                      then
                          echo "Public tunnel is reachable."
                          exit 0
                      fi
                      echo "Attempt ${attempt}/20 failed; retrying..."
                      sleep 3
                  done

                  echo "ERROR: the public tunnel is not reachable."
                  tail -100 .agent-work/logs/tunnel.log || true
                  exit 1

            - name: publish_server_address
              env:
                  GH_TOKEN: ${{ secrets.PAT_TOKEN }}
              run: |
                  set -euo pipefail
                  address="${SERVER_ADDRESS:-$(grep -v '^#' SERVER_ADDRESS.txt | grep -E ':[0-9]+$' | tail -n 1)}"
                  host="${address%:*}"
                  port="${address##*:}"

                  echo "Publishing ${address}..."

                  git add SERVER_ADDRESS.txt
                  if ! git diff --cached --quiet; then
                      git commit -m "Update public server address: ${address}"
                      git fetch origin "$GITHUB_REF_NAME" || true
                      git rebase "origin/$GITHUB_REF_NAME" || git rebase --abort || true
                      git push origin "HEAD:$GITHUB_REF_NAME" \
                          || echo "Address push failed; the keep-alive loop will retry."
                  fi

                  if [ -n "${SERVER_ISSUE_NUMBER:-}" ] && [ -n "${address}" ]; then
                      gh issue comment "$SERVER_ISSUE_NUMBER" \
                          --repo "${{ github.repository }}" \
                          --body "Ultron SMP is online. Connect with \`${address}\` (host \`${host}\`, port \`${port}\`). The current address is also kept in \`SERVER_ADDRESS.txt\`." \
                          || echo "Could not comment on the issue (continuing)."
                  fi

            - name: keep_server_alive
              timeout-minutes: 350
              env:
                  GH_TOKEN: ${{ secrets.PAT_TOKEN }}
              run: |
                  set -euo pipefail
                  server_pid="$(cat "$RUNNER_TEMP/minecraft-server.pid")"
                  tunnel_pid_file="$RUNNER_TEMP/ultron-tunnel.pid"
                  tunnel_pid="$(cat "$tunnel_pid_file" 2>/dev/null || true)"

                  while kill -0 "$server_pid" 2>/dev/null; do
                      server_stopped=0

                      for _ in $(seq 1 10); do
                          sleep 30

                          if ! kill -0 "$server_pid" 2>/dev/null; then
                              server_stopped=1
                              break
                          fi

                          if [ -z "${tunnel_pid:-}" ] || ! kill -0 "$tunnel_pid" 2>/dev/null; then
                              echo "Tunnel process stopped; restarting it..."
                              if bash scripts/tunnel.sh | tee -a .agent-work/logs/tunnel-restarts.log; then
                                  tunnel_pid="$(cat "$tunnel_pid_file")"
                                  address="$(grep -v '^#' SERVER_ADDRESS.txt | grep -E ':[0-9]+$' | tail -n 1)"
                                  echo "Tunnel restarted at ${address}"
                                  if [ -n "${SERVER_ISSUE_NUMBER:-}" ] && [ -n "${address}" ]; then
                                      gh issue comment "$SERVER_ISSUE_NUMBER" \
                                          --repo "${{ github.repository }}" \
                                          --body "Ultron SMP is online. Connect with \`${address}\`. The tunnel was restarted and the address in \`SERVER_ADDRESS.txt\` is current." \
                                          || true
                                  fi
                              else
                                  echo "Tunnel restart failed; will retry shortly."
                                  sleep 15
                              fi
                          fi
                      done

                      if [ "$server_stopped" -eq 1 ]; then
                          break
                      fi

                      echo "Saving Minecraft server data..."
                      git add -A

                      if ! git diff --cached --quiet; then
                          git commit -m "Auto-save Minecraft server data"
                          saved=0
                          for _ in 1 2 3; do
                              if ! git fetch origin "$GITHUB_REF_NAME"; then
                                  sleep 5
                                  continue
                              fi

                              if git rebase "origin/$GITHUB_REF_NAME"; then
                                  if git push origin "HEAD:$GITHUB_REF_NAME"; then
                                      saved=1
                                      break
                                  fi
                              else
                                  git rebase --abort || true
                              fi
                              sleep 5
                          done

                          if [ "$saved" -ne 1 ]; then
                              echo "WARNING: could not push the save; will retry next cycle."
                          fi
                      else
                          echo "No changes to save."
                      fi
                  done

                  echo "Minecraft server stopped."
                  exit 1

            - name: restore_final_server
              if: always()
              env:
                  GH_TOKEN: ${{ secrets.PAT_TOKEN }}
              run: |
                  set -euo pipefail
                  echo "Performing final save..."

                  git add -A

                  if ! git diff --cached --quiet; then
                      git commit -m "Final Minecraft server backup"
                  else
                      echo "No new changes."
                  fi

                  pushed=0
                  for _ in 1 2 3; do
                      if ! git fetch origin "$GITHUB_REF_NAME"; then
                          sleep 5
                          continue
                      fi

                      if git rebase "origin/$GITHUB_REF_NAME"; then
                          if git push origin "HEAD:$GITHUB_REF_NAME"; then
                              pushed=1
                              break
                          fi
                      else
                          git rebase --abort || true
                      fi
                      sleep 5
                  done

                  if [ "$pushed" -ne 1 ]; then
                      echo "ERROR: final backup could not be pushed."
                      exit 1
                  fi

                  echo "Backup completed."
