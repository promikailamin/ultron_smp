#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
LOG_DIR="$ROOT_DIR/.agent-work/logs"
TMP_DIR="$ROOT_DIR/.agent-work/tmp"
TEST_DIR="$TMP_DIR/twingate-connector-test"
FAKE_DOCKER="$TEST_DIR/fake-docker"
STATE_DIR="$TEST_DIR/state"
ENV_DIR="$TEST_DIR/env"
CONTAINER_NAME="ultron-twingate-test"
START_LOG="$LOG_DIR/test-twingate-connector-start.log"
MISSING_LOG="$LOG_DIR/test-twingate-connector-missing.log"

mkdir -p "$LOG_DIR" "$TMP_DIR"
rm -rf "$TEST_DIR"
mkdir -p "$STATE_DIR" "$ENV_DIR"

cat >"$FAKE_DOCKER" <<'PY'
#!/usr/bin/env bash
set -euo pipefail

state_dir="${FAKE_DOCKER_STATE_DIR:?}"
command="${1:-}"
shift || true

case "$command" in
    run)
        env_file=""
        name=""
        network=""
        sysctl_value=""
        pull_policy=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --name)
                    name="$2"
                    shift 2
                    ;;
                --env-file)
                    env_file="$2"
                    shift 2
                    ;;
                --network)
                    network="$2"
                    shift 2
                    ;;
                --sysctl)
                    sysctl_value="$2"
                    shift 2
                    ;;
                --pull)
                    pull_policy="$2"
                    shift 2
                    ;;
                --restart)
                    shift 2
                    ;;
                -*)
                    shift
                    ;;
                *)
                    shift
                    ;;
            esac
        done

        [ -n "$name" ] || { echo "fake docker: missing name" >&2; exit 1; }
        [ -f "$env_file" ] || { echo "fake docker: env file missing" >&2; exit 1; }

        # Reproduce the real kernel restriction that broke the connector:
        # the ping_group_range sysctl cannot be set in the host netns.
        if [ "$network" = "host" ] && [ -n "$sysctl_value" ]; then
            echo "fake docker: sysctl \"net.ipv4.ping_group_range\" not allowed in host network namespace" >&2
            exit 125
        fi

        printf '%s\n' "$network" >"$state_dir/run-network"
        printf '%s\n' "$sysctl_value" >"$state_dir/run-sysctl"
        printf '%s\n' "$pull_policy" >"$state_dir/run-pull"
        printf '%s\n' "$(sed -n 's/^TWINGATE_LABEL_HOSTNAME=//p' "$env_file")" >"$state_dir/run-label-hostname"
        printf '%s\n' "$(sed -n 's/^TWINGATE_LABEL_DEPLOYED_BY=//p' "$env_file")" >"$state_dir/run-label-deployed-by"

        for key in TWINGATE_NETWORK TWINGATE_ACCESS_TOKEN TWINGATE_REFRESH_TOKEN TWINGATE_LABEL_HOSTNAME TWINGATE_LABEL_DEPLOYED_BY; do
            value="$(sed -n "s/^${key}=//p" "$env_file")"
            [ -n "$value" ] || { echo "fake docker: ${key} is empty" >&2; exit 1; }
        done

        if [ -n "${FAKE_DOCKER_EXPECT_NETWORK:-}" ]; then
            network="$(sed -n 's/^TWINGATE_NETWORK=//p' "$env_file")"
            [ "$network" = "$FAKE_DOCKER_EXPECT_NETWORK" ] || {
                echo "fake docker: unexpected network" >&2
                exit 1
            }
        fi

        umask 077
        printf '%s\n' "$env_file" >"$state_dir/env-file-path"
        printf 'run\n' >>"$state_dir/run-calls"
        printf 'true\n' >"$state_dir/${name}.running"
        echo "fake-container-id"
        ;;
    inspect)
        name="${@: -1}"
        if [ -f "$state_dir/${name}.running" ]; then
            cat "$state_dir/${name}.running"
        else
            exit 1
        fi
        ;;
    rm)
        name="${@: -1}"
        rm -f "$state_dir/${name}.running"
        ;;
    *)
        exit 0
        ;;
esac
PY
chmod +x "$FAKE_DOCKER"

cleanup() {
    rm -rf "$TEST_DIR"
}
trap cleanup EXIT

bash -n "$ROOT_DIR/scripts/twingate-connector.sh"

python3 - "$ROOT_DIR/.github/workflows/run.yml" <<'PY'
import sys
