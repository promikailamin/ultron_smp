#!/usr/bin/env bash
# Best-effort TCP tuning for high-latency / lossy long-distance links.
#
# Minecraft (Java) uses TCP. Players in South Asia connecting to a GitHub
# Actions runner in the US cross a long, sometimes lossy path, so BBR plus
# larger socket buffers can reduce stalls compared with the default CUBIC
# congestion control. This does not remove physical latency, but it makes
# the connection less likely to collapse under packet loss.
#
# The script is intentionally best-effort: if the runner does not expose a
# setting, it logs a warning and continues.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: network-tune.sh must run as root (use sudo)." >&2
    exit 1
fi

set_sysctl() {
    local key="$1"
    local value="$2"

    if sysctl -w "${key}=${value}" >/dev/null 2>&1; then
        echo "  ${key}=${value}"
    else
        echo "  SKIP ${key} (not available)"
    fi
}

echo "Applying low-latency TCP tuning..."

modprobe tcp_bbr 2>/dev/null || true

set_sysctl net.core.default_qdisc fq
set_sysctl net.ipv4.tcp_congestion_control bbr
set_sysctl net.ipv4.tcp_slow_start_after_idle 0
set_sysctl net.ipv4.tcp_mtu_probing 1
set_sysctl net.ipv4.tcp_fastopen 3
set_sysctl net.ipv4.tcp_keepalive_time 60
set_sysctl net.ipv4.tcp_keepalive_intvl 15
set_sysctl net.ipv4.tcp_keepalive_probes 4
set_sysctl net.ipv4.tcp_no_metrics_save 1
set_sysctl net.ipv4.tcp_notsent_lowat 16384
set_sysctl net.core.netdev_max_backlog 16384
set_sysctl net.core.rmem_max 16777216
set_sysctl net.core.wmem_max 16777216
set_sysctl net.ipv4.tcp_rmem "4096 87380 16777216"
set_sysctl net.ipv4.tcp_wmem "4096 65536 16777216"

cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)"
qdisc="$(sysctl -n net.core.default_qdisc 2>/dev/null || echo unknown)"
echo "TCP tuning active: congestion_control=${cc} default_qdisc=${qdisc}"
===== low-latency-tunnel
#!/usr/bin/env bash
# Expose the local Minecraft port through Pinggy's free TCP relay.
#
# Pinggy has relays in Asia-Pacific (Singapore), the US and Europe. By
# default the script measures the runner-side latency to each relay and adds
# an approximate South Asian player-side cost, then picks the lowest total.
# This avoids sending players in Bangladesh through the public bore.pub relay
# in New Jersey (US East) when a closer route is available.
#
# Free Pinggy tunnels expire after about 60 minutes, so this script runs a
# supervisor that reconnects before the expiry and rewrites
# SERVER_ADDRESS_LOW_LATENCY.txt with the new address. The stable bore.pub
# address in SERVER_ADDRESS.txt remains available as a fallback.
#
# Optional environment variables:
#   MINECRAFT_PORT            Local Minecraft port (default: 25565)
#   PINGGY_SERVER             Relay host, or "auto" to measure and pick the
#                             best relay for a South Asian player
#                             (default: auto)
#   PINGGY_PORT               Relay SSH port (default: 443)
#   PINGGY_USER               Relay user (default: tcp)
#   PINGGY_RECONNECT_SECONDS  Reconnect before Pinggy's 60 minute limit
#                             (default: 3300)
#   PINGGY_KNOWN_HOSTS        known_hosts file used for the relay
#   PINGGY_SSH_BIN            SSH executable (default: ssh; used by tests)
#   TUNNEL_REGION             Force a free relay region: bangladesh/asia-pacific
#                             (Singapore), united-states, europe, or auto to
#                             measure and pick (default: auto)
#   PLAYER_REGION             "bangladesh"/"bd" gives the Asia-Pacific relay a
#                             preference margin, "auto" picks the lowest total
#                             (default: auto)
#   BANGLADESH_RELAY_MARGIN_MS Margin used for the Bangladesh preference
#                             (default: 75)
#   LOW_LATENCY_ADDRESS_FILE  Address output file
#                             (default: <repo>/SERVER_ADDRESS_LOW_LATENCY.txt)
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="${LOW_LATENCY_ADDRESS_FILE:-$ROOT_DIR/SERVER_ADDRESS_LOW_LATENCY.txt}"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${LOW_LATENCY_PID_FILE:-$DEFAULT_PID_DIR/ultron-low-latency-tunnel.pid}"
TUNNEL_LOG="$LOG_DIR/pinggy-tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
PINGGY_SERVER="${PINGGY_SERVER:-auto}"
RELAY_HOST=""
RELAY_SSH_PORT="${PINGGY_PORT:-443}"
RELAY_USER="${PINGGY_USER:-tcp}"
RECONNECT_SECONDS="${PINGGY_RECONNECT_SECONDS:-3300}"
KNOWN_HOSTS="${PINGGY_KNOWN_HOSTS:-$ROOT_DIR/.agent-work/tmp/pinggy_known_hosts}"
SSH_BIN="${PINGGY_SSH_BIN:-ssh}"
TUNNEL_REGION="${TUNNEL_REGION:-auto}"
PLAYER_REGION="${PLAYER_REGION:-auto}"
BANGLADESH_RELAY_MARGIN_MS="${BANGLADESH_RELAY_MARGIN_MS:-75}"

mkdir -p "$LOG_DIR" "$(dirname -- "$PID_FILE")" "$(dirname -- "$KNOWN_HOSTS")"

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

measure_relay_latency_ms() {
    local relay="$1"

    python3 - "$relay" "$RELAY_SSH_PORT" <<'PY' 2>/dev/null || echo 9999
import socket
import sys
import time

relay = sys.argv[1]
port = int(sys.argv[2])
best = None
for _ in range(2):
    started = time.perf_counter()
    try:
        with socket.create_connection((relay, port), timeout=4):
            pass
    except OSError:
        continue
    elapsed = (time.perf_counter() - started) * 1000
    if best is None or elapsed < best:
        best = elapsed
print(int(best) if best is not None else 9999)
PY
}

relay_for_region() {
    case "$1" in
        bangladesh | bd | south-asia | southasia | asia | asia-pacific | apac | ap | singapore | sg | india | in)
            echo "ap.free.pinggy.io"
            ;;
        us | usa | united-states | america | north-america | na)
            echo "us.free.pinggy.io"
            ;;
        eu | europe | uk | united-kingdom | germany | de)
            echo "eu.free.pinggy.io"
            ;;
        *.*)
            # Allow a literal relay hostname for advanced users.
            echo "$1"
            ;;
        *)
            return 1
            ;;
    esac
}

select_relay() {
    if [ "$PINGGY_SERVER" != "auto" ]; then
        RELAY_HOST="$PINGGY_SERVER"
        return 0
    fi

    local region forced_relay
    region="$(printf '%s' "$TUNNEL_REGION" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
    if forced_relay="$(relay_for_region "$region")"; then
        RELAY_HOST="$forced_relay"
        echo "Using the ${region} relay from TUNNEL_REGION: ${RELAY_HOST}" >&2
        return 0
    fi
    if [ "$region" != "auto" ]; then
        echo "WARNING: unknown TUNNEL_REGION '${TUNNEL_REGION}'; measuring relays instead." >&2
    fi

    # Approximate one-way network cost from Bangladesh/South Asia to each
    # relay. The runner-side latency is measured live, so the choice still
    # adapts when GitHub places the job in a different region.
    local best_relay=""
    local best_score=99999
    local ap_relay=""
    local ap_score=99999
    local relay player_leg runner_leg score

    for relay in ap.free.pinggy.io us.free.pinggy.io eu.free.pinggy.io; do
        runner_leg="$(measure_relay_latency_ms "$relay")"
        case "$relay" in
            ap.*) player_leg=55 ;;
            us.*) player_leg=200 ;;
            eu.*) player_leg=150 ;;
            *) player_leg=150 ;;
        esac
        score=$((runner_leg + player_leg))
        echo "Relay candidate ${relay}: runner ${runner_leg}ms + player ~${player_leg}ms = ${score}ms" >&2
        if [ "$score" -lt "$best_score" ]; then
            best_score="$score"
            best_relay="$relay"
        fi
        if [ "$relay" = "ap.free.pinggy.io" ]; then
            ap_relay="$relay"
            ap_score="$score"
        fi
    done

    if [ -z "$best_relay" ] || [ "$best_score" -ge 99999 ]; then
        best_relay="us.free.pinggy.io"
    fi

    # Bangladesh/South Asia players get the Singapore relay unless another
    # route is clearly faster. This avoids switching them to a distant relay
    # for a small runner-side measurement difference.
    case "$(printf '%s' "$PLAYER_REGION" | tr '[:upper:]' '[:lower:]')" in
        bangladesh | bd | south-asia | southasia)
            if [ -n "$ap_relay" ] && [ "$ap_score" -lt 99999 ] \
                && [ "$ap_score" -le $((best_score + BANGLADESH_RELAY_MARGIN_MS)) ]; then
                best_relay="$ap_relay"
                best_score="$ap_score"
                echo "Prioritising the Asia-Pacific relay for Bangladesh/South Asia players." >&2
            fi
            ;;
    esac

    RELAY_HOST="$best_relay"
    echo "Selected low-latency relay: ${RELAY_HOST} (estimated ${best_score}ms)" >&2
}

write_address() {
    local address="$1"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP low-latency public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Relay: Pinggy ${RELAY_HOST} (free relay, region ${TUNNEL_REGION}, reconnects about once an hour)"
        if [ "$ADDRESS_FILE" != "$ROOT_DIR/SERVER_ADDRESS.txt" ]; then
            echo "# Stable fallback: see SERVER_ADDRESS.txt"
        fi
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

run_tunnel_once() {
    local attempt_log="$LOG_DIR/pinggy-attempt.log"
    local ssh_pid=""

    {
        echo "=== $(date -u '+%Y-%m-%d %H:%M:%S UTC') connecting to ${RELAY_HOST} ==="
    } >>"$TUNNEL_LOG"

    # Pinggy's free relay uses password authentication with an empty
    # password. BatchMode would refuse that, so keep it disabled and feed
    # /dev/null to avoid waiting for terminal input.
    local -a ssh_args=(
        -T
        -o BatchMode=no
        -o ConnectTimeout=20
        -o ExitOnForwardFailure=yes
        -o NumberOfPasswordPrompts=1
        -o PasswordAuthentication=yes
        -o PreferredAuthentications=password
        -o PubkeyAuthentication=no
        -o KbdInteractiveAuthentication=no
        -o ServerAliveInterval=15
        -o ServerAliveCountMax=3
        -o StrictHostKeyChecking=accept-new
        -o UserKnownHostsFile="$KNOWN_HOSTS"
        -p "$RELAY_SSH_PORT"
        -R "0:localhost:${LOCAL_PORT}"
    )

    if [ "$RECONNECT_SECONDS" -gt 0 ] 2>/dev/null; then
        timeout --signal=TERM "$RECONNECT_SECONDS" \
            "$SSH_BIN" "${ssh_args[@]}" "${RELAY_USER}@${RELAY_HOST}" \
            >"$attempt_log" 2>&1 </dev/null &
    else
        "$SSH_BIN" "${ssh_args[@]}" "${RELAY_USER}@${RELAY_HOST}" \
            >"$attempt_log" 2>&1 </dev/null &
    fi
    ssh_pid=$!
    ACTIVE_SSH_PID="$ssh_pid"

    local address=""
    for _ in $(seq 1 60); do
        if ! kill -0 "$ssh_pid" 2>/dev/null; then
            break
        fi

        address="$(strip_ansi <"$attempt_log" \
            | grep -oE 'tcp://[^[:space:]]+' \
            | head -n 1 \
            | sed 's#^tcp://##' || true)"
        if [ -n "$address" ]; then
            echo "Low-latency tunnel is live at $(write_address "$address")"
            strip_ansi <"$attempt_log" | tail -n 5 >>"$TUNNEL_LOG" || true
            break
        fi

        sleep 0.5
    done

    if [ -z "$address" ]; then
        strip_ansi <"$attempt_log" | tail -n 20 >>"$TUNNEL_LOG" || true
        echo "WARNING: could not establish a Pinggy tunnel on this attempt." >&2
    fi

    wait "$ssh_pid" 2>/dev/null || true
    ACTIVE_SSH_PID=""
    sleep 5
}

supervise() {
    ACTIVE_SSH_PID=""

    # Make sure the relay SSH process is gone when the supervisor is stopped.
    # shellcheck disable=SC2329
    cleanup() {
        if [ -n "$ACTIVE_SSH_PID" ]; then
            kill "$ACTIVE_SSH_PID" 2>/dev/null || true
            wait "$ACTIVE_SSH_PID" 2>/dev/null || true
        fi
    }
    trap 'cleanup; exit 0' TERM INT
    trap cleanup EXIT

    while true; do
        run_tunnel_once
    done
}

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

if [ "${1:-}" = "--supervise" ]; then
    select_relay
    supervise
    exit 0
fi

select_relay
export PINGGY_SERVER="$RELAY_HOST"

if ! command -v "$SSH_BIN" >/dev/null 2>&1; then
    echo "ERROR: '$SSH_BIN' is required for the low-latency tunnel." >&2
    exit 1
fi

stop_existing_tunnel
rm -f "$ADDRESS_FILE"

: >"$TUNNEL_LOG"
nohup "$0" --supervise >/dev/null 2>&1 </dev/null &
supervisor_pid=$!
echo "$supervisor_pid" >"$PID_FILE"

# Wait for the supervisor to publish the first address.
for _ in $(seq 1 90); do
    if ! kill -0 "$supervisor_pid" 2>/dev/null; then
        break
    fi

    if [ -s "$ADDRESS_FILE" ] \
        && grep -qE ':[0-9]+$' "$ADDRESS_FILE" 2>/dev/null; then
        address="$(grep -v '^#' "$ADDRESS_FILE" | grep -E ':[0-9]+$' | tail -n 1)"
        if [ -n "$address" ]; then
            echo "Low-latency tunnel is live at ${address} (pid ${supervisor_pid})"
            exit 0
        fi
    fi

    sleep 1
done

kill "$supervisor_pid" 2>/dev/null || true
wait "$supervisor_pid" 2>/dev/null || true
rm -f "$PID_FILE"
echo "ERROR: could not establish a Pinggy low-latency tunnel." >&2
strip_ansi <"$TUNNEL_LOG" | tail -n 30 >&2 || true
exit 1
===== tunnel.sh
#!/usr/bin/env bash
# Expose the local Minecraft TCP port through LocalXpose.
#
# LocalXpose is the primary tunnel provider. It is authenticated with an
# access token supplied through the LOCALXPOSE_ACCESS_TOKEN (or ACCESS_TOKEN)
# environment variable; the token is never written into this repository.
#
# LocalXpose TCP tunnels require a PRO account. If the token belongs to a
# FREE account (HTTP/HTTPS only), or the tunnel cannot be established for any
# other reason, this script falls back to the stable bore.pub tunnel unless
# LOCALXPOSE_BORE_FALLBACK=false is set.
#
# It writes the resulting address to SERVER_ADDRESS.txt and leaves the tunnel
# running in the background. The PID is stored in:
#   ${TUNNEL_PID_FILE:-${RUNNER_TEMP:-<repo>/.agent-work/tmp}/ultron-tunnel.pid}
#
# TUNNEL_PROVIDER selects the provider used by the workflow:
#   auto        Try Minekube Connect, then LocalXpose, then bore.pub (default)
#   localxpose  Force the LocalXpose tunnel
#   bore        Force the bore.pub tunnel
#   serveo      Force the Serveo SSH tunnel
#   pinggy      Force the Bangladesh-prioritised Pinggy TCP relay
#   tunnl       Use a low-latency TCP relay for Minecraft and add a
#               tunnl.gg HTTP status page (tunnl.gg cannot carry raw TCP)
#   minekube    Use the Minekube Connect network through the Gate connector
#
# Optional environment variables:
#   TUNNEL_PROVIDER             Tunnel provider (default: auto)
#   MINEKUBE_AUTO               Set to false to skip Minekube for auto
#   MINEKUBE_ENDPOINT           Stable Minekube endpoint name
#   MINEKUBE_CONNECT_TOKEN      Minekube connector token (repository secret)
#   TUNNEL_REGION               Force a free Pinggy relay region:
#                               bangladesh/asia-pacific, united-states,
#                               europe, or auto to measure all of them
#                               (default: auto)
#   PLAYER_REGION               bangladesh/bd prioritises the Asia-Pacific
#                               Pinggy relay (default: bangladesh for
#                               pinggy/tunnl, auto for the standalone script)
#   LOCALXPOSE_ACCESS_TOKEN     LocalXpose access token (required)
#   ACCESS_TOKEN                Alternative token variable name
#   MINECRAFT_PORT              Local Minecraft port (default: 25565)
#   LOCALXPOSE_REGION           Relay region: us, ap, eu, or auto
#                               (default: ap)
#   LOCALXPOSE_PORT_CANDIDATES  Space separated remote ports to try before
#                               asking LocalXpose for a random port
#   LOCALXPOSE_DOWNLOAD_URL     Override the loclx download URL
#   LOCALXPOSE_BORE_FALLBACK    Fall back to bore.pub on failure
#                               (default: true)
#   LOCALXPOSE_ALLOW_LOCAL_ADDRESS
#                               Accept a 127.0.0.1/localhost endpoint from
#                               loclx output (used by tests; default: false)
#   LOCLX_BIN                   Use an existing loclx binary (used by tests)
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

PROVIDER="$(printf '%s' "${TUNNEL_PROVIDER:-auto}" | tr '[:upper:]' '[:lower:]')"
case "$PROVIDER" in
    "" | auto)
        if [ "${MINEKUBE_AUTO:-true}" = "true" ]; then
            default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
            if TUNNEL_PID_FILE="${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}" \
                bash "$ROOT_DIR/scripts/minekube-tunnel.sh"; then
                exit 0
            fi
            echo "WARNING: Minekube Connect could not be started; trying LocalXpose..." >&2
        fi
        ;;
    minekube | minekube-connect | connect)
        exec bash "$ROOT_DIR/scripts/minekube-tunnel.sh"
        ;;
    localxpose | loclx)
        # An explicit provider choice should not silently switch to bore.pub.
        # Set LOCALXPOSE_BORE_FALLBACK=true to opt back into the fallback.
        if [ -z "${LOCALXPOSE_BORE_FALLBACK:-}" ]; then
            export LOCALXPOSE_BORE_FALLBACK=false
        fi
        ;;
    bore | bore.pub)
        exec bash "$ROOT_DIR/scripts/bore-tunnel.sh"
        ;;
    serveo)
        exec bash "$ROOT_DIR/scripts/serveo-tunnel.sh"
        ;;
    pinggy | low-latency)
        default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
        export PLAYER_REGION="${PLAYER_REGION:-bangladesh}"
        export LOW_LATENCY_ADDRESS_FILE="${LOW_LATENCY_ADDRESS_FILE:-$ROOT_DIR/SERVER_ADDRESS.txt}"
        export LOW_LATENCY_PID_FILE="${LOW_LATENCY_PID_FILE:-${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}}"
        exec bash "$ROOT_DIR/scripts/low-latency-tunnel.sh"
        ;;
    tunnl | tunnl.gg)
        # tunnl.gg only carries HTTP/WebSocket, so it cannot be the Minecraft
        # TCP endpoint. Prioritise the Asia-Pacific TCP relay for Bangladeshi
        # players, then publish a tunnl.gg status page alongside it.
        default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
        export PLAYER_REGION="${PLAYER_REGION:-bangladesh}"
        export LOW_LATENCY_ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
        export LOW_LATENCY_PID_FILE="${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}"
        if bash "$ROOT_DIR/scripts/low-latency-tunnel.sh"; then
            bash "$ROOT_DIR/scripts/tunnl-tunnel.sh" \
                || echo "WARNING: the tunnl.gg status page could not be started; the Minecraft tunnel is still online." >&2
            exit 0
        fi
        echo "WARNING: the low-latency TCP relay failed; falling back to bore.pub for Minecraft." >&2
        exec bash "$ROOT_DIR/scripts/bore-tunnel.sh"
        ;;
    *)
        echo "ERROR: unsupported TUNNEL_PROVIDER '${PROVIDER}' (use auto, localxpose, bore, serveo, pinggy, tunnl or minekube)." >&2
        exit 2
        ;;
esac

TOOLS_DIR="$ROOT_DIR/.agent-work/tools"
LOGS_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${TUNNEL_PID_FILE:-$DEFAULT_PID_DIR/ultron-tunnel.pid}"
TUNNEL_LOG="$LOGS_DIR/localxpose-tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
REGION="${LOCALXPOSE_REGION:-ap}"
PORT_CANDIDATES="${LOCALXPOSE_PORT_CANDIDATES:-25565 25566 25567 25568 25569 25570}"
ACCESS_TOKEN="${LOCALXPOSE_ACCESS_TOKEN:-${ACCESS_TOKEN:-${LX_ACCESS_TOKEN:-}}}"
BORE_FALLBACK="${LOCALXPOSE_BORE_FALLBACK:-true}"

mkdir -p "$TOOLS_DIR" "$LOGS_DIR" "$(dirname -- "$PID_FILE")"

detect_arch() {
    case "$(uname -m)" in
        x86_64 | amd64) echo "amd64" ;;
        aarch64 | arm64) echo "arm64" ;;
        *)
            echo "ERROR: unsupported CPU architecture: $(uname -m)" >&2
            return 1
            ;;
    esac
}

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

write_address() {
    local address="$1"
    local host="${address%:*}"
    local port="${address##*:}"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Provider: LocalXpose TCP tunnel (region ${REGION:-default})"
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
        echo "#"
        echo "# Host: $host"
        echo "# Port: $port"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

fallback_to_bore() {
    local reason="$1"

    echo "WARNING: ${reason}" >&2
    if [ "$BORE_FALLBACK" = "true" ] && [ -x "$ROOT_DIR/scripts/bore-tunnel.sh" ]; then
        echo "Falling back to the stable bore.pub tunnel..." >&2
        exec bash "$ROOT_DIR/scripts/bore-tunnel.sh"
    fi

    echo "ERROR: ${reason}" >&2
    exit 1
}

ensure_loclx() {
    if [ -n "${LOCLX_BIN:-}" ]; then
        if [ ! -x "$LOCLX_BIN" ]; then
            echo "ERROR: LOCLX_BIN is not executable: $LOCLX_BIN" >&2
            return 1
        fi
        return 0
    fi

    local arch download_url download_dir
    arch="$(detect_arch)"
    LOCLX_BIN="$TOOLS_DIR/loclx-$arch"

    if [ -x "$LOCLX_BIN" ]; then
        return 0
    fi

    download_url="${LOCALXPOSE_DOWNLOAD_URL:-https://api.localxpose.io/api/downloads/loclx-linux-${arch}.zip}"
    download_dir="$TOOLS_DIR/.loclx-download-$$"
    mkdir -p "$download_dir"
    trap 'rm -rf "$download_dir"' EXIT

    echo "Downloading LocalXpose client for ${arch}..." >&2
    curl -fsSL --retry 3 --connect-timeout 15 "$download_url" \
        -o "$download_dir/loclx.zip"
    if command -v unzip >/dev/null 2>&1; then
        unzip -oq "$download_dir/loclx.zip" -d "$download_dir"
    else
        python3 -m zipfile -e "$download_dir/loclx.zip" "$download_dir"
    fi
    install -m 0755 "$download_dir/loclx" "$LOCLX_BIN"
    rm -rf "$download_dir"
    trap - EXIT

    return 0
}

extract_address() {
    local log_file="$1"
    local address=""

    # Prefer the public *.loclx.io endpoint over the local forwarded address.
    address="$(strip_ansi <"$log_file" \
        | grep -oE '[A-Za-z0-9][A-Za-z0-9.-]*\.loclx\.io:[0-9]{1,5}' \
        | head -n 1 || true)"
    if [ -z "$address" ] && [ "${LOCALXPOSE_ALLOW_LOCAL_ADDRESS:-false}" = "true" ]; then
        address="$(strip_ansi <"$log_file" \
            | grep -oE '(localhost|([0-9]{1,3}\.){3}[0-9]{1,3}):[0-9]{1,5}' \
            | head -n 1 || true)"
    fi

    printf '%s' "$address"
}

start_localxpose() {
    local requested_port="${1:-}"
    local -a args=(tunnel --raw-mode tcp --to "127.0.0.1:${LOCAL_PORT}")
    local attempt_log="$LOGS_DIR/localxpose-attempt.log"
    local address=""
    local loclx_pid=""

    if [ -n "$REGION" ] && [ "$REGION" != "auto" ]; then
        args+=(--region "$REGION")
    fi
    if [ -n "$requested_port" ]; then
        args+=(--port "$requested_port")
    fi

    {
        echo "=== $(date -u '+%Y-%m-%d %H:%M:%S UTC') attempt port=${requested_port:-random} region=${REGION:-default} ==="
    } >>"$TUNNEL_LOG"

    : >"$attempt_log"
    (
        export ACCESS_TOKEN
        exec "$LOCLX_BIN" "${args[@]}"
    ) >"$attempt_log" 2>&1 </dev/null &
    loclx_pid=$!

    for _ in $(seq 1 100); do
        if ! kill -0 "$loclx_pid" 2>/dev/null; then
            break
        fi

        address="$(extract_address "$attempt_log")"
        if [ -n "$address" ]; then
            echo "$loclx_pid" >"$PID_FILE"
            echo "Tunnel is live at $(write_address "$address")"
            strip_ansi <"$attempt_log" | tail -n 10 >>"$TUNNEL_LOG" || true
            return 0
        fi

        sleep 0.2
    done

    kill "$loclx_pid" 2>/dev/null || true
    wait "$loclx_pid" 2>/dev/null || true

    strip_ansi <"$attempt_log" | tail -n 20 >>"$TUNNEL_LOG" || true
    if grep -qiE 'PRO account only|authentication|unauthorized|invalid[^ ]* token' "$attempt_log"; then
        echo "ERROR: LocalXpose rejected the tunnel. The supplied access token may be invalid or belong to a FREE account; LocalXpose TCP tunnels require a PRO account." >&2
        return 2
    fi

    return 1
}

if [ -z "$ACCESS_TOKEN" ]; then
    fallback_to_bore "LOCALXPOSE_ACCESS_TOKEN is not set."
fi

if ! ensure_loclx; then
    fallback_to_bore "The LocalXpose client could not be installed."
fi

stop_existing_tunnel
: >"$TUNNEL_LOG"

fatal=0
for port in $PORT_CANDIDATES; do
    if start_localxpose "$port"; then
        exit 0
    else
        status=$?
    fi
    if [ "$status" -eq 2 ]; then
        fatal=1
        break
    fi
    echo "LocalXpose port ${port} is unavailable; trying the next one..." >&2
done

if [ "$fatal" -eq 0 ]; then
    if start_localxpose ""; then
        exit 0
    else
        status=$?
    fi
    if [ "$status" -eq 2 ]; then
        fatal=1
    fi
fi

fallback_to_bore "Could not establish a LocalXpose TCP tunnel."
