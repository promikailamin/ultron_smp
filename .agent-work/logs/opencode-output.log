import re
import subprocess
from pathlib import Path

files = subprocess.check_output(['git', 'status', '--porcelain'], text=True).splitlines()
paths = []
for line in files:
    name = line[3:].strip()
    if ' -> ' in name:
        name = name.split(' -> ', 1)[1]
    p = Path(name)
    if p.is_file():
        paths.append(p)

patterns = {
    'jwt': re.compile(rb'eyJ[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+){2,}'),
    'github_pat': re.compile(rb'ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}'),
}
found = False
for p in paths:
    data = p.read_bytes()
    for label, pattern in patterns.items():
        for i, line in enumerate(data.splitlines(), 1):
            if pattern.search(line):
                print(f'{p}:{i}: possible {label} value')
                found = True
if not found:
    print('No JWT or GitHub-token-like values in changed files.')
