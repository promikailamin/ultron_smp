set -euo pipefail
BACKUP=".agent-work/tmp/SERVER_ADDRESS.fallback-backup"
LOG=".agent-work/logs/tunnel-bore-fallback-test.log"
PID=".agent-work/tmp/fallback-tunnel.pid"
cp SERVER_ADDRESS.txt "$BACKUP"
http_pid=""
tunnel_pid=""
cleanup() {
  if [ -n "$tunnel_pid" ]; then kill "$tunnel_pid" 2>/dev/null || true; wait "$tunnel_pid" 2>/dev/null || true; fi
  if [ -n "$http_pid" ]; then kill "$http_pid" 2>/dev/null || true; fi
  cp "$BACKUP" SERVER_ADDRESS.txt 2>/dev/null || true
}
trap cleanup EXIT
python3 -m http.server 25566 --bind 127.0.0.1 >.agent-work/logs/test-fallback-http.log 2>&1 &
http_pid=$!
sleep 1
env -u LOCALXPOSE_ACCESS_TOKEN -u ACCESS_TOKEN -u LX_ACCESS_TOKEN \
  LOCALXPOSE_BORE_FALLBACK=true MINECRAFT_PORT=25566 \
  TUNNEL_PORT_CANDIDATES="25611 25612 25613" TUNNEL_PID_FILE="$PID" \
  bash scripts/tunnel.sh >"$LOG" 2>&1
address="$(grep -v '^#' SERVER_ADDRESS.txt | grep -E ':[0-9]+$' | tail -n 1)"
tunnel_pid="$(cat "$PID" 2>/dev/null || true)"
host="${address%:*}"
port="${address##*:}"
python3 - "$host" "$port" <<'PY'
import socket, sys
host, port = sys.argv[1], int(sys.argv[2])
with socket.create_connection((host, port), timeout=15) as sock:
    sock.sendall(b"GET / HTTP/1.0\r\nHost: test\r\n\r\n")
    response = sock.recv(200)
print(response.split(b"\r\n")[0].decode())
if b"200" not in response:
    raise SystemExit(f"unexpected response: {response!r}")
print("Bore fallback test passed")
PY
cat "$LOG" | tail -5
