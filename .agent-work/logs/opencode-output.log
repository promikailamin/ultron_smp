#!/usr/bin/env python3
import json
import signal
import socket
import sys
import threading

args = sys.argv[1:]
forward = None
tunnl_mode = "output=json" in args
index = 0
while index < len(args):
    arg = args[index]
    if arg == "-R":
        forward = args[index + 1]
        index += 2
    elif arg in ("-o", "-p", "-i", "-l", "-F"):
        index += 2
    elif arg.startswith("-"):
        index += 1
    else:
        index += 1

if not forward or ":" not in forward:
    sys.exit("fake dual ssh: missing -R forward")

_remote_port, _, target = forward.partition(":")
if ":" in target:
    host, port_text = target.rsplit(":", 1)
else:
    host, port_text = "127.0.0.1", target
target_port = int(port_text)

listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
listener.bind(("127.0.0.1", 0))
listener.listen(16)
listen_port = listener.getsockname()[1]
if tunnl_mode:
    print(json.dumps({
        "event": "tunnel",
        "url": f"http://127.0.0.1:{listen_port}",
        "stable": False,
    }), flush=True)
else:
    print(f"tcp://127.0.0.1:{listen_port}", flush=True)


def pump(source, destination):
    try:
        while True:
            data = source.recv(65536)
            if not data:
                break
            destination.sendall(data)
    except OSError:
        pass
    finally:
        try:
            destination.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def handle(client):
    try:
        upstream = socket.create_connection((host, target_port), timeout=10)
    except OSError:
        client.close()
        return

    threading.Thread(target=pump, args=(client, upstream), daemon=True).start()
    pump(upstream, client)
    client.close()
    upstream.close()


def stop(_signum, _frame):
    listener.close()
    sys.exit(0)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)

while True:
    try:
        client, _addr = listener.accept()
    except OSError:
        break
    threading.Thread(target=handle, args=(client,), daemon=True).start()
