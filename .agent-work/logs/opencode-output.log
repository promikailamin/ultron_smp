#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT_DIR/.agent-work/logs"
DEFAULT_TMP_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
ENV_DIR="${TWINGATE_ENV_DIR:-$DEFAULT_TMP_DIR}"

DOCKER_BIN="${TWINGATE_DOCKER_BIN:-docker}"
CONTAINER_NAME="${TWINGATE_CONNECTOR_NAME:-twingate-mccon}"
IMAGE="${TWINGATE_DOCKER_IMAGE:-twingate/connector:1}"
NETWORK_MODE="${TWINGATE_DOCKER_NETWORK:-host}"
PULL_POLICY="${TWINGATE_DOCKER_PULL:-always}"
LABEL_HOSTNAME="${TWINGATE_LABEL_HOSTNAME:-ultronsmp.net}"
LABEL_DEPLOYED_BY="${TWINGATE_LABEL_DEPLOYED_BY:-docker}"
READY_TIMEOUT="${TWINGATE_READY_TIMEOUT:-90}"
NETWORK="${TWINGATE_NETWORK:-}"
ACCESS_TOKEN="${TWINGATE_ACCESS_TOKEN:-}"
REFRESH_TOKEN="${TWINGATE_REFRESH_TOKEN:-}"
LOG_LEVEL="${TWINGATE_LOG_LEVEL:-3}"
ENABLED_MODE="${TWINGATE_ENABLED:-auto}"

ENV_FILE=""

usage() {
    cat >&2 <<'EOF'
Usage: twingate-connector.sh {start|stop|status}

Required for start (provide through the environment, never on the command line):
  TWINGATE_ACCESS_TOKEN    Connector access token
  TWINGATE_REFRESH_TOKEN   Connector refresh token

Optional:
  TWINGATE_ENABLED         auto (default), true/required, or false/disabled.
                           auto starts only when both connector tokens are set.
  TWINGATE_NETWORK         Twingate network slug. If omitted, it is read from
                           the access token's "aud" claim.
  TWINGATE_CONNECTOR_NAME  Docker container name (default: twingate-mccon)
  TWINGATE_DOCKER_IMAGE    Connector image (default: twingate/connector:1)
  TWINGATE_DOCKER_BIN      Docker executable (default: docker)
  TWINGATE_DOCKER_NETWORK  Docker network mode (default: host). Host mode lets the
                           connector reach 127.0.0.1:25565 on the runner.
                           Use "default" to omit --network and let Docker choose
                           its usual bridge network.
  TWINGATE_DOCKER_PULL     Image pull policy (default: always)
  TWINGATE_LABEL_HOSTNAME  Connector hostname label (default: ultronsmp.net)
  TWINGATE_LABEL_DEPLOYED_BY
                           Deployed-by label (default: docker)
  TWINGATE_READY_TIMEOUT   Seconds to wait for the container (default: 90)
  TWINGATE_LOG_LEVEL       Connector log level (default: 3)
  TWINGATE_ENV_DIR         Directory for the temporary env file
EOF
}

cleanup() {
    if [ -n "$ENV_FILE" ] && [ -f "$ENV_FILE" ]; then
        rm -f "$ENV_FILE"
    fi
}
trap cleanup EXIT

fail() {
    echo "ERROR: $1" >&2
    exit 1
}

validate_value() {
    local name="$1"
    local value="$2"

    case "$value" in
        *$'\n'* | *$'\r'*)
            fail "$name must not contain newline characters."
            ;;
    esac
}

mode_is_disabled() {
    case "${ENABLED_MODE,,}" in
        false | 0 | no | off | disabled)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

mode_is_required() {
    case "${ENABLED_MODE,,}" in
        true | 1 | yes | on | required)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

derive_network_from_token() {
    TWINGATE_ACCESS_TOKEN="$ACCESS_TOKEN" python3 - <<'PY'
import base64
import json
import os
import sys

token = os.environ.get("TWINGATE_ACCESS_TOKEN", "")
parts = token.split(".")
if len(parts) < 2:
    sys.exit(1)

payload = parts[1] + "=" * (-len(parts[1]) % 4)
try:
    claims = json.loads(base64.urlsafe_b64decode(payload.encode("ascii")))
except Exception:
    sys.exit(1)

audience = claims.get("aud")
if isinstance(audience, list):
    audience = next((item for item in audience if isinstance(item, str) and item), None)
if not isinstance(audience, str):
    sys.exit(1)

audience = audience.strip()
if not audience or not all(ch.isalnum() or ch in "._-" for ch in audience):
    sys.exit(1)

# Twingate documents the JWT "aud" claim as the tenant/network slug.
print(audience)
PY
}

should_skip() {
    if mode_is_disabled; then
        echo "Twingate connector is disabled (TWINGATE_ENABLED=${ENABLED_MODE})."
        return 0
    fi

    if [ -z "$ACCESS_TOKEN" ] && [ -z "$REFRESH_TOKEN" ]; then
        if mode_is_required; then
            fail "TWINGATE_ACCESS_TOKEN and TWINGATE_REFRESH_TOKEN are required when TWINGATE_ENABLED=${ENABLED_MODE}."
        fi
        echo "Twingate connector skipped: TWINGATE_ACCESS_TOKEN and TWINGATE_REFRESH_TOKEN are not configured."
        return 0
    fi

    return 1
}

require_tokens() {
    local missing=""

    [ -n "$ACCESS_TOKEN" ] || missing="${missing} TWINGATE_ACCESS_TOKEN"
    [ -n "$REFRESH_TOKEN" ] || missing="${missing} TWINGATE_REFRESH_TOKEN"

    if [ -n "$missing" ]; then
        fail "missing Twingate connector configuration:${missing}. Set these as GitHub Actions secrets/variables; never paste tokens into issues or commit them."
    fi

    validate_value TWINGATE_ACCESS_TOKEN "$ACCESS_TOKEN"
    validate_value TWINGATE_REFRESH_TOKEN "$REFRESH_TOKEN"

    if [ -z "$NETWORK" ]; then
        NETWORK="$(derive_network_from_token 2>/dev/null || true)"
    fi
    if [ -z "$NETWORK" ]; then
        fail "missing Twingate connector configuration: TWINGATE_NETWORK could not be read from the access token. Set the repository variable or secret TWINGATE_NETWORK."
    fi

    validate_value TWINGATE_NETWORK "$NETWORK"
    validate_value TWINGATE_LABEL_HOSTNAME "$LABEL_HOSTNAME"
    validate_value TWINGATE_LABEL_DEPLOYED_BY "$LABEL_DEPLOYED_BY"
    validate_value TWINGATE_DOCKER_PULL "$PULL_POLICY"
}

require_docker() {
    command -v "$DOCKER_BIN" >/dev/null 2>&1 \
        || fail "'$DOCKER_BIN' is required to run the Twingate connector."
}

container_running() {
    [ "$("$DOCKER_BIN" inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null || true)" = "true" ]
}

write_env_file() {
    mkdir -p "$ENV_DIR"
    ENV_FILE="$(mktemp "$ENV_DIR/twingate-connector-env.XXXXXX")"
    chmod 600 "$ENV_FILE"

    (
        umask 077
        {
            printf 'TWINGATE_NETWORK=%s\n' "$NETWORK"
            printf 'TWINGATE_ACCESS_TOKEN=%s\n' "$ACCESS_TOKEN"
            printf 'TWINGATE_REFRESH_TOKEN=%s\n' "$REFRESH_TOKEN"
            printf 'TWINGATE_LOG_LEVEL=%s\n' "$LOG_LEVEL"
            printf 'TWINGATE_LABEL_HOSTNAME=%s\n' "$LABEL_HOSTNAME"
            printf 'TWINGATE_LABEL_DEPLOYED_BY=%s\n' "$LABEL_DEPLOYED_BY"
        } >"$ENV_FILE"
    )
}

stop_connector() {
    if ! command -v "$DOCKER_BIN" >/dev/null 2>&1; then
        return 0
    fi

    "$DOCKER_BIN" rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
}

start_connector() {
    if should_skip; then
        return 0
    fi

    require_tokens
    require_docker
    mkdir -p "$LOG_DIR"

    stop_connector
    write_env_file

    local -a run_args=(
        run -d
        --name "$CONTAINER_NAME"
        --restart unless-stopped
        --pull "$PULL_POLICY"
    )

    # Omitting --network reproduces the command Twingate prints in its Admin
    # Console, which relies on Docker's default bridge network. The repository
    # keeps host networking by default so the connector can reach the Minecraft
    # server on 127.0.0.1.
    if [ "$NETWORK_MODE" != "default" ]; then
        run_args+=(--network "$NETWORK_MODE")
    fi

    # Twingate recommends this sysctl for its default bridge network, but the
    # kernel rejects it when the container shares the host network namespace:
    #   sysctl "net.ipv4.ping_group_range" not allowed in host network namespace
    # Host networking is what lets the connector reach the Minecraft server on
    # 127.0.0.1, so only add the sysctl for non-host network modes.
    if [ "$NETWORK_MODE" != "host" ]; then
        run_args+=(--sysctl net.ipv4.ping_group_range="0 2147483647")
    fi

    run_args+=(--env-file "$ENV_FILE" "$IMAGE")

    "$DOCKER_BIN" "${run_args[@]}" >/dev/null

    local waited=0
    while [ "$waited" -lt "$READY_TIMEOUT" ]; do
        if container_running; then
            echo "Twingate connector '${CONTAINER_NAME}' is running."
            echo "Create/assign the Minecraft resource in the Twingate Admin Console; its token values were supplied only through the environment."
            return 0
        fi
        sleep 2
        waited=$((waited + 2))
    done

    stop_connector
    fail "the Twingate connector did not start within ${READY_TIMEOUT}s. Check the connector tokens and network slug."
}

show_status() {
    require_docker

    if container_running; then
        echo "Twingate connector '${CONTAINER_NAME}' is running."
        return 0
    fi

    echo "Twingate connector '${CONTAINER_NAME}' is not running."
    return 1
}

case "${1:-}" in
    start)
        start_connector
        ;;
    stop)
        stop_connector
        echo "Twingate connector '${CONTAINER_NAME}' stopped."
        ;;
    status)
        show_status
        ;;
    *)
        usage
        exit 2
        ;;
esac
---RESOURCE---
#!/usr/bin/env python3
"""Create the Ultron SMP Twingate Resource through the Twingate Admin API.

The Twingate Connector tokens used by twingate-connector.sh cannot create
Resources. Resource automation therefore needs an Admin API token from
Settings > API in the Twingate Admin Console. For older installs the script
can fall back to TWINGATE_ACCESS_TOKEN, which only works if that value is
actually an Admin API token.

Credentials are read from the environment and are never printed.
"""

import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_NAME = "minecraft"
DEFAULT_ADDRESS = "127.0.0.1"
DEFAULT_PORT = 25565
PAGE_SIZE = 100


class TwingateError(Exception):
    pass


def env(name, default=""):
    value = os.environ.get(name, default)
    return value.strip() if isinstance(value, str) else value


def is_disabled(value):
    return value.lower() in {"false", "0", "no", "off", "disabled"}


def is_required(value):
    return value.lower() in {"true", "1", "yes", "on", "required"}


def api_token():
    token = env("TWINGATE_API_TOKEN")
    if token:
        return token

    fallback = env("TWINGATE_ACCESS_TOKEN")
    if fallback:
        print(
            "No TWINGATE_API_TOKEN configured; trying TWINGATE_ACCESS_TOKEN. "
            "Connector tokens cannot create Resources; use an Admin API token "
            "from Settings > API if this fails.",
            file=sys.stderr,
        )
        return fallback

    return ""


def normalize_network(value):
    value = value.strip()
    if "://" in value:
        value = value.split("://", 1)[1]
    value = value.split("/", 1)[0].rstrip(".")
    if value.endswith(".twingate.com"):
        value = value[: -len(".twingate.com")]
    value = value.strip(".").replace("_", "-")
    return value


def valid_network(value):
    return (
        bool(value)
        and len(value) <= 253
        and all(ch.isalnum() or ch in ".-_" for ch in value)
        and all(len(part) <= 63 for part in value.split("."))
    )


def derive_network_from_token(token):
    parts = token.split(".")
    if len(parts) < 2:
        return ""

    import base64

    payload = parts[1] + "=" * (-len(parts[1]) % 4)
    try:
        claims = json.loads(base64.urlsafe_b64decode(payload.encode("ascii")))
    except Exception:
        return ""

    audience = claims.get("aud")
    if isinstance(audience, list):
        audience = next(
            (item for item in audience if isinstance(item, str) and item), None
        )
    if not isinstance(audience, str):
        return ""

    audience = normalize_network(audience)
    return audience if valid_network(audience) else ""


def network_candidates(token):
    candidates = []
    configured = normalize_network(env("TWINGATE_NETWORK"))
    if configured:
        if not valid_network(configured):
            raise TwingateError("TWINGATE_NETWORK is not a valid network slug.")
        candidates.append(configured)

    for value in (
        derive_network_from_token(token),
        derive_network_from_token(env("TWINGATE_API_TOKEN")),
        derive_network_from_token(env("TWINGATE_ACCESS_TOKEN")),
    ):
        if value and value not in candidates:
            candidates.append(value)

    if not candidates:
        raise TwingateError(
            "TWINGATE_NETWORK is required to reach the Twingate Admin API."
        )
    return candidates


def resource_port():
    raw = env("TWINGATE_RESOURCE_PORT", str(DEFAULT_PORT))
    try:
        port = int(raw)
    except ValueError:
        raise TwingateError("TWINGATE_RESOURCE_PORT must be a number.")
    if not 1 <= port <= 65535:
        raise TwingateError("TWINGATE_RESOURCE_PORT must be between 1 and 65535.")
    return port


class Client:
    def __init__(self, token, tenant):
        self.endpoint = (
            env("TWINGATE_API_URL")
            or "https://{}.twingate.com/api/graphql/".format(tenant)
        )
        self.token = token

    def query(self, query, variables=None):
        payload = {"query": query}
        if variables:
            payload["variables"] = variables

        url = self.endpoint
        body = None

        for _ in range(4):
            request = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={
                    "X-API-KEY": self.token,
                    "Content-Type": "application/json",
                    "Accept": "application/json",
                    "User-Agent": "ultron-smp-twingate-resource/1.0",
                },
                method="POST",
            )

            for attempt in range(3):
                try:
                    with urllib.request.urlopen(request, timeout=30) as response:
                        body = response.read().decode("utf-8", errors="replace")
                    break
                except urllib.error.HTTPError as exc:
                    location = exc.headers.get("Location")
                    if exc.code in (301, 302, 303, 307, 308) and location:
                        redirected = urllib.parse.urljoin(url, location)
                        parsed = urllib.parse.urlparse(redirected)
                        host = (parsed.hostname or "").lower()
                        if (
                            parsed.scheme == "https"
                            and (
                                host == "twingate.com"
                                or host.endswith(".twingate.com")
                            )
                            and redirected != url
                        ):
                            url = redirected
                            break
                        raise TwingateError(
                            "Twingate Admin API redirected to an unexpected host."
                        )

                    detail = exc.read().decode("utf-8", errors="replace")
                    message = "Twingate Admin API returned HTTP {}.".format(exc.code)
                    if exc.code in (401, 403):
                        message += (
                            " Authentication failed. Set TWINGATE_API_TOKEN to a "
                            "Read & Write Admin API token from Settings > API."
                        )
                    elif detail:
                        message += " {}".format(redact(detail))
                    raise TwingateError(message)
                except urllib.error.URLError as exc:
                    if attempt < 2:
                        time.sleep(2)
                        continue
                    raise TwingateError(
                        "Could not reach the Twingate Admin API: {}.".format(
                            exc.reason
                        )
                    )

            if body is not None:
                break
        else:
            raise TwingateError("Twingate Admin API redirected too many times.")

        if body is None:
            raise TwingateError("Twingate Admin API returned an empty response.")

        try:
            result = json.loads(body)
        except json.JSONDecodeError:
            raise TwingateError("Twingate Admin API returned invalid JSON.")

        if result.get("errors"):
            messages = []
            for error in result["errors"]:
                if isinstance(error, dict) and error.get("message"):
                    messages.append(error["message"])
            raise TwingateError(
                "Twingate Admin API error: {}.".format(
                    redact("; ".join(messages) or "unknown error")
                )
            )

        data = result.get("data")
        if not isinstance(data, dict):
            raise TwingateError("Twingate Admin API returned no data.")
        return data


def redact(text):
    for name in ("TWINGATE_API_TOKEN", "TWINGATE_ACCESS_TOKEN"):
        value = env(name)
        if value:
            text = text.replace(value, "<redacted>")
    return text


def paginate(client, field, selection):
    nodes = []
    after = None
    while True:
        query = """
        query($first: Int!, $after: String) {
          %s(first: $first, after: $after) {
            pageInfo { hasNextPage endCursor }
            edges { node { %s } }
          }
        }
        """ % (
            field,
            selection,
        )
        data = client.query(query, {"first": PAGE_SIZE, "after": after})
        connection = data.get(field) or {}
        for edge in connection.get("edges") or []:
            node = edge.get("node")
            if isinstance(node, dict):
                nodes.append(node)

        page_info = connection.get("pageInfo") or {}
        if not page_info.get("hasNextPage"):
            return nodes
        after = page_info.get("endCursor")
        if not after:
            raise TwingateError("Twingate Admin API pagination did not return a cursor.")


def select_remote_network(client):
    configured_id = env("TWINGATE_REMOTE_NETWORK_ID")
    if configured_id:
        return configured_id

    networks = paginate(client, "remoteNetworks", "id name")
    if not networks:
        raise TwingateError("No Twingate Remote Network exists in this account.")

    configured_name = env("TWINGATE_REMOTE_NETWORK")
    if configured_name:
        for item in networks:
            if item.get("name") == configured_name:
                return item.get("id")
        raise TwingateError(
            "No Twingate Remote Network named '{}' was found.".format(configured_name)
        )

    if len(networks) == 1:
        return networks[0].get("id")

    names = ", ".join(sorted(item.get("name", "?") for item in networks))
    raise TwingateError(
        "Multiple Twingate Remote Networks exist ({}). Set "
        "TWINGATE_REMOTE_NETWORK or TWINGATE_REMOTE_NETWORK_ID.".format(names)
    )


def find_resource(client, name):
    resources = paginate(
        client,
        "resources",
        "id name address { type value } remoteNetwork { id name }",
    )
    for item in resources:
        if item.get("name") == name:
            return item
    return None


def desired_protocols(port):
    return {
        "allowIcmp": False,
        "tcp": {
            "policy": "RESTRICTED",
            "ports": [{"start": port, "end": port}],
        },
        "udp": {
            "policy": "RESTRICTED",
            "ports": [],
        },
    }


def create_resource(client, name, address, network_id, port):
    query = """
    mutation($name: String!, $address: String!, $remoteNetworkId: ID!, $protocols: ProtocolsInput!) {
      resourceCreate(
        name: $name,
        address: $address,
        remoteNetworkId: $remoteNetworkId,
        protocols: $protocols
      ) {
        ok
        error
        entity { id name address { type value } }
      }
    }
    """
    data = client.query(
        query,
        {
            "name": name,
            "address": address,
            "remoteNetworkId": network_id,
            "protocols": desired_protocols(port),
        },
    )
    result = data.get("resourceCreate") or {}
    if not result.get("ok"):
        raise TwingateError(
            "Twingate could not create the resource: {}.".format(
                redact(result.get("error") or "unknown error")
            )
        )
    return result.get("entity") or {}


def update_resource(client, resource_id, address, network_id, port):
    query = """
    mutation($id: ID!, $address: String!, $remoteNetworkId: ID!, $protocols: ProtocolsInput!) {
      resourceUpdate(
        id: $id,
        address: $address,
        remoteNetworkId: $remoteNetworkId,
        protocols: $protocols
      ) {
        ok
        error
        entity { id name address { type value } }
      }
    }
    """
    data = client.query(
        query,
        {
            "id": resource_id,
            "address": address,
            "remoteNetworkId": network_id,
            "protocols": desired_protocols(port),
        },
    )
    result = data.get("resourceUpdate") or {}
    if not result.get("ok"):
        raise TwingateError(
            "Twingate could not update the resource: {}.".format(
                redact(result.get("error") or "unknown error")
            )
        )
    return result.get("entity") or {}


def ensure_resource():
    mode = env("TWINGATE_RESOURCE_ENABLED", env("TWINGATE_ENABLED", "auto"))
    token = api_token()

    if is_disabled(mode):
        print("Twingate resource automation is disabled.")
        return 0

    if not token:
        if is_required(mode):
            raise TwingateError(
                "Twingate resource automation is required, but no Admin API "
                "token is configured. Add TWINGATE_API_TOKEN from Settings > API."
            )
        print(
            "Twingate resource automation skipped: set TWINGATE_API_TOKEN to an "
            "Admin API token with Read & Write access (Settings > API)."
        )
        return 0

    name = env("TWINGATE_RESOURCE_NAME", DEFAULT_NAME)
    address = env("TWINGATE_RESOURCE_ADDRESS", DEFAULT_ADDRESS)
    port = resource_port()

    if not name:
        raise TwingateError("TWINGATE_RESOURCE_NAME must not be empty.")
    if not address:
        raise TwingateError("TWINGATE_RESOURCE_ADDRESS must not be empty.")

    candidates = network_candidates(token)
    last_error = None

    for tenant in candidates:
        try:
            client = Client(token, tenant)
            network_id = select_remote_network(client)
            existing = find_resource(client, name)

            if existing:
                entity = existing
                current_address = (existing.get("address") or {}).get("value")
                current_network = (existing.get("remoteNetwork") or {}).get("id")
                if current_address != address or current_network != network_id:
                    entity = update_resource(
                        client, existing.get("id"), address, network_id, port
                    )
                    print(
                        "Twingate resource '{}' updated to {}:{}.".format(
                            name, address, port
                        )
                    )
                else:
                    print("Twingate resource '{}' already exists.".format(name))
            else:
                entity = create_resource(client, name, address, network_id, port)
                print(
                    "Twingate resource '{}' created at {}:{}.".format(
                        name, address, port
                    )
                )

            print(
                "Resource id: {}. Assign users or groups to it in the Twingate "
                "Admin Console.".format(entity.get("id", "unknown"))
            )
            return 0
        except TwingateError as exc:
            last_error = exc
            if len(candidates) > 1:
                print(
                    "Twingate Admin API attempt failed; trying another network "
                    "name.",
                    file=sys.stderr,
                )
                continue
            break

    if last_error:
        raise TwingateError(
            "{} Network name length {} ({} labels).".format(
                last_error,
                len(candidates[0]),
                len(candidates[0].split(".")),
            )
        )
    raise TwingateError("Twingate Admin API request failed.")


def main(argv):
    command = argv[1] if len(argv) > 1 else "ensure"
    if command not in ("ensure", "create"):
        print("Usage: twingate-resource.py [ensure]", file=sys.stderr)
        return 2

    try:
        return ensure_resource()
    except TwingateError as exc:
        print("ERROR: {}".format(redact(str(exc))), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
---TUNNEL---
#!/usr/bin/env bash
# Expose the local Minecraft TCP port through LocalXpose.
#
# LocalXpose is the primary tunnel provider. It is authenticated with an
# access token supplied through the LOCALXPOSE_ACCESS_TOKEN (or ACCESS_TOKEN)
# environment variable; the token is never written into this repository.
#
# LocalXpose TCP tunnels require a PRO account. If the token belongs to a
# FREE account (HTTP/HTTPS only), or the tunnel cannot be established for any
# other reason, this script falls back to the stable bore.pub tunnel unless
# LOCALXPOSE_BORE_FALLBACK=false is set.
#
# It writes the resulting address to SERVER_ADDRESS.txt and leaves the tunnel
# running in the background. The PID is stored in:
#   ${TUNNEL_PID_FILE:-${RUNNER_TEMP:-<repo>/.agent-work/tmp}/ultron-tunnel.pid}
#
# TUNNEL_PROVIDER selects the provider used by the workflow:
#   auto        Try Minekube Connect, then LocalXpose, then bore.pub (default)
#   localxpose  Force the LocalXpose tunnel
#   bore        Force the bore.pub tunnel
#   serveo      Force the Serveo SSH tunnel
#   pinggy      Force the Bangladesh-prioritised Pinggy TCP relay
#   tunnl       Use a low-latency TCP relay for Minecraft and add a
#               tunnl.gg HTTP status page (tunnl.gg cannot carry raw TCP)
#   minekube    Use the Minekube Connect network through the Gate connector
#
# Optional environment variables:
#   TUNNEL_PROVIDER             Tunnel provider (default: auto)
#   MINEKUBE_AUTO               Set to false to skip Minekube for auto
#   MINEKUBE_ENDPOINT           Stable Minekube endpoint name
#   MINEKUBE_CONNECT_TOKEN      Minekube connector token (repository secret)
#   PLAYER_REGION               bangladesh/bd prioritises the Asia-Pacific
#                               Pinggy relay (default: bangladesh for
#                               pinggy/tunnl, auto for the standalone script)
#   LOCALXPOSE_ACCESS_TOKEN     LocalXpose access token (required)
#   ACCESS_TOKEN                Alternative token variable name
#   MINECRAFT_PORT              Local Minecraft port (default: 25565)
#   LOCALXPOSE_REGION           Relay region: us, ap, eu, or auto
#                               (default: ap)
#   LOCALXPOSE_PORT_CANDIDATES  Space separated remote ports to try before
#                               asking LocalXpose for a random port
#   LOCALXPOSE_DOWNLOAD_URL     Override the loclx download URL
#   LOCALXPOSE_BORE_FALLBACK    Fall back to bore.pub on failure
#                               (default: true)
#   LOCALXPOSE_ALLOW_LOCAL_ADDRESS
#                               Accept a 127.0.0.1/localhost endpoint from
#                               loclx output (used by tests; default: false)
#   LOCLX_BIN                   Use an existing loclx binary (used by tests)
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

PROVIDER="$(printf '%s' "${TUNNEL_PROVIDER:-auto}" | tr '[:upper:]' '[:lower:]')"
case "$PROVIDER" in
    "" | auto)
        if [ "${MINEKUBE_AUTO:-true}" = "true" ]; then
            default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
            if TUNNEL_PID_FILE="${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}" \
                bash "$ROOT_DIR/scripts/minekube-tunnel.sh"; then
                exit 0
            fi
            echo "WARNING: Minekube Connect could not be started; trying LocalXpose..." >&2
        fi
        ;;
    minekube | minekube-connect | connect)
        exec bash "$ROOT_DIR/scripts/minekube-tunnel.sh"
        ;;
    localxpose | loclx)
        # An explicit provider choice should not silently switch to bore.pub.
        # Set LOCALXPOSE_BORE_FALLBACK=true to opt back into the fallback.
        if [ -z "${LOCALXPOSE_BORE_FALLBACK:-}" ]; then
            export LOCALXPOSE_BORE_FALLBACK=false
        fi
        ;;
    bore | bore.pub)
        exec bash "$ROOT_DIR/scripts/bore-tunnel.sh"
        ;;
    serveo)
        exec bash "$ROOT_DIR/scripts/serveo-tunnel.sh"
        ;;
    pinggy | low-latency)
        default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
        export PLAYER_REGION="${PLAYER_REGION:-bangladesh}"
        export LOW_LATENCY_ADDRESS_FILE="${LOW_LATENCY_ADDRESS_FILE:-$ROOT_DIR/SERVER_ADDRESS.txt}"
        export LOW_LATENCY_PID_FILE="${LOW_LATENCY_PID_FILE:-${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}}"
        exec bash "$ROOT_DIR/scripts/low-latency-tunnel.sh"
        ;;
    tunnl | tunnl.gg)
        # tunnl.gg only carries HTTP/WebSocket, so it cannot be the Minecraft
        # TCP endpoint. Prioritise the Asia-Pacific TCP relay for Bangladeshi
        # players, then publish a tunnl.gg status page alongside it.
        default_pid_dir="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
        export PLAYER_REGION="${PLAYER_REGION:-bangladesh}"
        export LOW_LATENCY_ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
        export LOW_LATENCY_PID_FILE="${TUNNEL_PID_FILE:-$default_pid_dir/ultron-tunnel.pid}"
        if bash "$ROOT_DIR/scripts/low-latency-tunnel.sh"; then
            bash "$ROOT_DIR/scripts/tunnl-tunnel.sh" \
                || echo "WARNING: the tunnl.gg status page could not be started; the Minecraft tunnel is still online." >&2
            exit 0
        fi
        echo "WARNING: the low-latency TCP relay failed; falling back to bore.pub for Minecraft." >&2
        exec bash "$ROOT_DIR/scripts/bore-tunnel.sh"
        ;;
    *)
        echo "ERROR: unsupported TUNNEL_PROVIDER '${PROVIDER}' (use auto, localxpose, bore, serveo, pinggy, tunnl or minekube)." >&2
        exit 2
        ;;
esac

TOOLS_DIR="$ROOT_DIR/.agent-work/tools"
LOGS_DIR="$ROOT_DIR/.agent-work/logs"
ADDRESS_FILE="$ROOT_DIR/SERVER_ADDRESS.txt"
DEFAULT_PID_DIR="${RUNNER_TEMP:-$ROOT_DIR/.agent-work/tmp}"
PID_FILE="${TUNNEL_PID_FILE:-$DEFAULT_PID_DIR/ultron-tunnel.pid}"
TUNNEL_LOG="$LOGS_DIR/localxpose-tunnel.log"

LOCAL_PORT="${MINECRAFT_PORT:-25565}"
REGION="${LOCALXPOSE_REGION:-ap}"
PORT_CANDIDATES="${LOCALXPOSE_PORT_CANDIDATES:-25565 25566 25567 25568 25569 25570}"
ACCESS_TOKEN="${LOCALXPOSE_ACCESS_TOKEN:-${ACCESS_TOKEN:-${LX_ACCESS_TOKEN:-}}}"
BORE_FALLBACK="${LOCALXPOSE_BORE_FALLBACK:-true}"

mkdir -p "$TOOLS_DIR" "$LOGS_DIR" "$(dirname -- "$PID_FILE")"

detect_arch() {
    case "$(uname -m)" in
        x86_64 | amd64) echo "amd64" ;;
        aarch64 | arm64) echo "arm64" ;;
        *)
            echo "ERROR: unsupported CPU architecture: $(uname -m)" >&2
            return 1
            ;;
    esac
}

strip_ansi() {
    sed -E $'s/\x1B\\[[0-9;]*[mK]//g'
}

stop_existing_tunnel() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local old_pid
    old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        for _ in $(seq 1 10); do
            kill -0 "$old_pid" 2>/dev/null || break
            sleep 0.2
        done
        kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

write_address() {
    local address="$1"
    local host="${address%:*}"
    local port="${address##*:}"
    local tmp="$ADDRESS_FILE.tmp"

    {
        echo "# Ultron SMP public server address"
        echo "# Updated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# Provider: LocalXpose TCP tunnel (region ${REGION:-default})"
        echo "# Add this server in Minecraft (host and port):"
        echo "$address"
        echo "#"
        echo "# Host: $host"
        echo "# Port: $port"
    } >"$tmp"
    mv "$tmp" "$ADDRESS_FILE"

    echo "$address"
}

fallback_to_bore() {
    local reason="$1"

    echo "WARNING: ${reason}" >&2
    if [ "$BORE_FALLBACK" = "true" ] && [ -x "$ROOT_DIR/scripts/bore-tunnel.sh" ]; then
        echo "Falling back to the stable bore.pub tunnel..." >&2
        exec bash "$ROOT_DIR/scripts/bore-tunnel.sh"
    fi

    echo "ERROR: ${reason}" >&2
    exit 1
}

ensure_loclx() {
    if [ -n "${LOCLX_BIN:-}" ]; then
        if [ ! -x "$LOCLX_BIN" ]; then
            echo "ERROR: LOCLX_BIN is not executable: $LOCLX_BIN" >&2
            return 1
        fi
        return 0
    fi

    local arch download_url download_dir
    arch="$(detect_arch)"
    LOCLX_BIN="$TOOLS_DIR/loclx-$arch"

    if [ -x "$LOCLX_BIN" ]; then
        return 0
    fi

    download_url="${LOCALXPOSE_DOWNLOAD_URL:-https://api.localxpose.io/api/downloads/loclx-linux-${arch}.zip}"
    download_dir="$TOOLS_DIR/.loclx-download-$$"
    mkdir -p "$download_dir"
    trap 'rm -rf "$download_dir"' EXIT

    echo "Downloading LocalXpose client for ${arch}..." >&2
    curl -fsSL --retry 3 --connect-timeout 15 "$download_url" \
        -o "$download_dir/loclx.zip"
    if command -v unzip >/dev/null 2>&1; then
        unzip -oq "$download_dir/loclx.zip" -d "$download_dir"
    else
        python3 -m zipfile -e "$download_dir/loclx.zip" "$download_dir"
    fi
    install -m 0755 "$download_dir/loclx" "$LOCLX_BIN"
    rm -rf "$download_dir"
    trap - EXIT

    return 0
}

extract_address() {
    local log_file="$1"
    local address=""

    # Prefer the public *.loclx.io endpoint over the local forwarded address.
    address="$(strip_ansi <"$log_file" \
        | grep -oE '[A-Za-z0-9][A-Za-z0-9.-]*\.loclx\.io:[0-9]{1,5}' \
        | head -n 1 || true)"
    if [ -z "$address" ] && [ "${LOCALXPOSE_ALLOW_LOCAL_ADDRESS:-false}" = "true" ]; then
        address="$(strip_ansi <"$log_file" \
            | grep -oE '(localhost|([0-9]{1,3}\.){3}[0-9]{1,3}):[0-9]{1,5}' \
            | head -n 1 || true)"
    fi

    printf '%s' "$address"
}

start_localxpose() {
    local requested_port="${1:-}"
    local -a args=(tunnel --raw-mode tcp --to "127.0.0.1:${LOCAL_PORT}")
    local attempt_log="$LOGS_DIR/localxpose-attempt.log"
    local address=""
    local loclx_pid=""

    if [ -n "$REGION" ] && [ "$REGION" != "auto" ]; then
        args+=(--region "$REGION")
    fi
    if [ -n "$requested_port" ]; then
        args+=(--port "$requested_port")
    fi

    {
        echo "=== $(date -u '+%Y-%m-%d %H:%M:%S UTC') attempt port=${requested_port:-random} region=${REGION:-default} ==="
    } >>"$TUNNEL_LOG"

    : >"$attempt_log"
    (
        export ACCESS_TOKEN
        exec "$LOCLX_BIN" "${args[@]}"
    ) >"$attempt_log" 2>&1 </dev/null &
    loclx_pid=$!

    for _ in $(seq 1 100); do
        if ! kill -0 "$loclx_pid" 2>/dev/null; then
            break
        fi

        address="$(extract_address "$attempt_log")"
        if [ -n "$address" ]; then
            echo "$loclx_pid" >"$PID_FILE"
            echo "Tunnel is live at $(write_address "$address")"
            strip_ansi <"$attempt_log" | tail -n 10 >>"$TUNNEL_LOG" || true
            return 0
        fi

        sleep 0.2
    done

    kill "$loclx_pid" 2>/dev/null || true
    wait "$loclx_pid" 2>/dev/null || true

    strip_ansi <"$attempt_log" | tail -n 20 >>"$TUNNEL_LOG" || true
    if grep -qiE 'PRO account only|authentication|unauthorized|invalid[^ ]* token' "$attempt_log"; then
        echo "ERROR: LocalXpose rejected the tunnel. The supplied access token may be invalid or belong to a FREE account; LocalXpose TCP tunnels require a PRO account." >&2
        return 2
    fi

    return 1
}

if [ -z "$ACCESS_TOKEN" ]; then
    fallback_to_bore "LOCALXPOSE_ACCESS_TOKEN is not set."
fi

if ! ensure_loclx; then
    fallback_to_bore "The LocalXpose client could not be installed."
fi

stop_existing_tunnel
: >"$TUNNEL_LOG"

fatal=0
for port in $PORT_CANDIDATES; do
    if start_localxpose "$port"; then
        exit 0
    else
        status=$?
    fi
    if [ "$status" -eq 2 ]; then
        fatal=1
        break
    fi
    echo "LocalXpose port ${port} is unavailable; trying the next one..." >&2
done

if [ "$fatal" -eq 0 ]; then
    if start_localxpose ""; then
        exit 0
    else
        status=$?
    fi
    if [ "$status" -eq 2 ]; then
        fatal=1
    fi
fi

fallback_to_bore "Could not establish a LocalXpose TCP tunnel."
