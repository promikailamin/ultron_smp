+                best_score="$ap_score"
+                echo "Prioritising the Asia-Pacific relay for Bangladesh/South Asia players." >&2
+            fi
+            ;;
+    esac
+
     RELAY_HOST="$best_relay"
     echo "Selected low-latency relay: ${RELAY_HOST} (estimated ${best_score}ms)" >&2
 }
