import json, socket, struct

def varint(n):
    out = b''
    while True:
        b = n & 0x7f
        n >>= 7
        if n:
            out += bytes([b | 0x80])
        else:
            out += bytes([b])
            return out

def read_varint(sock):
    n = 0
    shift = 0
    while True:
        b = sock.recv(1)
        if not b:
            raise EOFError
        b = b[0]
        n |= (b & 0x7f) << shift
        if not b & 0x80:
            return n
        shift += 7

host = 'bore.pub'
port = 25565
with socket.create_connection((host, port), timeout=10) as s:
    host_b = host.encode()
    handshake = varint(0x00) + varint(767) + varint(len(host_b)) + host_b + struct.pack('>H', port) + varint(1)
    s.sendall(varint(len(handshake)) + handshake)
    s.sendall(varint(1) + varint(0x00))
    length = read_varint(s)
    packet_id = read_varint(s)
    str_len = read_varint(s)
    data = b''
    while len(data) < str_len:
        chunk = s.recv(str_len - len(data))
        if not chunk:
            break
        data += chunk
    status = json.loads(data.decode())
    print('Minecraft status OK:', status['version']['name'], '| players:', status['players']['online'], '/', status['players']['max'])
    print('MOTD:', status['description'])
