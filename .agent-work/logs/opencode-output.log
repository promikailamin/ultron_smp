  TWINGATE_READY_TIMEOUT   Seconds to wait for the container (default: 90)
  TWINGATE_LOG_LEVEL       Connector log level (default: 3)
  TWINGATE_ENV_DIR         Directory for the temporary env file
EOF
}

cleanup() {
