 javac \
     --release 25 \
     -encoding UTF-8 \
-    -cp "$SERVER_JAR:$LOADER_JAR:$MIXIN_JAR:$SLF4J_JAR" \
+    -cp "$CLASSPATH" \
     -d "$CLASSES_DIR" \
     @"$BUILD_DIR/sources.txt"
 
 cp -a "$RES_DIR/." "$CLASSES_DIR/"

