package com.ultron.network;

import java.io.IOException;
import java.io.Reader;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Properties;

/**
 * Small, dependency-free configuration for the network optimizer.
 *
 * <p>The file is written with comments the first time the server starts, so
 * the settings can be changed without rebuilding the mod.</p>
 */
public final class OptimizerConfig {
    public static final String DEFAULT_TEXT = """
            # Ultron SMP network optimizer
            #
            # Every value is read once at server startup. Disable individual
            # filters if a client-visible feature depends on that packet.
            enabled=true

            # Drop particle packets that are farther away than this many blocks.
            cull-particles=true
            max-particle-distance=32.0

            # Drop positional sound packets farther away than this many blocks.
            # Music and UI sounds are always kept.
            cull-sounds=true
            max-sound-distance=48.0

            # Drop block-entity data (signs, chests, spawners, ...) farther than this.
            cull-block-entities=true
            max-block-entity-distance=64.0

            # Drop non-global level events (doors, chests, portals, ...) farther than this.
            cull-level-events=true
            max-level-event-distance=64.0

            # Drop block events (piston/note-block animation, ...) farther than this.
            cull-block-events=true
            max-block-event-distance=64.0

            # The server normally sends a block update whenever a block changes.
            # Some server-side mods send the same state again; skip a repeated
            # update for the same position and state within this many ticks.
            deduplicate-block-updates=true
            block-update-dedup-ticks=20

            # ClientboundSetEntityDataPacket with no values does nothing.
            drop-empty-entity-data=true

            # Log the number of suppressed packets every N seconds (0 = off).
            log-stats-seconds=300
            """;

    public boolean enabled = true;
    public boolean cullParticles = true;
    public double maxParticleDistance = 32.0;
    public boolean cullSounds = true;
    public double maxSoundDistance = 48.0;
    public boolean cullBlockEntities = true;
    public double maxBlockEntityDistance = 64.0;
    public boolean cullLevelEvents = true;
    public double maxLevelEventDistance = 64.0;
    public boolean cullBlockEvents = true;
    public double maxBlockEventDistance = 64.0;
    public boolean deduplicateBlockUpdates = true;
    public int blockUpdateDedupTicks = 20;
    public boolean dropEmptyEntityData = true;
    public int logStatsSeconds = 300;

    public static OptimizerConfig load(Path path) {
        OptimizerConfig config = new OptimizerConfig();

        try {
            Files.createDirectories(path.getParent());
            if (!Files.exists(path)) {
                Files.writeString(path, DEFAULT_TEXT, StandardCharsets.UTF_8);
            }

            Properties properties = new Properties();
            try (Reader reader = Files.newBufferedReader(path, StandardCharsets.UTF_8)) {
                properties.load(reader);
            }

            config.enabled = bool(properties, "enabled", config.enabled);
            config.cullParticles = bool(properties, "cull-particles", config.cullParticles);
            config.maxParticleDistance = positiveDouble(properties, "max-particle-distance", config.maxParticleDistance);
            config.cullSounds = bool(properties, "cull-sounds", config.cullSounds);
            config.maxSoundDistance = positiveDouble(properties, "max-sound-distance", config.maxSoundDistance);
            config.cullBlockEntities = bool(properties, "cull-block-entities", config.cullBlockEntities);
            config.maxBlockEntityDistance = positiveDouble(properties, "max-block-entity-distance", config.maxBlockEntityDistance);
            config.cullLevelEvents = bool(properties, "cull-level-events", config.cullLevelEvents);
            config.maxLevelEventDistance = positiveDouble(properties, "max-level-event-distance", config.maxLevelEventDistance);
            config.cullBlockEvents = bool(properties, "cull-block-events", config.cullBlockEvents);
            config.maxBlockEventDistance = positiveDouble(properties, "max-block-event-distance", config.maxBlockEventDistance);
            config.deduplicateBlockUpdates = bool(properties, "deduplicate-block-updates", config.deduplicateBlockUpdates);
            config.blockUpdateDedupTicks = nonNegativeInt(properties, "block-update-dedup-ticks", config.blockUpdateDedupTicks);
            config.dropEmptyEntityData = bool(properties, "drop-empty-entity-data", config.dropEmptyEntityData);
            config.logStatsSeconds = nonNegativeInt(properties, "log-stats-seconds", config.logStatsSeconds);
        } catch (IOException | RuntimeException exception) {
            UltronNetworkOptimizer.logger().warn(
                    "Could not read {}; using built-in defaults ({})",
                    path,
                    exception.toString()
            );
        }

        return config;
    }

    private static boolean bool(Properties properties, String key, boolean fallback) {
        String value = properties.getProperty(key);
        return value == null ? fallback : Boolean.parseBoolean(value.trim());
    }

    private static double positiveDouble(Properties properties, String key, double fallback) {
        String value = properties.getProperty(key);
        if (value == null) {
            return fallback;
        }

        try {
            double parsed = Double.parseDouble(value.trim());
            return parsed > 0.0 ? parsed : fallback;
        } catch (NumberFormatException ignored) {
            return fallback;
        }
    }

    private static int nonNegativeInt(Properties properties, String key, int fallback) {
        String value = properties.getProperty(key);
        if (value == null) {
            return fallback;
        }

        try {
            int parsed = Integer.parseInt(value.trim());
            return parsed >= 0 ? parsed : fallback;
        } catch (NumberFormatException ignored) {
            return fallback;
        }
    }

    public String summary() {
        return "particles=" + (cullParticles ? maxParticleDistance + "m" : "off")
                + ", sounds=" + (cullSounds ? maxSoundDistance + "m" : "off")
                + ", blockEntities=" + (cullBlockEntities ? maxBlockEntityDistance + "m" : "off")
                + ", levelEvents=" + (cullLevelEvents ? maxLevelEventDistance + "m" : "off")
                + ", blockEvents=" + (cullBlockEvents ? maxBlockEventDistance + "m" : "off")
                + ", blockUpdateDedup=" + (deduplicateBlockUpdates ? blockUpdateDedupTicks + "t" : "off")
                + ", stats=" + (logStatsSeconds > 0 ? logStatsSeconds + "s" : "off");
    }
}
===== network-optimizer/src/main/java/com/ultron/network/PacketFilter.java
package com.ultron.network;

import net.minecraft.core.BlockPos;
import net.minecraft.network.protocol.Packet;
import net.minecraft.network.protocol.game.ClientboundBlockEntityDataPacket;
import net.minecraft.network.protocol.game.ClientboundBlockEventPacket;
import net.minecraft.network.protocol.game.ClientboundBlockUpdatePacket;
import net.minecraft.network.protocol.game.ClientboundLevelEventPacket;
import net.minecraft.network.protocol.game.ClientboundLevelParticlesPacket;
import net.minecraft.network.protocol.game.ClientboundSetEntityDataPacket;
import net.minecraft.network.protocol.game.ClientboundSoundPacket;
import net.minecraft.server.level.ServerPlayer;
import net.minecraft.server.network.ServerCommonPacketListenerImpl;
import net.minecraft.server.network.ServerGamePacketListenerImpl;
import net.minecraft.sounds.SoundSource;

/**
 * Packet-level culling for game packets whose only purpose is visual or
 * positional feedback far away from the player.
 */
public final class PacketFilter {
    private PacketFilter() {
    }

    public static boolean shouldDrop(ServerCommonPacketListenerImpl listener, Packet<?> packet) {
        OptimizerConfig config = UltronNetworkOptimizer.config();
        if (!config.enabled) {
            return false;
        }
        if (!(listener instanceof ServerGamePacketListenerImpl gameListener)) {
            return false;
        }

        ServerPlayer player = gameListener.player;
        if (player == null || player.isRemoved()) {
            return false;
        }

        if (packet instanceof ClientboundLevelParticlesPacket particles) {
            if (!config.cullParticles || particles.overrideLimiter() || particles.alwaysShow()) {
                return false;
            }
            if (outside(config.maxParticleDistance, player, particles.x(), particles.y(), particles.z())) {
                PacketStats.particle();
                return true;
            }
        } else if (packet instanceof ClientboundSoundPacket sound) {
            if (!config.cullSounds || keepSound(sound.getSource())) {
                return false;
            }
            if (outside(config.maxSoundDistance, player, sound.getX(), sound.getY(), sound.getZ())) {
                PacketStats.sound();
                return true;
            }
        } else if (packet instanceof ClientboundBlockEntityDataPacket blockEntity) {
            if (!config.cullBlockEntities) {
                return false;
            }
            BlockPos pos = blockEntity.getPos();
            if (outside(config.maxBlockEntityDistance, player, pos.getX() + 0.5, pos.getY() + 0.5, pos.getZ() + 0.5)) {
                PacketStats.blockEntity();
                return true;
            }
        } else if (packet instanceof ClientboundLevelEventPacket levelEvent) {
            if (!config.cullLevelEvents || levelEvent.isGlobalEvent()) {
                return false;
            }
            BlockPos pos = levelEvent.getPos();
            if (outside(config.maxLevelEventDistance, player, pos.getX() + 0.5, pos.getY() + 0.5, pos.getZ() + 0.5)) {
                PacketStats.levelEvent();
                return true;
            }
        } else if (packet instanceof ClientboundBlockEventPacket blockEvent) {
            if (!config.cullBlockEvents) {
                return false;
            }
            BlockPos pos = blockEvent.getPos();
            if (outside(config.maxBlockEventDistance, player, pos.getX() + 0.5, pos.getY() + 0.5, pos.getZ() + 0.5)) {
                PacketStats.blockEvent();
                return true;
            }
        } else if (packet instanceof ClientboundBlockUpdatePacket blockUpdate) {
            if (!config.deduplicateBlockUpdates) {
                return false;
            }
            long tick = player.level().getServer().getTickCount();
            PlayerFilterState state = PlayerFilterState.of(listener);
            if (state.isDuplicateBlockUpdate(
                    tick,
                    blockUpdate.getPos().asLong(),
                    blockUpdate.getBlockState(),
                    config.blockUpdateDedupTicks
            )) {
                PacketStats.blockUpdate();
                return true;
            }
        } else if (packet instanceof ClientboundSetEntityDataPacket entityData) {
            if (config.dropEmptyEntityData && entityData.packedItems().isEmpty()) {
                PacketStats.entityData();
                return true;
            }
        }

        return false;
    }

    private static boolean keepSound(SoundSource source) {
        return source == SoundSource.MUSIC
                || source == SoundSource.UI
                || source == SoundSource.MASTER
                || source == SoundSource.VOICE;
    }

    private static boolean outside(double maxDistance, ServerPlayer player, double x, double y, double z) {
        double dx = player.getX() - x;
        double dy = player.getY() - y;
        double dz = player.getZ() - z;
        return dx * dx + dy * dy + dz * dz > maxDistance * maxDistance;
    }
}
===== network-optimizer/src/main/java/com/ultron/network/PacketStats.java
package com.ultron.network;

import net.minecraft.server.MinecraftServer;

import java.util.concurrent.atomic.LongAdder;

public final class PacketStats {
    private static final LongAdder PARTICLES = new LongAdder();
    private static final LongAdder SOUNDS = new LongAdder();
    private static final LongAdder BLOCK_ENTITIES = new LongAdder();
    private static final LongAdder LEVEL_EVENTS = new LongAdder();
    private static final LongAdder BLOCK_EVENTS = new LongAdder();
    private static final LongAdder BLOCK_UPDATES = new LongAdder();
    private static final LongAdder ENTITY_DATA = new LongAdder();

    private static long lastLogTick;

    private PacketStats() {
    }

    public static void particle() {
        PARTICLES.increment();
    }

    public static void sound() {
        SOUNDS.increment();
    }

    public static void blockEntity() {
        BLOCK_ENTITIES.increment();
    }

    public static void levelEvent() {
        LEVEL_EVENTS.increment();
    }

    public static void blockEvent() {
        BLOCK_EVENTS.increment();
    }

    public static void blockUpdate() {
        BLOCK_UPDATES.increment();
    }

    public static void entityData() {
        ENTITY_DATA.increment();
    }

    public static void maybeLog(MinecraftServer server) {
        int seconds = UltronNetworkOptimizer.config().logStatsSeconds;
        if (seconds <= 0) {
            return;
        }

        long tick = server.getTickCount();
        long interval = seconds * 20L;
        if (lastLogTick == 0L) {
            lastLogTick = tick;
            return;
        }
        if (tick - lastLogTick < interval) {
            return;
        }
        lastLogTick = tick;

        long particles = PARTICLES.sumThenReset();
        long sounds = SOUNDS.sumThenReset();
        long blockEntities = BLOCK_ENTITIES.sumThenReset();
        long levelEvents = LEVEL_EVENTS.sumThenReset();
        long blockEvents = BLOCK_EVENTS.sumThenReset();
        long blockUpdates = BLOCK_UPDATES.sumThenReset();
        long entityData = ENTITY_DATA.sumThenReset();
        long total = particles + sounds + blockEntities + levelEvents + blockEvents + blockUpdates + entityData;

        if (total > 0L) {
            UltronNetworkOptimizer.logger().info(
                    "Suppressed {} packets in the last {}s (particles={}, sounds={}, blockEntities={}, "
                            + "levelEvents={}, blockEvents={}, duplicateBlocks={}, emptyEntityData={})",
                    total,
                    seconds,
                    particles,
                    sounds,
                    blockEntities,
                    levelEvents,
                    blockEvents,
                    blockUpdates,
                    entityData
            );
        }
    }
}
===== network-optimizer/src/main/java/com/ultron/network/PlayerFilterState.java
package com.ultron.network;

import net.minecraft.world.level.block.state.BlockState;

import java.util.HashMap;
import java.util.Map;
import java.util.WeakHashMap;

final class PlayerFilterState {
    private static final int MAX_TRACKED_BLOCKS = 8192;
    private static final Map<Object, PlayerFilterState> STATES = new WeakHashMap<>();

    private final Map<Long, SentBlock> lastBlockUpdates = new HashMap<>();

    private PlayerFilterState() {
    }

    static PlayerFilterState of(Object listener) {
        synchronized (STATES) {
            return STATES.computeIfAbsent(listener, ignored -> new PlayerFilterState());
        }
    }

    boolean isDuplicateBlockUpdate(long tick, long position, BlockState state, int dedupTicks) {
        SentBlock previous = lastBlockUpdates.get(position);
        if (previous != null
                && previous.state == state
                && tick - previous.tick <= dedupTicks) {
            return true;
        }

        if (lastBlockUpdates.size() >= MAX_TRACKED_BLOCKS) {
            lastBlockUpdates.clear();
        }
        lastBlockUpdates.put(position, new SentBlock(tick, state));
        return false;
    }

    private record SentBlock(long tick, BlockState state) {
    }
}
