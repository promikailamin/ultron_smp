            TWINGATE_RESOURCE_NAME: ${{ vars.TWINGATE_RESOURCE_NAME || 'minecraft' }}
            TWINGATE_RESOURCE_ADDRESS: ${{ vars.TWINGATE_RESOURCE_ADDRESS || '127.0.0.1' }}
            TWINGATE_RESOURCE_ALIAS: ${{ vars.TWINGATE_RESOURCE_ALIAS || 'minecraft.ultronsmp.internal' }}
            TWINGATE_RESOURCE_PORT: ${{ vars.TWINGATE_RESOURCE_PORT || '25565' }}
            TWINGATE_RESOURCE_GROUP_NAMES: ${{ vars.TWINGATE_RESOURCE_GROUP_NAMES || 'Everyone' }}

        steps:
            - name: checkout_repo
              uses: actions/checkout@v4
              with:
                  fetch-depth: 0
                  ref: ${{ github.ref_name }}

            - name: setup_java_25
              uses: actions/setup-java@v4
              with:
                  distribution: temurin
                  java-version: '25'

            - name: configure_git
              env:
                  GH_TOKEN: ${{ secrets.PAT_TOKEN }}
              run: |
                  git config user.name "ultron"
                  git config user.email "ultron@users.noreply.github.com"
                  gh auth setup-git

            - name: tune_network
              continue-on-error: true
              run: |
                  set -euo pipefail
                  sudo bash scripts/network-tune.sh

            - name: refresh_world_from_backup
              run: |
                  set -euo pipefail
                  # A cancelled run may finish its final backup just after this
                  # run checks out the repository. Re-sync a few times so the
                  # server never starts from a stale world and later overwrites
                  # the previous run's saved changes.
                  stable=0
                  for _ in $(seq 1 15); do
                      git fetch origin "$GITHUB_REF_NAME"
                      git reset --hard "origin/$GITHUB_REF_NAME"
                      before="$(git rev-parse HEAD)"
                      sleep 3
                      git fetch origin "$GITHUB_REF_NAME"
                      after="$(git rev-parse "origin/$GITHUB_REF_NAME")"
                      if [ "$before" = "$after" ]; then
                          stable=$((stable + 1))
                          if [ "$stable" -ge 2 ]; then
                              echo "World is up to date at ${after}."
                              break
                          fi
                      else
                          stable=0
                          echo "Previous run pushed newer data; syncing again..."
                      fi
                  done

            - name: run_server
              run: |
                  set -euo pipefail
                  bash scripts/server-control.sh start

                  echo "Waiting for Minecraft server on port ${MINECRAFT_PORT}..."

                  ready=0
                  for _ in $(seq 1 120); do
                      if (echo > "/dev/tcp/127.0.0.1/${MINECRAFT_PORT}") 2>/dev/null; then
                          ready=1
                          break
                      fi
                      if ! bash scripts/server-control.sh status >/dev/null 2>&1; then
                          echo "Minecraft server exited while starting."
                          break
                      fi
                      sleep 1
                  done

                  if [ "$ready" -ne 1 ]; then
                      echo "Server did not start within 120 seconds."
                      tail -n 200 server.log || true
                      exit 1
                  fi

                  echo "Minecraft server is ready!"

            - name: verify_minecraft_port
              run: |
                  set -euo pipefail
                  echo "Checking Minecraft port..."

                  ss -lntp | grep ":${MINECRAFT_PORT}" || {
                      echo "ERROR: Nothing is listening on port ${MINECRAFT_PORT}"
                      tail -100 server.log
                      exit 1
                  }

                  python3 - <<'PY'
                  import os
                  import socket

                  port = int(os.environ.get("MINECRAFT_PORT", "25565"))
                  with socket.create_connection(("127.0.0.1", port), timeout=5):
                      pass
                  print(f"Minecraft TCP port {port} is reachable locally!")
                  PY

            - name: start_twingate_connector
              # Secrets cannot be tested directly in an `if:` expression. The
              # script starts the connector automatically when both tokens are
              # present, skips when they are absent, and honours
              # TWINGATE_ENABLED=false/true as an override.
              continue-on-error: true
              run: |
                  set -euo pipefail
                  bash scripts/twingate-connector.sh start | tee .agent-work/logs/twingate-connector.log

            - name: ensure_twingate_resource
              # Connector tokens cannot create Resources, so this needs an Admin
              # API token. The script skips cleanly when none is configured and
              # never prints secret values. An existing resource is left in place.
              continue-on-error: true
              run: |
                  set -euo pipefail
                  python3 scripts/twingate-resource.py ensure | tee .agent-work/logs/twingate-resource.log

            - name: expose_server
              id: expose-tunnel
              run: |
                  set -euo pipefail
                  bash scripts/tunnel.sh | tee .agent-work/logs/tunnel-start.log

                  address="$(grep -v '^#' SERVER_ADDRESS.txt | grep -E ':[0-9]+$' | tail -n 1)"
                  if [ -z "$address" ]; then
                      echo "ERROR: no public server address was generated."
                      exit 1
                  fi

                  echo "Tunnel has been started at ${address}"
                  echo "SERVER_ADDRESS=${address}" >> "$GITHUB_ENV"

                  status_url="$(grep -v '^#' SERVER_STATUS_URL.txt 2>/dev/null | tail -n 1 || true)"
                  if [ -n "$status_url" ]; then
                      echo "Status page is available at ${status_url}"
                      echo "SERVER_STATUS_URL=${status_url}" >> "$GITHUB_ENV"
                  fi

                  {
                      echo "## Ultron SMP is online"
                      echo ""
                      echo "**Minecraft address:** \`${address}\`"
                      if [ -n "$status_url" ]; then
                          echo ""
                          echo "**Status page:** ${status_url}"
                      fi
                      echo ""
                      echo "The address is also kept in \`SERVER_ADDRESS.txt\`."
                  } >> "$GITHUB_STEP_SUMMARY"

            - name: verify_public_tunnel
              run: |
                  set -euo pipefail
                  address="${SERVER_ADDRESS:-$(grep -v '^#' SERVER_ADDRESS.txt | grep -E ':[0-9]+$' | tail -n 1)}"
                  host="${address%:*}"
                  port="${address##*:}"

                  echo "Checking public endpoint ${host}:${port}..."

                  for attempt in $(seq 1 20); do
                      if python3 - "$host" "$port" <<'PY'
                  import socket
                  import sys

                  host = sys.argv[1]
                  port = int(sys.argv[2])
                  with socket.create_connection((host, port), timeout=10):
                      pass
                  print(f"{host}:{port} is reachable")
                  PY
                      then
                          echo "Public tunnel is reachable."
                          exit 0
                      fi
                      echo "Attempt ${attempt}/20 failed; retrying..."
                      sleep 3
                  done

                  echo "ERROR: the public tunnel is not reachable."
                  tail -100 .agent-work/logs/localxpose-tunnel.log \
                      .agent-work/logs/serveo-tunnel.log \
                      .agent-work/logs/tunnl-tunnel.log \
                      .agent-work/logs/tunnl-status.log \
                      .agent-work/logs/pinggy-tunnel.log \
                      .agent-work/logs/tunnel.log 2>/dev/null || true
                  exit 1

            - name: publish_server_address
              env:
                  GH_TOKEN: ${{ secrets.PAT_TOKEN }}
              run: |
                  set -euo pipefail
                  address="${SERVER_ADDRESS:-$(grep -v '^#' SERVER_ADDRESS.txt | grep -E ':[0-9]+$' | tail -n 1)}"
                  host="${address%:*}"
                  port="${address##*:}"
