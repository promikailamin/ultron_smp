else
    rm -f "$BACKUP_FILE"
fi

http_pid=""
supervisor_pid=""

cleanup() {
    if [ -n "$supervisor_pid" ]; then
        kill "$supervisor_pid" 2>/dev/null || true
        wait "$supervisor_pid" 2>/dev/null || true
    fi
    if [ -n "$http_pid" ]; then
        kill "$http_pid" 2>/dev/null || true
    fi
    if [ -f "$BACKUP_FILE" ]; then
