name: Run UltronSMP

on:
    workflow_dispatch:
        inputs:
            tunnel:
                description: 'Public tunnel provider'
                required: true
                default: auto
                type: choice
                options:
                    - auto
                    - localxpose
                    - bore
                    - serveo
                    - pinggy
                    - tunnl
                    - minekube
            tunnel_region:
                description: 'Free relay region (Pinggy); auto measures all regions'
                required: true
                default: auto
                type: choice
                options:
                    - auto
                    - bangladesh
                    - asia-pacific
                    - united-states
                    - europe

permissions:
    contents: write
    issues: write

concurrency:
    group: minecraft-server
    cancel-in-progress: false

jobs:
    server:
        runs-on: ubuntu-latest
        timeout-minutes: 360
        env:
            MINECRAFT_PORT: '25565'
            SERVER_ISSUE_NUMBER: '1'
            TUNNEL_PROVIDER: ${{ inputs.tunnel || 'auto' }}
            TUNNEL_REGION: ${{ inputs.tunnel_region || 'auto' }}
            LOCALXPOSE_ACCESS_TOKEN: ${{ secrets.LOCALXPOSE_ACCESS_TOKEN }}
            LOCALXPOSE_REGION: ${{ vars.LOCALXPOSE_REGION || 'ap' }}
            LOCALXPOSE_BORE_FALLBACK: ${{ vars.LOCALXPOSE_BORE_FALLBACK }}
            PLAYER_REGION: ${{ vars.PLAYER_REGION || 'bangladesh' }}
            MINEKUBE_ENDPOINT: ${{ vars.MINEKUBE_ENDPOINT }}
            MINEKUBE_CONNECT_TOKEN: ${{ secrets.MINEKUBE_CONNECT_TOKEN }}
            MINEKUBE_GATE_VERSION: ${{ vars.MINEKUBE_GATE_VERSION || '0.81.1' }}
            MINEKUBE_AUTO: ${{ vars.MINEKUBE_AUTO || 'true' }}
            TWINGATE_ENABLED: ${{ vars.TWINGATE_ENABLED || 'auto' }}
            TWINGATE_NETWORK: ${{ vars.TWINGATE_NETWORK || secrets.TWINGATE_NETWORK || 'mikailamin' }}
            TWINGATE_CONNECTOR_NAME: ${{ vars.TWINGATE_CONNECTOR_NAME || 'twingate-mccon' }}
            TWINGATE_DOCKER_PULL: ${{ vars.TWINGATE_DOCKER_PULL || 'always' }}
            TWINGATE_LABEL_HOSTNAME: ${{ vars.TWINGATE_LABEL_HOSTNAME || 'ultronsmp.net' }}
